#!/usr/bin/env bash
# Docker calls this every 10s. Require full readiness initially and every 60s;
# between those checks verify only that the gRPC service responds.
set -euo pipefail
source /health_common

if health_cache_is_fresh; then
    if /health_liveness; then
        exit 0
    fi
    # A recovered gRPC endpoint must pass readiness again before becoming healthy.
    rm -f "$HEALTH_STATE_FILE"
    exit 1
fi

# Do not report success while another (possibly failing) readiness probe runs.
# health_readiness shares its lock and cache with the entrypoint's direct calls.
exec /health_readiness
