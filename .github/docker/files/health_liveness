#!/usr/bin/env bash
# One small gRPC request, without SQL, DDL or cluster-wide SelfCheck.
# A live endpoint is not a substitute for the periodic readiness probe.
set -euo pipefail
source /health_common
: "${YDB_LIVENESS_TIMEOUT:=2s}"
health_validate_timeout "$YDB_LIVENESS_TIMEOUT"

if [[ "${DEBUG:-false}" == true ]]; then
    set -x
fi

exec timeout --signal=KILL "$YDB_LIVENESS_TIMEOUT" \
    /ydb --endpoint "$YDB_ENDPOINT" --database "$YDB_DATABASE" --no-discovery \
    discovery whoami >/dev/null
