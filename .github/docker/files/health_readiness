#!/usr/bin/env bash
# Full readiness for both Docker and /init.d. The timeout covers the ENTIRE
# sequence, including retries and sleeps, and kills the process group on expiry.
# Default: 8s total, inside Docker's 12s timeout. Kill the whole group at the
# deadline: a TERM-exited shell must not leave a TERM-ignoring CLI holding the lock.
# If overriding YDB_READINESS_TIMEOUT, also increase Docker --health-timeout.
set -euo pipefail
source /health_common
: "${YDB_READINESS_TIMEOUT:=8s}"
: "${YDB_READINESS_RETRIES:=2}"
: "${YDB_READINESS_SLEEP:=1}"

health_validate_timeout "$YDB_READINESS_TIMEOUT"
[[ "$YDB_READINESS_RETRIES" =~ ^[1-9][0-9]{0,8}$ ]] || exit 1
[[ "$YDB_READINESS_SLEEP" =~ ^[0-9]+([.][0-9]+)?$ ]] || exit 1

if [[ "${1:-}" != --run-probe ]]; then
    exec timeout --signal=KILL "$YDB_READINESS_TIMEOUT" /bin/bash /health_readiness --run-probe
fi

if [[ "${DEBUG:-false}" == true ]]; then
    set -x
fi

mkdir -p "$HEALTH_STATE_DIR"
# Never unlink this lock file: all callers must lock the same inode. The kernel
# releases the lock when the process group exits; no stale-lock timeout is needed.
exec 9>"${HEALTH_STATE_DIR}/readiness.lock"
if ! flock --exclusive --nonblock 9; then
    echo 'healthcheck: readiness is already running' >&2
    exit 1
fi
rm -f "$HEALTH_STATE_FILE"

ydb_cli() {
    /ydb --endpoint "$YDB_ENDPOINT" --database "$YDB_DATABASE" --no-discovery "$@"
}

deep_once() {
    # This function is used in an if condition, so set -e cannot propagate errors.
    ydb_cli sql -s "select 1" >/dev/null || return 1
    ydb_cli scheme ls "$YDB_DATABASE" >/dev/null || return 1
    if [[ "$YDB_READINESS_ENABLE_DDL" == true ]]; then
        local test_table_path="${YDB_DATABASE%/}/.sys_health/test"
        # IF NOT EXISTS also recovers a table left by a killed earlier probe.
        ydb_cli sql -s "create table if not exists \`${test_table_path}\` (key int32, value utf8, primary key(key))" >/dev/null || return 1
        ydb_cli sql -s "drop table \`${test_table_path}\`" >/dev/null || return 1
    fi
    return 0
}

for (( attempt=1; attempt<=YDB_READINESS_RETRIES; attempt++ )); do
    if deep_once; then
        health_record_readiness
        exit 0
    fi
    if (( attempt < YDB_READINESS_RETRIES )); then
        sleep "$YDB_READINESS_SLEEP"
    fi
done
exit 1
