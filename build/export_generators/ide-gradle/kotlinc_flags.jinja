{%- if with_kotlin -%}
{%-     if target.kotlinc.flags|length -%}
{%-         set main_compiler_flags = target.kotlinc.flags|unique|reject('startsWith', FRIEND_PATHS_FLAG) %}

tasks.compileKotlin.configure {
{{- FriendPaths(target.kotlinc.flags) }}
{%-         if main_compiler_flags|length %}
    compilerOptions {
{%-             for kotlinc_flag in main_compiler_flags %}
        freeCompilerArgs.add({{ PatchRoots(kotlinc_flag, true) }})
{%-             endfor %}
    }
{%-         endif %}
}
{%      endif -%}
{%-     if named_tests -%}
{%-         for extra_target in ordered_extra_targets -%}
{%-             set testname = SourceSetName(extra_target) -%}
{%-             set test_compiler_flags = extra_target.kotlinc.flags|unique|reject('startsWith', FRIEND_PATHS_FLAG) -%}
{%-             if testname == NS_TEST -%}
{%-                 set kotlinCompile = 'compileTestKotlin' -%}
{%-             else -%}
{%-                 set kotlinCompile = 'named<KotlinCompile>("compile' + testname|title + 'Kotlin")' -%}
{%-             endif %}

tasks.{{ kotlinCompile }} {
{%-             if target is defined %}
    friendPaths.from(sourceSets.main.get().output)
{%-             elif testname != NS_TEST %}
    friendPaths.from(sourceSets.test.get().output)
{%-             endif -%}
{%-             if extra_target.extra_depends|length -%}
{%-                 for extra_depend in extra_target.extra_depends %}
    friendPaths.from(sourceSets.named("{{ TestRelDir2SourceSetName(extra_depend) }}").get().output)
{%-                 endfor -%}
{%-             endif -%}
{{- FriendPaths(extra_target.kotlinc.flags) }}
{%-             if test_compiler_flags|length %}
    compilerOptions {
{%-                for kotlinc_flag in test_compiler_flags %}
        freeCompilerArgs.add({{ PatchRoots(kotlinc_flag, true) }})
{%-                endfor %}
    }
{%-             endif %}
}
{%-         endfor -%}
{%-     else -%}
{%-         if extra_targets|length -%}
{%-             set all_kotlinc_flags = all_targets|selectattr('kotlinc')|map(attribute='kotlinc')|map(attribute='flags')|sum -%}
{%-             set all_compiler_flags = all_kotlinc_flags|unique|reject('startsWith', FRIEND_PATHS_FLAG) %}

tasks.compileTestKotlin {
{%-             if target is defined %}
    friendPaths.from(sourceSets.main.get().output)
{%-             endif -%}
{{- FriendPaths(all_kotlinc_flags) }}
{%-             if all_compiler_flags|length %}
    compilerOptions {
{%-                for kotlinc_flag in all_compiler_flags %}
        freeCompilerArgs.add({{ PatchRoots(kotlinc_flag, true) }})
{%-                endfor %}
    }
{%-             endif %}
}
{%-         endif -%}
{%-     endif -%}
{%- endif -%}
