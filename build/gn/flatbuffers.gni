template("flatbuffers_library") {
    _path = rebase_path(".", "//")
    _unique_name = exec_script("//build/gn/scripts/unique_name.py", [ _path ], "trim string")
    _gen_target = "${_unique_name}_${target_name}_gen"

    _flatc = "//contrib/libs/flatbuffers:flatc"
    _flatc_bin = rebase_path(get_label_info(_flatc, "root_out_dir") + "/flatc", root_build_dir)

    action_foreach(_gen_target) {
        script = "//build/gn/scripts/run.py"
        sources = invoker.sources
        outputs = [ "{{source_gen_dir}}/{{source_name_part}}.fbs.h" ]

        if (defined(invoker.flatc_flags)) {
            flatc_flags = invoker.flatc_flags
        } else {
            flatc_flags = []
        }

        args = [
            "./$_flatc_bin",
            "--no-warnings", "--cpp", "--keep-prefix", "--gen-mutable",
            # --schema -b ${_FLATC_CPP_YANDEX_MAPS_ITER_FLAG}
            "--gen-object-api",
            "--filename-suffix", ".fbs",
            "-o", "{{source_gen_dir}}",
        ] + flatc_flags + [
            "{{source}}",
        ]

        deps = [ _flatc ]
    }

    config("public_config") {
        include_dirs = [ target_gen_dir ]
    }

    source_set(target_name) {
        public_deps = [ "//contrib/libs/flatbuffers" ]

        deps = []
        deps += [ ":$_gen_target" ]

        sources = get_target_outputs(":$_gen_target")

        public_configs = [ ":public_config" ]
    }
}
