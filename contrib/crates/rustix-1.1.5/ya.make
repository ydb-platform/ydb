    CHANGES.md
    CODE_OF_CONDUCT.md
    CONTRIBUTING.md
    COPYRIGHT
    Cargo.lock
    LICENSE-APACHE
    LICENSE-Apache-2.0_WITH_LLVM-exception
    LICENSE-MIT
    ORG_CODE_OF_CONDUCT.md
    README.md
    SECURITY.md
)

CRATE_FLAGS(--cap-lints=allow)

CRATE_FEATURES(
    alloc
    default
    fs
    std
)

PEERDIR(
    contrib/crates/bitflags-2.13.2
    contrib/crates/linux-raw-sys-0.12.1
)

IF (OS_DARWIN AND ARCH_ARM64 OR OS_DARWIN AND ARCH_X86_64)
    CRATE_FEATURES(
        system
    )

    PEERDIR(
    contrib/crates/errno-0.3.14
    contrib/crates/libc-0.2.191
)

    CRATE_DEPENDENCY_ALIAS(libc_errno contrib/crates/errno-0.3.14)
ELSEIF (OS_LINUX AND ARCH_AARCH64 AND _RUST_MODE == "host" OR OS_LINUX AND ARCH_AARCH64 AND NOT MUSL OR OS_LINUX AND ARCH_AARCH64 AND _RUST_MODE != "host" AND MUSL OR OS_LINUX AND ARCH_X86_64 AND _RUST_MODE == "host" OR OS_LINUX AND ARCH_X86_64 AND NOT MUSL OR OS_LINUX AND ARCH_X86_64 AND _RUST_MODE != "host" AND MUSL)
    CRATE_FEATURES(
        system
    )

ELSEIF (OS_WINDOWS AND ARCH_X86_64)
ENDIF()

CRATE_BUILD_SCRIPT(contrib/crates/rustix-1.1.5/build_script)

LICENSE("Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT")
VERSION(1.1.5)
ORIGINAL_SOURCE(https://static.crates.io/crates/rustix/rustix-1.1.5.crate)

CRATE_FEATURES(
    event
    mm
    net
    param
    pipe
    process
    stdio
    termios
    thread
    time
)

IF (OS_WINDOWS AND ARCH_X86_64)
    PEERDIR(
    contrib/crates/windows-sys-0.61.2
)

ENDIF()

CRATE_PROC_MACROS(
    contrib/crates/bytemuck_derive-1.12.1
)

END()

RECURSE(build_script)
