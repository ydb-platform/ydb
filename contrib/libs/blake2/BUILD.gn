config("public_config") {
    cflags = [
        "-Wno-implicit-function-declaration",
        "-Wno-macro-redefined",
    ]
    include_dirs = [ "include" ]
}

config("private_config") {
    cflags = [
        "-Wno-implicit-function-declaration",
        "-Wno-unused-const-variable",
        "-Wno-unused-function",
    ]
    defines = [ "HAVE_CONFIG_H" ]
}

config("avx_config") {
    cflags = [ "-mavx", "-mpclmul" ]
    defines = [ "SUFFIX=_avx" ]
}

source_set("avx") {
    sources = [ "src/blake2b.c", "src/blake2s.c" ]
    configs += [ ":avx_config", ":private_config" ]
}

config("ref_config") {
    defines = [ "SUFFIX=_ref" ]
}

source_set("ref") {
    sources = [ "src/blake2b-ref.c", "src/blake2s-ref.c" ]
    configs += [ ":ref_config", ":private_config" ]
}

config("sse2_config") {
    defines = [ "SUFFIX=_sse2" ]
}

source_set("sse2") {
    sources = [ "src/blake2b.c", "src/blake2s.c" ]
    configs += [ ":sse2_config", ":private_config" ]
}

config("sse41_config") {
    defines = [ "SUFFIX=_sse41" ]
}

source_set("sse41") {
    sources = [ "src/blake2b.c", "src/blake2s.c" ]
    configs += [ ":sse41_config", ":private_config" ]
}

config("ssse3_config") {
    defines = [ "SUFFIX=_ssse3" ]
}

source_set("ssse3") {
    sources = [ "src/blake2b.c", "src/blake2s.c" ]
    configs += [ ":ssse3_config", ":private_config" ]
}

config("xop_config") {
    cflags = [ "-mxop" ]
    defines = [ "SUFFIX=_xop" ]
}

source_set("xop") {
    sources = [ "src/blake2b.c", "src/blake2s.c" ]
    configs += [ ":xop_config", ":private_config" ]
}
contrib_library("blake2") {
    deps = [
        ":avx",
        ":ref",
        ":sse2",
        ":sse41",
        ":ssse3",
        ":xop",
    ]

    sources =[
        "src/blake2-dispatch.c",
        "src/blake2bp.c",
        "src/blake2sp.c",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}
