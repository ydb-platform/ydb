config("public_config") {
    include_dirs = [ "include" ]
}

config("private_config") {
    cflags = [ "-Wno-unused-function" ]
}

contrib_library("farmhash") {
    deps = [ ":sse42_aesni" ]

    sources = [
        "farmhash_iface.cc",
        "farmhashcc.cc",
        "farmhashmk.cc",
        "farmhashna.cc",
        "farmhashnt.cc",
        "farmhashsa.cc",
        "farmhashte.cc",
        "farmhashuo.cc",
        "farmhashxo.cc",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}

config("aes_config") {
    cflags = [ "-maes" ]
}

source_set("sse42_aesni") {
    sources = [ "farmhashsu.cc" ]
    configs += [
        ":aes_config",
        ":private_config",
    ]
}
