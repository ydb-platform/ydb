config("public_config") {
    include_dirs = [ "include" ]
}

config("private_config"){
    include_dirs = [ "src" ]
}

contrib_library("libaio") {
    sources = [
        "src/io_cancel.c",
        "src/io_destroy.c",
        "src/io_getevents.c",
        "src/io_pgetevents.c",
        "src/io_queue_init.c",
        "src/io_queue_release.c",
        "src/io_queue_run.c",
        "src/io_queue_wait.c",
        "src/io_setup.c",
        "src/io_submit.c",
        "src/raw_syscall.c",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}
