import("//build/gn/config/linux/deps.gni")

config("public_config") {
    include_dirs = [
        "include/readpassphrase",
        "memfd_create",
        "random",
    ]
}

config("private_config") {
    cflags = [
        "-Wno-#warnings",
        "-Wno-implicit-function-declaration",
    ]
}

system_library("libc_compat") {
    sources = [
        "string.c",
        "random/getrandom.c",
        "random/getentropy.c",
        "readpassphrase.c",
        "strlcat.c",
        "strlcpy.c",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}
