config("public_config") {
    include_dirs = [ "include" ]
}

config("private_config") {
    cflags = [
        "-Wno-array-parameter",
        "-Wno-implicit-function-declaration",
        "-Wno-tautological-compare",
        "-Wno-unused-function",
    ]
    defines = [ "HAVE_CONFIG_H" ]
    include_dirs = [ "." ]
}

contrib_library("libevent") {
    deps = [
        "//contrib/libs/libc_compat",
        "//contrib/libs/openssl",
    ]

    sources = [
        "buffer.c",
        "bufferevent_filter.c",
        "bufferevent_openssl.c",
        "bufferevent_pair.c",
        "bufferevent_ratelim.c",
        "bufferevent_sock.c",
        "bufferevent.c",
        "epoll.c",
        "evdns.c",
        "event_tagging.c",
        "event.c",
        "evmap.c",
        "evrpc.c",
        "evthread_pthread.c",
        "evthread.c",
        "evutil_rand.c",
        "evutil_time.c",
        "evutil.c",
        "http.c",
        "listener.c",
        "log.c",
        "poll.c",
        "select.c",
        "signal.c",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}
