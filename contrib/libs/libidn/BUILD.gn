config("public_config") {
    include_dirs = [ "include" ]
}

config("private_config") {
    cflags = [
        "-Wno-c23-extensions",
        "-Wno-return-type",
        "-Wno-sign-compare",
        "-Wno-unused-function",
    ]
    defines = [
        "HAVE_CONFIG_H",
        "LIBIDN_BUILDING",
        "LOCALEDIR=\"/tmp/yamaker/libidn/out/share/locale\"",
    ]
    include_dirs = [
        ".",
        "gl",
        "lib",
        "lib/gl",
    ]
}

contrib_library("libidn") {
    sources = [
        "gl/basename-lgpl.c",
        "gl/fd-hook.c",
        "gl/getprogname.c",
        "gl/malloca.c",
        "gl/stat-time.c",
        "gl/stdlib.c",
        "lib/gl/c-ctype.c",
        "lib/gl/c-strcasecmp.c",
        "lib/gl/c-strncasecmp.c",
        "lib/gl/stdlib.c",
        "lib/gl/striconv.c",
        "lib/gl/unistr/u8-check.c",
        "lib/gl/unistr/u8-mbtoucr.c",
        "lib/gl/unistr/u8-uctomb-aux.c",
        "lib/gl/unistr/u8-uctomb.c",
        "lib/idn-free.c",
        "lib/idna.c",
        "lib/nfkc.c",
        "lib/pr29.c",
        "lib/profiles.c",
        "lib/punycode.c",
        "lib/rfc3454.c",
        "lib/strerror-idna.c",
        "lib/strerror-pr29.c",
        "lib/strerror-punycode.c",
        "lib/strerror-stringprep.c",
        "lib/strerror-tld.c",
        "lib/stringprep.c",
        "lib/tld.c",
        "lib/tlds.c",
        "lib/toutf8.c",
        "lib/version.c",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}
