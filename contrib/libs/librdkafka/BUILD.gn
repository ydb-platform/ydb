# <librdkafka/rdkafka.h>: the consumers' ADDINCL of ya.make (the contrib
# exports no include dir of its own)
config("public_config") {
    include_dirs = [ "include" ]
}

config("private_config") {
    include_dirs = [ "src" ]
    cflags = [
        "-Wno-enum-conversion",
        "-Wno-implicit-function-declaration",
        "-Wno-macro-redefined",
        "-Wno-unused-but-set-variable",
    ]
}

contrib_library("librdkafka") {
    deps = [
        "//contrib/libs/curl",
        "//contrib/libs/libc_compat",  # sys/random.h (HAVE_GETENTROPY), strlcpy
        "//contrib/libs/lz4",
        "//contrib/libs/nanopb",
        "//contrib/libs/openssl",
        "//contrib/libs/sasl",
        "//contrib/libs/xxhash",
        "//contrib/libs/zlib",
        "//contrib/libs/zstd",
    ]

    sources = [
        "src/cJSON.c",
        "src/crc32c.c",
        "src/opentelemetry/common.pb.c",
        "src/opentelemetry/metrics.pb.c",
        "src/opentelemetry/resource.pb.c",
        "src/rdaddr.c",
        "src/rdavl.c",
