# <rdkafkacpp.h>: the consumers' ADDINCL of ya.make (the contrib exports no
# include dir of its own)
config("public_config") {
    include_dirs = [ "." ]
}

contrib_library("src-cpp") {
    deps = [ "//contrib/libs/librdkafka" ]

    sources = [
        "ConfImpl.cpp",
        "ConsumerImpl.cpp",
        "HandleImpl.cpp",
        "HeadersImpl.cpp",
        "KafkaConsumerImpl.cpp",
        "MessageImpl.cpp",
        "MetadataImpl.cpp",
        "ProducerImpl.cpp",
        "QueueImpl.cpp",
        "RdKafka.cpp",
        "TopicImpl.cpp",
        "TopicPartitionImpl.cpp",
    ]

    public_configs = [ ":public_config" ]
}
