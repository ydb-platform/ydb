config("public_config") {
    include_dirs = [ "src/include" ]
}

config("private_config") {
    defines = [ "LIBURING_INTERNAL" ]
}

contrib_library("liburing") {
    sources = [
        "src/nolibc.c",
        "src/queue.c",
        "src/register.c",
        "src/setup.c",
        "src/syscall.c",
        "src/version.c",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}
