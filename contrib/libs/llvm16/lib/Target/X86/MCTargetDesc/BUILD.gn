        "X86ATTInstPrinter.cpp",
        "X86ELFObjectWriter.cpp",
        "X86InstComments.cpp",
        "X86InstPrinterCommon.cpp",
        "X86InstrRelaxTables.cpp",
        "X86IntelInstPrinter.cpp",
        "X86MachObjectWriter.cpp",
        "X86MCAsmInfo.cpp",
