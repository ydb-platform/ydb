config("public_config") {
    include_dirs = [ "lib/includes" ]
}

config("private_config") {
    defines = [
        "BUILDING_NGHTTP3",
        "HAVE_CONFIG_H",
        "sfparse_base64decode=nghttp3_sfparse_base64decode",
        "sfparse_parser_dict=nghttp3_sfparse_parser_dict",
        "sfparse_parser_inner_list=nghttp3_sfparse_parser_inner_list",
        "sfparse_parser_init=nghttp3_sfparse_parser_init",
        "sfparse_parser_item=nghttp3_sfparse_parser_item",
        "sfparse_parser_list=nghttp3_sfparse_parser_list",
        "sfparse_parser_param=nghttp3_sfparse_parser_param",
        "sfparse_pctdecode=nghttp3_sfparse_pctdecode",
        "sfparse_unescape=nghttp3_sfparse_unescape",
    ]
    include_dirs = [ "." ]
}

contrib_library("nghttp3") {
    sources = [
        "lib/nghttp3_balloc.c",
        "lib/nghttp3_buf.c",
        "lib/nghttp3_callbacks.c",
        "lib/nghttp3_conn.c",
        "lib/nghttp3_conv.c",
        "lib/nghttp3_debug.c",
        "lib/nghttp3_err.c",
        "lib/nghttp3_frame.c",
        "lib/nghttp3_gaptr.c",
        "lib/nghttp3_http.c",
        "lib/nghttp3_idtr.c",
        "lib/nghttp3_ksl.c",
        "lib/nghttp3_map.c",
        "lib/nghttp3_mem.c",
        "lib/nghttp3_objalloc.c",
        "lib/nghttp3_opl.c",
        "lib/nghttp3_pq.c",
        "lib/nghttp3_qpack_huffman_data.c",
        "lib/nghttp3_qpack_huffman.c",
        "lib/nghttp3_qpack.c",
        "lib/nghttp3_range.c",
        "lib/nghttp3_ratelim.c",
        "lib/nghttp3_rcbuf.c",
        "lib/nghttp3_ringbuf.c",
        "lib/nghttp3_settings.c",
        "lib/nghttp3_str.c",
        "lib/nghttp3_stream.c",
        "lib/nghttp3_tnode.c",
        "lib/nghttp3_unreachable.c",
        "lib/nghttp3_vec.c",
        "lib/nghttp3_version.c",
        "lib/sfparse/sfparse.c",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}