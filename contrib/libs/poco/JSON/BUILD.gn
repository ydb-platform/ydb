config("public_config") {
    include_dirs = [ "include" ]
}

config("private_config") {
    cflags = [ "-Wno-sign-compare" ]
}

contrib_library("JSON") {
    deps = [ "//contrib/libs/poco/Foundation" ]

    sources = [
        "src/Array.cpp",
        "src/Handler.cpp",
        "src/JSONException.cpp",
        "src/Object.cpp",
        "src/ParseHandler.cpp",
        "src/Parser.cpp",
        "src/ParserImpl.cpp",
        "src/pdjson.c",
        "src/PrintHandler.cpp",
        "src/Query.cpp",
        "src/Stringifier.cpp",
        "src/Template.cpp",
        "src/TemplateCache.cpp",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}
