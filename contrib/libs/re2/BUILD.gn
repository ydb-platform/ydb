config("public_config") {
    include_dirs = [ "include" ]
}

config("private_config") {
    cflags = [
        "-Wno-deprecated-declarations",
    ]
    include_dirs = [ "." ]
}

contrib_library("re2") {
    public_deps = [ "//contrib/restricted/abseil-cpp" ]

    sources = [
        "re2/bitmap256.cc",
        "re2/bitstate.cc",
        "re2/compile.cc",
        "re2/dfa.cc",
        "re2/filtered_re2.cc",
        "re2/mimics_pcre.cc",
        "re2/nfa.cc",
        "re2/onepass.cc",
        "re2/parse.cc",
        "re2/perl_groups.cc",
        "re2/prefilter_tree.cc",
        "re2/prefilter.cc",
        "re2/prog.cc",
        "re2/re2.cc",
        "re2/regexp.cc",
        "re2/set.cc",
        "re2/simplify.cc",
        "re2/tostring.cc",
        "re2/unicode_casefold.cc",
        "re2/unicode_groups.cc",
        "util/rune.cc",
        "util/strutil.cc",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}
