        "compress/zbuff_compress.c",
        "compress/zstd_compress.c",
        "decompress/huf_decompress.c",
        "decompress/zbuff_decompress.c",
        "decompress/zstd_decompress.c",
        "dictBuilder/divsufsort.c",
        "dictBuilder/zdict.c",
        "legacy/zstd_v01.c",
        "legacy/zstd_v02.c",
        "legacy/zstd_v03.c",
        "legacy/zstd_v04.c",
        "legacy/zstd_v05.c",
        "legacy/zstd_v07.c",
        "legacy/zstd_v08.c",
