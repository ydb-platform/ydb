     #[test]
+    fn cgroup_cpu_files_support_v1_and_v2() {
+        let base_path = env::temp_dir().join(format!("temporal-cgroup-cpu-{}", std::process::id()));
+        fs::create_dir_all(&base_path).unwrap();
+        let cgroup_info = CGroupCpuInfo::new(CgroupCpuFileSystem {
+            base_path: base_path.clone(),
+        });
+        for (accounting, cpu) in [("cpuacct", "cpu"), ("cpu,cpuacct", "cpu,cpuacct")] {
+            fs::create_dir_all(base_path.join(accounting)).unwrap();
+            fs::create_dir_all(base_path.join(cpu)).unwrap();
+            fs::write(base_path.join(accounting).join("cpuacct.usage"), "500000\n").unwrap();
+            fs::write(base_path.join(cpu).join("cpu.cfs_quota_us"), "200000\n").unwrap();
+            fs::write(base_path.join(cpu).join("cpu.cfs_period_us"), "100000\n").unwrap();
+            assert_eq!(cgroup_info.read_cpu_usage(), Some(500));
+            let limits = cgroup_info.read_cpus_limit().unwrap();
+            assert!(matches!(limits.quota, CpuQuota::Limited(200000)));
+            assert_eq!(limits.period, 100000);
+            fs::write(base_path.join(cpu).join("cpu.cfs_quota_us"), "-1\n").unwrap();
+            assert!(matches!(
+                cgroup_info.read_cpus_limit().unwrap().quota,
+                CpuQuota::Unlimited
+            ));
+            fs::remove_dir_all(base_path.join(accounting)).unwrap();
+            if accounting != cpu {
+                fs::remove_dir_all(base_path.join(cpu)).unwrap();
+            }
+        }
+        fs::write(
+            base_path.join("cpu.stat"),
+            "usage_usec 750\nuser_usec 500\n",
+        )
+        .unwrap();
+        fs::write(base_path.join("cpu.max"), "200000 100000\n").unwrap();
+        assert_eq!(cgroup_info.read_cpu_usage(), Some(750));
+        let limits = cgroup_info.read_cpus_limit().unwrap();
+        assert!(matches!(limits.quota, CpuQuota::Limited(200000)));
+        assert_eq!(limits.period, 100000);
+        fs::remove_dir_all(base_path).unwrap();
+    }
