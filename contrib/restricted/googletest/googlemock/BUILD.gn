config("public_config") {
    include_dirs = [ "include" ]
}

config("private_config") {
    include_dirs = [ "." ]
}

contrib_library("googlemock") {
    public_deps = [ "//contrib/restricted/googletest/googletest" ]

    sources = [ "src/gmock-all.cc" ]

    public_configs = [ ":public_config" ]
    configs = [
        ":private_config",
        "//build/gn/config:no_warnings",
    ]
}
