config("public_config") {
    include_dirs = [ "include" ]
}

config("private_config") {
    cflags = [ "-Wno-unused-variable" ]
    include_dirs = [ "src" ]
}

contrib_library("replxx") {
    sources = [
        "src/conversion.cxx",
        "src/ConvertUTF.cpp",
        "src/escape.cxx",
        "src/history.cxx",
        "src/prompt.cxx",
        "src/replxx_impl.cxx",
        "src/replxx.cxx",
        "src/terminal.cxx",
        "src/util.cxx",
        "src/wcwidth.cpp",
        "src/windows.cxx",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}
