config("private_config") {
    cflags = [
        "-Wno-implicit-function-declaration",
        "-Wno-int-conversion",
    ]
    defines = [
        "URI_LIBRARY_BUILD",
        "URI_VISIBILITY",
    ]
    include_dirs = [ ".", "include" ]
}

contrib_library("uriparser") {
    sources = [
        "src/UriCommon.c",
        "src/UriCompare.c",
        "src/UriEscape.c",
        "src/UriFile.c",
        "src/UriIp4.c",
        "src/UriIp4Base.c",
        "src/UriMemory.c",
        "src/UriNormalize.c",
        "src/UriNormalizeBase.c",
        "src/UriParse.c",
        "src/UriParseBase.c",
        "src/UriQuery.c",
        "src/UriRecompose.c",
        "src/UriResolve.c",
        "src/UriShorten.c",
    ]

    configs = [ ":private_config" ]
}
