config("public_config") {
    defines = [
        "WASM_C_API=WAVM_API",
        "WAVM_API=",
    ]
    include_dirs = [ "../Include" ]
}

config("private_config") {
    cflags = [
        "-Wno-c++23-extensions",
        "-Wno-exceptions",
        "-Wno-inconsistent-missing-override",
        "-Wno-invalid-noreturn",
        "-Wno-unused-function",
    ]
    defines = [
        "HAS_FUTIMENS",
        "HAS_UTIMENSAT",
    ]
    configs = [ "//contrib/libs/llvm16:public_config" ]
}

