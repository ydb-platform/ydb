# --- Freeze the entire stdlib and embed it into :python3 ---------------------
#
# Replaces upstream Python/frozen.c (which only freezes importlib bootstrap
# and a handful of startup modules) with a generated registry covering every
# .py under contrib/tools/python3/Lib/. Any consumer linking :python3
# automatically gets the full stdlib resolved through frozen imports — no
# filesystem lookup required.
#
# Module enumeration happens at gen time via list_stdlib_modules.py; the
# resulting list is mirrored to a JSON file that the reusable
# `_python_freeze_modules` template (see //build/gn/python.gni) feeds to
# the one-shot freezer driver.

_stdlib_modules = exec_script(
    "//build/gn/scripts/list_stdlib_modules.py",
    [ rebase_path("//contrib/tools/python3/Lib") ],
    "json"
)

_stdlib_modules_json = "$target_gen_dir/stdlib_modules.json"
write_file(_stdlib_modules_json, _stdlib_modules, "json")

python_freeze_modules("frozen_stdlib") {
    modules_json = _stdlib_modules_json
    mode = "full"
    output = "$target_gen_dir/frozen_stdlib.c"
    workdir = "$target_gen_dir/frozen_stdlib"
}

contrib_library("python3") {
    sources = [ "$target_gen_dir/frozen_stdlib.c" ]
    deps = [
        ":python3_core",
        ":frozen_stdlib",
    ]
    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}
