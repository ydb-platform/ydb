import("//build/gn/python.gni")

config("public_config") {
    include_dirs = [ "Include" ]
}

config("private_config") {
    cflags = [
        "-Wno-unused-variable",
    ]
    defines = [
        "Py_BUILD_CORE",
        "Py_BUILD_CORE_BUILTIN",
        "USE_ZLIB_CRC32",
        "PREFIX=\"/var/empty\"",
        "EXEC_PREFIX=\"/var/empty\"",
        "VERSION=\"3.13\"",
        "VPATH=\"\"",
        "PLATLIBDIR=\"lib\"",
        "PLATFORM=\"linux\"",
        "MULTIARCH=\"x86_64-linux-gnu\"",
        "SOABI=\"cpython-313-x86_64-linux-gnu\"",
    ]
    include_dirs = [
        ".",
        "Include/internal",
        "Include/internal/mimalloc",
        "Modules/_decimal/libmpdec",
        "Modules/_hacl/include",
    ]
}

# CPython's _freeze_module tool: takes a (name, input.py, output.h) triple
# and emits a C header containing the marshaled bytecode as
# _Py_M__<sanitized_name>[]. It explicitly declares its own copies of the
# _PyImport_Frozen* globals (see Programs/_freeze_module.c), so it must be
# linked against the interpreter core *without* Python/frozen.c — that's
# what :python3_core provides.
contrib_tool("_freeze_module") {
    # TODO: private target - hide by visibility.

    sources = [ "Programs/_freeze_module.c" ]
    deps = [ "//contrib/tools/python3:python3_core" ]
    configs = [ ":private_config" ]
}

