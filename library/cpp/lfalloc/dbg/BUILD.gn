config("dbg_private_config") {
  cflags = [
    "-Wno-deprecated-volatile",
    "-Wno-implicit-exception-spec-mismatch",
    "-Wno-missing-exception-spec",
    "-Wno-sign-compare",
    "-Wno-unused-private-field",
  ]
}

contrib_library("dbg") {
  deps = [
    # "//library/cpp/lfalloc",
    "//library/cpp/malloc/api",  # peerdir only
  ]

  sources = [ "//library/cpp/lfalloc/lf_allocX64.cpp" ]

  configs = [ ":dbg_private_config" ]

  link_slot_provides = [ "allocator" ]
}
