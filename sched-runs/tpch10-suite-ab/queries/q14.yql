PRAGMA ydb.HashJoinMode = "grace";
PRAGMA ydb.UseBlockHashJoin = "true";
PRAGMA ydb.CostBasedOptimizationLevel = "0";
PRAGMA UseBlocks = "true";
PRAGMA BlockEngine = "force";
PRAGMA s3.UseRuntimeListing = "false";
PRAGMA ydb.MaxTasksPerStage = "32";

pragma warning("disable", "4527");

$z0 = 0;
$z1_2 = 1.2;
$z1_3 = 1.3;
$z0_9 = 0.9;
$z0_99 = 0.99;
$z1_49 = 1.49;

$z0_35 = 0;
$z0_35_9 = 0;
$z0_1_35 = 0.1;
$z1_2_35 = 1.2;
$z0_05_35 = 0.05;
$z0_9_35 = 0.9;
$z1_1_35 = 1.1;
$z0_5_35 = 0.5;
$z100_35 = 100.;
$z7_35 = 7.;

$z0_12 = 0.;
$z1_12 = 1;
$z0_0100001_12 = 0.0100001;
$z0_06_12 = 0.06;
$z0_2_12 = 0.2;

$scale_factor = 10;

$round = ($x, $y) -> { return Math::Round($x, $y); };
$upscale = ($x) -> { return $x; };

$todecimal = ($x, $p, $s) -> { return cast($x as double); };


-- TPC-H/TPC-R Promotion Effect Query (Q14)
-- TPC TPC-H Parameter Substitution (Version 2.17.2 build 0)
-- using 1680793381 as a seed to the RNG

$border = Date("1995-09-01");
select
    $z100_35 * sum(case
        when p.p_type like 'PROMO%'
            then l.l_extendedprice * ($z1_12 - l.l_discount)
        else $z0_12
    end) / sum(l.l_extendedprice * ($z1_12 - l.l_discount)) as promo_revenue
from
    lineitem as l
join
    part as p
on
    l.l_partkey = p.p_partkey
where
    l.l_shipdate >= $border
    and l.l_shipdate < ($border + Interval("P30D"));
