PRAGMA ydb.HashJoinMode = "grace";
PRAGMA ydb.UseBlockHashJoin = "true";
PRAGMA ydb.CostBasedOptimizationLevel = "0";
PRAGMA UseBlocks = "true";
PRAGMA BlockEngine = "force";
PRAGMA s3.UseRuntimeListing = "false";
PRAGMA ydb.MaxTasksPerStage = "32";

pragma warning("disable", "4527");

$z0 = 0;
$z1_2 = 1.2;
$z1_3 = 1.3;
$z0_9 = 0.9;
$z0_99 = 0.99;
$z1_49 = 1.49;

$z0_35 = 0;
$z0_35_9 = 0;
$z0_1_35 = 0.1;
$z1_2_35 = 1.2;
$z0_05_35 = 0.05;
$z0_9_35 = 0.9;
$z1_1_35 = 1.1;
$z0_5_35 = 0.5;
$z100_35 = 100.;
$z7_35 = 7.;

$z0_12 = 0.;
$z1_12 = 1;
$z0_0100001_12 = 0.0100001;
$z0_06_12 = 0.06;
$z0_2_12 = 0.2;

$scale_factor = 100;

$round = ($x, $y) -> { return Math::Round($x, $y); };
$upscale = ($x) -> { return $x; };

$todecimal = ($x, $p, $s) -> { return cast($x as double); };


-- TPC-H/TPC-R Shipping Priority Query (Q3)
-- TPC TPC-H Parameter Substitution (Version 2.17.2 build 0)
-- using 1680793381 as a seed to the RNG

$c = (
select
    c_custkey
from
    customer
where
    c_mktsegment = 'BUILDING'
);

$o = (
select
    o_orderdate,
    o_shippriority,
    o_orderkey
from
    orders as o
left semi join
    $c as c
on
    c.c_custkey = o.o_custkey
where
    o_orderdate < Date('1995-03-15')
);

$join2 = (
select
    o.o_orderdate as o_orderdate,
    o.o_shippriority as o_shippriority,
    l.l_orderkey as l_orderkey,
    l.l_discount as l_discount,
    l.l_extendedprice as l_extendedprice
from
    lineitem as l
join
    $o as o
on
    l.l_orderkey = o.o_orderkey
where
    l_shipdate > Date('1995-03-15')
);

select
    l_orderkey,
    $round(sum(l_extendedprice * ($z1_12 - l_discount)), -3) as revenue,
    o_orderdate,
    o_shippriority
from
    $join2
group by
    l_orderkey,
    o_orderdate,
    o_shippriority
order by
    revenue desc,
    o_orderdate,
    l_orderkey
limit 10;
