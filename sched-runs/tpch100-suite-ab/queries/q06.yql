PRAGMA ydb.HashJoinMode = "grace";
PRAGMA ydb.UseBlockHashJoin = "true";
PRAGMA ydb.CostBasedOptimizationLevel = "0";
PRAGMA UseBlocks = "true";
PRAGMA BlockEngine = "force";
PRAGMA s3.UseRuntimeListing = "false";
PRAGMA ydb.MaxTasksPerStage = "32";

pragma warning("disable", "4527");

$z0 = 0;
$z1_2 = 1.2;
$z1_3 = 1.3;
$z0_9 = 0.9;
$z0_99 = 0.99;
$z1_49 = 1.49;

$z0_35 = 0;
$z0_35_9 = 0;
$z0_1_35 = 0.1;
$z1_2_35 = 1.2;
$z0_05_35 = 0.05;
$z0_9_35 = 0.9;
$z1_1_35 = 1.1;
$z0_5_35 = 0.5;
$z100_35 = 100.;
$z7_35 = 7.;

$z0_12 = 0.;
$z1_12 = 1;
$z0_0100001_12 = 0.0100001;
$z0_06_12 = 0.06;
$z0_2_12 = 0.2;

$scale_factor = 100;

$round = ($x, $y) -> { return Math::Round($x, $y); };
$upscale = ($x) -> { return $x; };

$todecimal = ($x, $p, $s) -> { return cast($x as double); };


-- TPC-H/TPC-R Forecasting Revenue Change Query (Q6)
-- TPC TPC-H Parameter Substitution (Version 2.17.2 build 0)
-- using 1680793381 as a seed to the RNG

$border = Date("1994-01-01");

select
    sum(l_extendedprice * l_discount) as revenue
from
    lineitem
where
    l_shipdate >= $border 
    and l_shipdate < ($border + Interval("P365D"))
    and l_discount between $z0_06_12 - $z0_0100001_12 and $z0_06_12 + $z0_0100001_12
    and l_quantity < 24;
