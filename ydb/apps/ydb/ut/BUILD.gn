unittest_executable("ut") {
  deps = [
    "//contrib/libs/fmt",
    "//contrib/libs/grpc",
    "//contrib/libs/jwt-cpp",  # peerdir only
    "//contrib/libs/protobuf",
    "//library/cpp/json",
    "//library/cpp/testing/common",
    "//library/cpp/testing/unittest",
    "//ydb/core/security/certificate_check",
    "//ydb/public/api/client/yc_public/iam",
    "//ydb/public/api/grpc",
    "//ydb/public/api/protos",
    "//ydb/public/lib/ydb_cli/commands",
    "//ydb/public/sdk/cpp/src/client/table",
    "//ydb/public/sdk/cpp/src/client/topic",
    "//ydb/public/sdk/cpp/tests/unit/client/oauth2_token_exchange/helpers",
  ]

  data_deps = [
    "//ydb/apps/ydb",
    "//ydb/apps/ydbd",
  ]

  sources = [
    "parse_command_line.cpp",
    "run_ydb.cpp",
    "supported_codecs.cpp",
    "supported_codecs_fixture.cpp",
    "workload-topic.cpp",
    "workload-transfer-topic-to-table.cpp",
    "ydb-dump.cpp",
  ]

  test_depends_unbuilt = [ "//ydb/public/tools/ydb_recipe" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
