unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/hook",
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/base/services",
    "//ydb/core/blob_depot",
    "//ydb/core/blob_depot/agent",
    "//ydb/core/control/lib",
    "//ydb/core/protos",
    "//ydb/core/testlib",
    "//ydb/core/testlib/actors",
    "//ydb/core/testlib/basics",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/core/wrappers",
    "//ydb/library/actors/core",
    "//ydb/library/actors/http",
    "//ydb/library/aws_init",
  ]

  sources = [
    "//ydb/core/blob_depot/closed_interval_set_ut.cpp",
    "//ydb/core/blob_depot/given_id_range_ut.cpp",
    "//ydb/core/blob_depot/s3_limits_ut.cpp",
    "agent_disconnect_ut.cpp",
    "s3_router_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/blob_depot" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
