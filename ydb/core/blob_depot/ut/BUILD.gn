unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/blob_depot",
  ]

  sources = [
    "//ydb/core/blob_depot/closed_interval_set_ut.cpp",
    "//ydb/core/blob_depot/given_id_range_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/blob_depot" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
