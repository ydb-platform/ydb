unittest_executable("ut") {
  deps = [
    "//library/cpp/getopt",  # peerdir only
    "//library/cpp/monlib/dynamic_counters",
    "//library/cpp/svnversion",  # peerdir only
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/blobstorage/backpressure",
    "//ydb/core/blobstorage/dsproxy/mock",  # peerdir only
    "//ydb/core/blobstorage/pdisk",
    "//ydb/core/blobstorage/vdisk",
    "//ydb/core/blobstorage/vdisk/common",
    "//ydb/core/testlib/actors",
    "//ydb/library/actors/core",
    "//ydb/library/actors/protos",
  ]

  sources = [
    "//ydb/core/blobstorage/backpressure/common_ut.cpp",
    "//ydb/core/blobstorage/backpressure/queue_backpressure_client_ut.cpp",
    "//ydb/core/blobstorage/backpressure/queue_backpressure_server_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/blobstorage/backpressure" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
