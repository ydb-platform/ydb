unittest_executable("ut_client") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/blobstorage/backpressure",
    "//ydb/core/blobstorage/base",
    "//ydb/core/blobstorage/vdisk",  # peerdir only
    "//ydb/core/blobstorage/vdisk/common",
    "//ydb/core/testlib/basics",
    "//ydb/core/tx/scheme_board",  # peerdir only
    "//ydb/core/util/actorsys_test",
    "//ydb/library/actors/core",
    "//ydb/library/actors/interconnect",  # peerdir only
    "//yql/essentials/public/udf/service/stub",  # peerdir only
  ]

  sources = [ "backpressure_ut.cpp" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
