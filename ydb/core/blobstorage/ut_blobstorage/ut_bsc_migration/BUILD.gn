unittest_executable("ut_bsc_migration") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/blobstorage/ut_blobstorage/lib",
    "//ydb/core/protos",
    "//yql/essentials/minikql",
    "//yql/essentials/minikql/invoke_builtins",
  ]

  sources = [ "//ydb/core/blobstorage/ut_blobstorage/bsc_migration.cpp" ]

  include_dirs = [ "//ydb/core/blobstorage/ut_blobstorage" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
