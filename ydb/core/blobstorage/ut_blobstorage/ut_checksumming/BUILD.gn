unittest_executable("ut_checksumming") {
  deps = [
    "//ydb/core/blobstorage/base",
    "//ydb/core/blobstorage/dsproxy",
    "//ydb/core/blobstorage/groupinfo",
    "//ydb/core/blobstorage/ut_blobstorage/lib",
    "//ydb/core/blobstorage/vdisk/common",
    "//ydb/core/blobstorage/vdisk/hulldb/base",  # peerdir only
  ]

  sources = [ "checksumming.cpp" ]

  include_dirs = [ "//ydb/core/blobstorage/ut_blobstorage" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
