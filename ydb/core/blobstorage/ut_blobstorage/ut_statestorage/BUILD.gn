unittest_executable("ut_statestorage") {
  deps = [
    "//contrib/libs/protobuf",
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/blobstorage/nodewarden",
    "//ydb/core/blobstorage/ut_blobstorage/lib",
  ]

  sources = [
    "//ydb/core/blobstorage/ut_blobstorage/statestorage.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/statestorage_2_ring_groups.cpp",
  ]

  include_dirs = [ "//ydb/core/blobstorage/ut_blobstorage" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
