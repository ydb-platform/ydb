unittest_executable("ut") {
  deps = [
    "//library/cpp/getopt",  # peerdir only
    "//library/cpp/svnversion",  # peerdir only
    "//library/cpp/testing/unittest",
    "//ydb/core/blobstorage/vdisk/defrag",
    "//ydb/core/blobstorage/vdisk/huge",
    "//ydb/core/blobstorage/vdisk/hulldb",  # peerdir only
    "//ydb/core/blobstorage/vdisk/hulldb/base",
  ]

  sources = [
    "//ydb/core/blobstorage/vdisk/defrag/defrag_actor_ut.cpp",
    "//ydb/core/blobstorage/vdisk/defrag/defrag_search_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/blobstorage/vdisk/defrag" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
