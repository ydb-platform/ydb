    "//library/cpp/getopt",  # peerdir only
    "//library/cpp/svnversion",  # peerdir only
    "//library/cpp/testing/unittest",
    "//ydb/core/base",  # peerdir only
    "//ydb/core/blobstorage",  # peerdir only
    "//ydb/core/blobstorage/groupinfo",  # peerdir only
    "//ydb/core/blobstorage/vdisk/huge",
    "//ydb/core/blobstorage/vdisk/hulldb/base",
    "//ydb/core/erasure",  # peerdir only
  ]

  sources = [
    "//ydb/core/blobstorage/vdisk/huge/blobstorage_hullhuge_ut.cpp",
    "//ydb/core/blobstorage/vdisk/huge/blobstorage_hullhugeheap_ctx_ut.cpp",
    "//ydb/core/blobstorage/vdisk/huge/blobstorage_hullhugeheap_ut.cpp",
    "//ydb/core/blobstorage/vdisk/huge/top_ut.cpp",
