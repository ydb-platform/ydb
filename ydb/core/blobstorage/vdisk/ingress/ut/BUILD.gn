unittest_executable("ut") {
  deps = [
    "//library/cpp/getopt",  # peerdir only
    "//library/cpp/svnversion",  # peerdir only
    "//library/cpp/testing/unittest",
    "//ydb/core/base",  # peerdir only
    "//ydb/core/blobstorage/base",  # peerdir only
    "//ydb/core/blobstorage/groupinfo",
    "//ydb/core/blobstorage/vdisk/ingress",
    "//ydb/core/erasure",  # peerdir only
  ]

  sources = [
    "//ydb/core/blobstorage/vdisk/ingress/blobstorage_ingress_matrix_ut.cpp",
    "//ydb/core/blobstorage/vdisk/ingress/blobstorage_ingress_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/blobstorage/vdisk/ingress" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
