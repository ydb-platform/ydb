unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/blobstorage/vdisk/common",
    "//ydb/core/blobstorage/vdisk/huge",  # peerdir only
    "//ydb/core/blobstorage/vdisk/hulldb",
    "//ydb/core/blobstorage/vdisk/hulldb/base",
    "//ydb/core/blobstorage/vdisk/protos",
    "//ydb/core/blobstorage/vdisk/query",
    "//ydb/core/protos",
    "//ydb/library/actors/core",
  ]

  sources = [
    "//ydb/core/blobstorage/vdisk/query/query_spacetracker_ut.cpp",
    "query_spacereport_scan_ut.cpp",
    "query_stat_yield_ut.cpp",
    "query_statalgo_ut.cpp",
    "query_statdb_stream_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/blobstorage/vdisk/query" ]

  link_select = [
    "allocator=tcmalloc",
    "yql_pg_runtime=pg_dummy",
  ]
}
