unittest_executable("ut") {
  deps = [
    "//library/cpp/getopt",  # peerdir only
    "//library/cpp/svnversion",  # peerdir only
    "//library/cpp/testing/unittest",
    "//ydb/core/blobstorage",  # peerdir only
    "//ydb/core/blobstorage/vdisk/common",
    "//ydb/core/blobstorage/vdisk/hullop",
    "//ydb/core/blobstorage/vdisk/skeleton",
    "//ydb/core/testlib/actors",  # peerdir only
    "//ydb/core/testlib/basics",
    "//ydb/core/testlib/default",  # peerdir only
  ]

  sources = [
    "//ydb/core/blobstorage/vdisk/skeleton/skeleton_oos_logic_ut.cpp",
    "//ydb/core/blobstorage/vdisk/skeleton/skeleton_vpatch_actor_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/blobstorage/vdisk/skeleton" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
