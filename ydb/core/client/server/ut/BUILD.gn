unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/gmock_in_unittest",  # peerdir only
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/client/server",
    "//ydb/core/engine/minikql",
    "//ydb/core/keyvalue",
    "//ydb/core/persqueue",
    "//ydb/core/persqueue/events",
    "//ydb/core/tablet_flat",
    "//ydb/core/testlib",
    "//ydb/core/testlib/actors",  # peerdir only
    "//ydb/core/testlib/basics",
    "//ydb/core/testlib/default",  # peerdir only
  ]

  sources = [ "//ydb/core/client/server/msgbus_server_pq_metarequest_ut.cpp" ]

  include_dirs = [ "//ydb/core/client/server" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
