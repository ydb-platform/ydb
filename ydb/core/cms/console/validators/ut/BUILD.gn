unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/cms/console/validators",
    "//ydb/core/protos",
    "//ydb/library/actors/protos",
  ]

  sources = [
    "//ydb/core/cms/console/validators/registry_ut.cpp",
    "//ydb/core/cms/console/validators/validator_bootstrap_ut.cpp",
    "//ydb/core/cms/console/validators/validator_nameservice_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/cms/console/validators" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
