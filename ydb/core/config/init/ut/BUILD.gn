unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/config/init",
    "//ydb/core/config/validation",
    "//ydb/library/yaml_config",
    "//ydb/public/lib/ydb_cli/common",
    "//yql/essentials/public/udf/service/stub",  # peerdir only
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [
    "//ydb/core/config/init/init_ut.cpp",
    "//ydb/core/config/init/yaml_config_helpers_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/config/init" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
