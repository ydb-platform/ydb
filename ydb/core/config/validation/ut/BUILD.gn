unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/config/validation",
    "//ydb/core/protos",
    "//ydb/core/tx/conveyor_composite/common/config",
    "//ydb/library/actors/core",
  ]

  sources = [
    "//ydb/core/config/validation/validators_ut.cpp",
    "composite_conveyor_validator_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/config/validation" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
