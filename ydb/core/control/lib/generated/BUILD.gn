# yamake2gn: keep  -- hand-written, do not regenerate

executable("codegen") {
    _path = rebase_path(".", "//")
    _unique_name = exec_script("//build/gn/scripts/unique_name.py", [ _path ], "trim string")
    output_name = "${_unique_name}_${target_name}"

    defines = [ "YDB_CODEGEN_DESCRIPTOR_SET" ]
    deps += [
        "//contrib/libs/jinja2cpp",
        "//contrib/libs/protobuf",
    ]
    sources = [ "codegen/main.cpp" ]
}

proto_descriptor_set("config") {
    source = "//ydb/core/protos/config.proto"
}

template("codegen") {
    _gen_target = "${target_name}_gen"
    _output = "{{source_gen_dir}}/{{source_name_part}}"
    _codegen_name = exec_script("//build/gn/scripts/unique_name.py", [ rebase_path(".", "//") ], "trim string") + "_codegen"

    action_foreach(_gen_target) {
        script = "//build/gn/scripts/run.py"
        sources = invoker.sources
        outputs = [ "$_output" ]

        _codegen = ":codegen($tool_toolchain)"
        _codegen_bin = rebase_path(get_label_info(_codegen, "root_out_dir") + "/$_codegen_name", root_build_dir)
        _descriptors = get_target_outputs(":config")
        inputs = _descriptors

        args = [
            "./$_codegen_bin",
            rebase_path(_descriptors[0], root_build_dir),
            "{{source}}",
            "$_output",
        ]

        deps = [
            ":config",
            _codegen,
        ]
    }

    library(target_name) {
        forward_variables_from(invoker, "*", [ "deps", "sources" ])

        # Append to default deps
        deps = [ ":$_gen_target" ]
        if (defined(invoker.deps)) {
            deps += invoker.deps
        }

        sources = get_target_outputs(":$_gen_target")
    }
}

codegen("generated") {
    public_deps = [ "//ydb/core/protos" ]

    deps = [
        "//library/cpp/threading/hot_swap",
        "//ydb/core/control/lib/base",
    ]

    sources = [
        "control_board_proto.cpp.in",
        "control_board_proto.h.in",
    ]
}
