unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/formats/arrow",
    "//ydb/core/formats/arrow/accessor/common",
    "//ydb/core/formats/arrow/accessor/dictionary",
    "//ydb/core/formats/arrow/accessor/sparsed",
    "//ydb/library/actors/core",
    "//ydb/library/formats/arrow",
    "//yql/essentials/public/udf/service/stub",  # peerdir only
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [ "ut_dictionary.cpp" ]

  include_dirs = [ "//ydb/core/formats/arrow/accessor/dictionary" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
