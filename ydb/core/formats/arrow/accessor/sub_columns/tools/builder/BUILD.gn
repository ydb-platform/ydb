linked_executable("builder") {
  deps = [
    "//contrib/libs/apache/arrow",
    "//library/cpp/getopt",
    "//library/cpp/json",
    "//ydb/core/formats/arrow",
    "//ydb/core/formats/arrow/accessor/common",
    "//ydb/core/formats/arrow/accessor/sub_columns",
    "//ydb/library/formats/arrow/protos",
    "//ydb/services/metadata/abstract",
    "//yql/essentials/core",
    "//yql/essentials/parser/lexer_common",
    "//yql/essentials/providers/common/provider",
    "//yql/essentials/public/udf/service/stub",  # peerdir only
    "//yql/essentials/sql",
    "//yql/essentials/sql/pg_dummy",  # peerdir only
    "//yql/essentials/sql/v1/lexer/antlr4",
    "//yql/essentials/sql/v1/lexer/antlr4_ansi",
    "//yql/essentials/sql/v1/proto_parser/antlr4",
    "//yql/essentials/sql/v1/proto_parser/antlr4_ansi",
    "//yql/essentials/sql/v1/translation",
    "//yql/essentials/types/binary_json",
  ]

  sources = [ "main.cpp" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
