unittest_executable("ut") {
  deps = [
    "//contrib/libs/apache/arrow",
    "//contrib/libs/protobuf",
    "//library/cpp/testing/unittest",
    "//ydb/core/base",  # peerdir only
    "//ydb/core/formats/arrow",
    "//ydb/core/formats/arrow/printer",
    "//ydb/core/formats/arrow/program",
    "//ydb/library/actors/core",
    "//ydb/library/arrow_kernels",
    "//ydb/library/formats/arrow",  # peerdir only
    "//ydb/library/formats/arrow/hash",
    "//ydb/library/formats/arrow/simple_builder",
    "//yql/essentials/parser/pg_wrapper",  # peerdir only
    "//yql/essentials/public/decimal",
    "//yql/essentials/public/udf/service/exception_policy",  # peerdir only
    "//yql/essentials/sql/pg",  # peerdir only
    "//yql/essentials/types/binary_json",
  ]

  sources = [
    "//ydb/library/arrow_kernels/ut_common.cpp",
    "ut_arrow.cpp",
    "ut_column_filter.cpp",
    "ut_dictionary.cpp",
    "ut_hash.cpp",
    "ut_printer.cpp",
    "ut_program_step.cpp",
    "ut_reader.cpp",
    "ut_slicer.cpp",
  ]

  include_dirs = [ "//ydb/core/formats/arrow" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "yql_pg_runtime=pg_wrapper",
    "yql_pg_sql_translator=pg",
  ]
}
