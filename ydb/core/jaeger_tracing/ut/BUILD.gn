unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//library/cpp/time_provider",
    "//ydb/core/jaeger_tracing",
  ]

  sources = [
    "//ydb/core/jaeger_tracing/sampler_ut.cpp",
    "//ydb/core/jaeger_tracing/throttler_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/jaeger_tracing" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
