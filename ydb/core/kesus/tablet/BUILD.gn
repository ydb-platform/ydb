linked_executable("quoter_performance_test") {
  testonly = true

  deps = [
    ":tablet",
    "//library/cpp/getopt",
    "//library/cpp/testing/unittest",
    "//ydb/core/erasure",
    "//ydb/core/metering",
    "//ydb/core/testlib",
    "//ydb/core/testlib/basics",
