unittest_executable("ut") {
  deps = [
    "//library/cpp/getopt",  # peerdir only
    "//library/cpp/regex/pcre",  # peerdir only
    "//library/cpp/svnversion",  # peerdir only
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/blobstorage/dsproxy/mock",
    "//ydb/core/keyvalue",
    "//ydb/core/testlib",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/core/util/actorsys_test",
    "//ydb/public/lib/base",
  ]

  sources = [
    "//ydb/core/keyvalue/keyvalue_collector_ut.cpp",
    "//ydb/core/keyvalue/keyvalue_storage_read_request_ut.cpp",
    "//ydb/core/keyvalue/keyvalue_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/keyvalue" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
