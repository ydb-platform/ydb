unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/kqp/gateway/behaviour/streaming_query",  # peerdir only
    "//ydb/core/protos/schemeshard",
    "//ydb/core/tablet",
    "//ydb/core/testlib/basics",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/core/tx/scheme_cache",
    "//ydb/core/tx/schemeshard",
    "//ydb/core/tx/tx_proxy:public",
    "//ydb/services/metadata/scheme_transaction",
  ]

  sources = [ "scheme_transaction_ut.cpp" ]

  include_dirs = [
    "//ydb/core/kqp/gateway/behaviour/streaming_query",  # peerdir only
  ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
