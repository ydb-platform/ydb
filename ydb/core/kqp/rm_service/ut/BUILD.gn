unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/kqp/common/simple",
    "//ydb/core/kqp/rm_service",
    "//ydb/core/kqp/ut/common",  # peerdir only
    "//ydb/core/tablet",
    "//ydb/core/testlib",
    "//ydb/library/actors/core",
    "//ydb/library/actors/interconnect",
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [ "//ydb/core/kqp/rm_service/kqp_rm_ut.cpp" ]

  include_dirs = [ "//ydb/core/kqp/rm_service" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
