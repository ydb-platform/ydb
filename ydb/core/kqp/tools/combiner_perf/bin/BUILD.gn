linked_executable("combiner_perf") {
  testonly = true

  deps = [
    "//library/cpp/dwarf_backtrace",  # peerdir only
    "//library/cpp/dwarf_backtrace/registry",  # peerdir only
    "//library/cpp/getopt",
    "//library/cpp/json",
    "//library/cpp/lfalloc/alloc_profiler",
    "//ydb/core/kqp/tools/combiner_perf",
  ]

  sources = [ "main.cpp" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
