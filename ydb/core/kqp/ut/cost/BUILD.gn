unittest_executable("cost") {
  deps = [
    "//library/cpp/json",
    "//ydb/core/kqp",  # peerdir only
    "//ydb/core/kqp/counters",
    "//ydb/core/kqp/executer_actor",
    "//ydb/core/kqp/ut/common",
    "//ydb/core/tx/schemeshard",
    "//ydb/core/tx/tx_proxy:public",
    "//ydb/library/yql/udfs/common/knn",  # peerdir only
    "//ydb/public/sdk/cpp/src/client/proto",
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [
    "kqp_affected_rows_pg_ut.cpp",
    "kqp_cost_ut.cpp",
  ]

  include_dirs = [
    "//ydb/core/kqp",  # peerdir only
  ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
