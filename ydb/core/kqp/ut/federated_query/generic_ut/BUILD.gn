unittest_executable("generic_ut") {
  deps = [
    "//contrib/libs/apache/arrow",
    "//contrib/libs/fmt",
    "//contrib/libs/protobuf",
    "//library/cpp/testing/unittest",
    "//ydb/core/external_sources",
