unittest_executable("join") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/kqp",  # peerdir only
    "//ydb/core/kqp/counters",
    "//ydb/core/kqp/opt/cbo/bench",
    "//ydb/core/kqp/ut/common",
    "//ydb/public/lib/ydb_cli/common",
    "//ydb/public/lib/yson_value",
    "//ydb/public/sdk/cpp/src/client/proto",
    "//yql/essentials/sql/pg_dummy",  # peerdir only
    "//yql/essentials/udfs/common/digest",  # peerdir only
  ]

  sources = [
    "kqp_benches_ut.cpp",
    "kqp_block_hash_join_ut.cpp",
    "kqp_join_order_ut.cpp",
    "kqp_scalar_hash_join_ut.cpp",
  ]

  include_dirs = [
    "//ydb/core/kqp",  # peerdir only
  ]

  data = [
    "//ydb/core/kqp/ut/join/",
    "//ydb/library/benchmarks/gen_queries/consts.yql",
    "//ydb/library/benchmarks/queries/",
  ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
