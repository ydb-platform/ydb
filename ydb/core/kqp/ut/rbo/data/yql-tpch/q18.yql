$to_decimal = ($x) -> { return cast($x as Decimal(12, 2)); };
PRAGMA YqlSelect = 'force';
PRAGMA AnsiImplicitCrossJoin;

SELECT
    c_name,
    c_custkey,
    o_orderkey,
    o_orderdate,
    o_totalprice,
    Sum(l_quantity)
FROM
    `customer` as customer
,
    `orders` as orders
,
    `lineitem` as lineitem
WHERE
    o_orderkey IN (
        SELECT
            l_orderkey
        FROM
            `lineitem` as lineitem
        GROUP BY
            l_orderkey
        HAVING
            Sum(l_quantity) > $to_decimal(300)
    )
    AND c_custkey == o_custkey
    AND o_orderkey == l_orderkey
GROUP BY
    c_name,
    c_custkey,
    o_orderkey,
    o_orderdate,
    o_totalprice
ORDER BY
    o_totalprice DESC,
    o_orderdate
LIMIT 100;
