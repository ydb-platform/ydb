unittest_executable("view") {
  deps = [
    "//ydb/core/kqp",  # peerdir only
    "//ydb/core/kqp/ut/common",
    "//ydb/core/testlib/basics:default",  # peerdir only
    "//ydb/public/sdk/cpp/src/client/proto",
    "//yql/essentials/sql",
    "//yql/essentials/sql/v1",
    "//yql/essentials/sql/v1/lexer/antlr4",
    "//yql/essentials/sql/v1/lexer/antlr4_ansi",
    "//yql/essentials/sql/v1/proto_parser/antlr4",
    "//yql/essentials/sql/v1/proto_parser/antlr4_ansi",
    "//yql/essentials/utils/log",
  ]

  sources = [ "view_ut.cpp" ]

  include_dirs = [
    "//ydb/core/kqp",  # peerdir only
  ]

  data = [ "input/" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
