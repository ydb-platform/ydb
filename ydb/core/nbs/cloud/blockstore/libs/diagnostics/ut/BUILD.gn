unittest_executable("ut") {
  deps = [
    "//library/cpp/monlib/dynamic_counters",
    "//library/cpp/monlib/metrics",
    "//library/cpp/testing/unittest",
    "//ydb/core/nbs/cloud/blockstore/libs/diagnostics",
  ]

  sources = [
    "//ydb/core/nbs/cloud/blockstore/libs/diagnostics/dbg_counters_ut.cpp",
    "//ydb/core/nbs/cloud/blockstore/libs/diagnostics/vchunk_counters_ut.cpp",
    "//ydb/core/nbs/cloud/blockstore/libs/diagnostics/volume_counters_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/nbs/cloud/blockstore/libs/diagnostics" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
