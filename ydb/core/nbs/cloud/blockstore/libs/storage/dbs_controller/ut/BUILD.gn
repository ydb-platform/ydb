unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/base",  # peerdir only
    "//ydb/core/nbs/cloud/blockstore/libs/storage/dbs_controller",
    "//ydb/core/nbs/cloud/blockstore/libs/storage/testlib",
    "//ydb/core/protos",  # peerdir only
    "//ydb/core/testlib",
    "//ydb/core/testlib/basics",
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [
    "dbs_controller_database_ut.cpp",
    "dbs_controller_ut.cpp",
  ]

  include_dirs =
      [ "//ydb/core/nbs/cloud/blockstore/libs/storage/dbs_controller" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
