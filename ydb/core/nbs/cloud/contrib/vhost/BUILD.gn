# yamake2gn: keep  -- hand-written, do not regenerate

config("public_config") {
  include_dirs = [ "include" ]
}

config("private_config") {
  include_dirs = [ "." ]
}

library("vhost") {
  sources = [
    "blockdev.c",
    "event.c",
    "fs.c",
    "logging.c",
    "memlog.c",
    "memmap.c",
    "platform.c",
    "server.c",
    "vdev.c",
    "virtio/virt_queue.c",
    "virtio/virtio_blk.c",
    "virtio/virtio_fs.c",
  ]

  public_configs = [ ":public_config" ]
  configs = [ ":private_config" ]
}
