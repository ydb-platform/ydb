unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/persqueue/deferred_publish",
    "//ydb/core/protos",  # peerdir only
    "//ydb/library/actors/core",
  ]

  sources = [
    "//ydb/core/persqueue/deferred_publish/destination_blob.cpp",
    "deferred_publish_destination_blob_ut.cpp",
  ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
