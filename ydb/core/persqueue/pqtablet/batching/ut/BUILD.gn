unittest_executable("ut") {
  deps = [
    "//library/cpp/logger",
    "//library/cpp/streams/zstd",
    "//library/cpp/testing/unittest",
    "//ydb/core/base",  # peerdir only
    "//ydb/core/persqueue/events",  # peerdir only
    "//ydb/core/persqueue/pqtablet/batching",
    "//ydb/core/persqueue/public",
    "//ydb/core/persqueue/public/codecs",
    "//ydb/core/persqueue/public/write_meta",
    "//ydb/core/protos",
    "//ydb/core/testlib/basics",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/library/actors/core",
    "//ydb/library/services",
    "//ydb/public/api/protos",
    "//ydb/public/sdk/cpp/src/library/kafka",
  ]

  sources = [
    "batch_cutter_ut.cpp",
    "batch_processor_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/persqueue/pqtablet/batching" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
