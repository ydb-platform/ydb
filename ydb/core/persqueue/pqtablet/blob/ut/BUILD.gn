unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/persqueue/common",  # peerdir only
    "//ydb/core/persqueue/pqtablet/blob",
    "//ydb/core/scheme_types",
  ]

  sources = [
    "//ydb/core/persqueue/pqtablet/blob/blob_ut.cpp",
    "//ydb/core/persqueue/pqtablet/blob/type_codecs_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/persqueue/pqtablet/blob" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
