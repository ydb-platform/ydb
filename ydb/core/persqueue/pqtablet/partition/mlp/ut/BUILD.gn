unittest_executable("ut") {
  deps = [
    "//library/cpp/iterator",
    "//library/cpp/testing/unittest",
    "//library/cpp/time_provider",
    "//ydb/core/base",
    "//ydb/core/keyvalue",
    "//ydb/core/persqueue/events",
    "//ydb/core/persqueue/pqtablet/partition/mlp",
    "//ydb/core/persqueue/public/mlp/ut/common",
    "//ydb/core/persqueue/ut/common",
    "//ydb/core/persqueue/ut/common:pq_ut_common",
    "//ydb/core/protos",
    "//ydb/core/testlib",
    "//ydb/core/testlib/basics",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/library/actors/core",
    "//ydb/public/sdk/cpp/src/client/query",
  ]

  sources = [
    "mlp_child_sync_ut.cpp",
    "mlp_commit_ut.cpp",
    "mlp_consumer_order_ut.cpp",
    "mlp_consumer_precharge_fifo_ut.cpp",
    "mlp_consumer_split_ut.cpp",
    "mlp_consumer_ut.cpp",
    "mlp_consumer_wakeup_ut.cpp",
    "mlp_counters_ut.cpp",
    "mlp_dlq_mover_ut.cpp",
    "mlp_message_enricher_ut.cpp",
    "mlp_storage_ut.cpp",
    "mlp_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/persqueue/pqtablet/partition/mlp" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
