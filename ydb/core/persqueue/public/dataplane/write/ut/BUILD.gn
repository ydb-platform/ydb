unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/kqp/common",  # peerdir only
    "//ydb/core/kqp/common/events",
    "//ydb/core/kqp/common/simple",
    "//ydb/core/persqueue/events",
    "//ydb/core/persqueue/public",
    "//ydb/core/persqueue/public/dataplane",
    "//ydb/core/persqueue/ut/common",  # peerdir only
    "//ydb/core/persqueue/ut/common:pq_ut_common",
    "//ydb/core/persqueue/writer",
    "//ydb/core/tablet",
    "//ydb/core/tablet_flat",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/library/actors/core",
    "//ydb/library/actors/wilson",
    "//ydb/public/lib/base",
  ]

  sources = [
    "kqp_mock.cpp",
    "partition_writer_cache_actor_fixture.cpp",
    "partition_writer_cache_actor_ut.cpp",
    "pqtablet_mock.cpp",
