unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/cms/console",
    "//ydb/core/grpc_services/local_rpc",
    "//ydb/core/persqueue/public/describer",
    "//ydb/core/testlib",
    "//ydb/core/testlib/basics",
    "//ydb/core/tx/scheme_cache",
    "//ydb/library/aclib",
    "//ydb/public/api/grpc",
    "//ydb/public/sdk/cpp/src/client/persqueue_public/ut/ut_utils",
    "//ydb/public/sdk/cpp/src/client/query",
    "//ydb/public/sdk/cpp/src/client/topic/ut/ut_utils",  # peerdir only
    "//ydb/public/sdk/cpp/src/client/topic/ut/ut_utils:test_setup",
  ]

  sources = [
    "//ydb/core/persqueue/public/describer/describer_fake_scheme_cache_ut.cpp",
    "//ydb/core/persqueue/public/describer/describer_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/persqueue/public/describer" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
