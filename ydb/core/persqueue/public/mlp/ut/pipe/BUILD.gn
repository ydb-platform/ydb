unittest_executable("pipe") {
  deps = [
    "//ydb/core/persqueue/events",
    "//ydb/core/persqueue/public/mlp",  # peerdir only
    "//ydb/core/persqueue/public/mlp/ut/common",
  ]

  sources = [ "//ydb/core/persqueue/public/mlp/mlp_pipe_ut.cpp" ]

  include_dirs = [
    "//ydb/core/persqueue/public/mlp",  # peerdir only
  ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
