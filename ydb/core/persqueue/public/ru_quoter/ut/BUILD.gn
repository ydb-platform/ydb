unittest_executable("ut") {
  deps = [
    "//library/cpp/json",
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/metering",
    "//ydb/core/persqueue/public",
    "//ydb/core/persqueue/public/ru_quoter",
    "//ydb/core/quoter/public",
    "//ydb/core/testlib/basics",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/core/tx/scheme_cache",
    "//ydb/library/aclib",
  ]

  sources = [ "//ydb/core/persqueue/public/ru_quoter/ru_quoter_ut.cpp" ]

  include_dirs = [ "//ydb/core/persqueue/public/ru_quoter" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
