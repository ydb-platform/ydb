unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//library/cpp/threading/future",
    "//ydb/core/base",
    "//ydb/core/persqueue/events",
    "//ydb/core/persqueue/public",
    "//ydb/core/persqueue/public/describer",
    "//ydb/core/persqueue/public/schema",
    "//ydb/core/persqueue/public:utils",
    "//ydb/core/protos",
    "//ydb/core/testlib",
    "//ydb/core/testlib/actors",  # peerdir only
    "//ydb/core/testlib/basics",
    "//ydb/core/testlib/grpc_request",  # peerdir only
    "//ydb/core/tx/scheme_cache",
    "//ydb/core/tx/schemeshard",
    "//ydb/core/tx/tx_proxy:public",
    "//ydb/library/aclib",
    "//ydb/library/actors/core",
    "//ydb/public/sdk/cpp/src/client/persqueue_public/ut/ut_utils",  # peerdir only
    "//ydb/public/sdk/cpp/src/client/query",
    "//ydb/public/sdk/cpp/src/client/topic/ut/ut_utils",  # peerdir only
    "//ydb/public/sdk/cpp/src/client/topic/ut/ut_utils:test_setup",
    "//ydb/services/lib/actors:monitoring_settings",
  ]

  sources = [
    "//ydb/core/persqueue/public/schema/create_topic_ut.cpp",
    "//ydb/core/persqueue/public/schema/describe_operation_ut.cpp",
    "//ydb/core/persqueue/public/schema/propose_create_ut.cpp",
    "//ydb/core/persqueue/public/schema/schema_operation_ut.cpp",
    "//ydb/core/persqueue/public/schema/schema_ops_ut.cpp",
