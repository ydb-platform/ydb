unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/resource_pools",
    "//ydb/library/aclib",
  ]

  sources = [
    "//ydb/core/resource_pools/regex_predicate_ut.cpp",
    "//ydb/core/resource_pools/resource_pool_classifier_settings_ut.cpp",
    "//ydb/core/resource_pools/resource_pool_settings_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/resource_pools" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
