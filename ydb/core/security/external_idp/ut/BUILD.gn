unittest_executable("ut") {
  deps = [
    "//contrib/libs/jwt-cpp",
    "//contrib/libs/openssl",
    "//library/cpp/json",
    "//library/cpp/monlib/dynamic_counters",
    "//library/cpp/monlib/service/pages",
    "//library/cpp/string_utils/base64",
    "//library/cpp/testing/unittest",
    "//ydb/core/protos",
    "//ydb/core/security/external_idp",
    "//ydb/core/security/external_idp/test_utils",
    "//ydb/core/util/actorsys_test",
    "//ydb/library/actors/core",
    "//ydb/library/actors/http",
    "//ydb/library/security",
    "//ydb/library/services",
  ]

  sources = [ "//ydb/core/security/external_idp/external_idp_provider_ut.cpp" ]

  include_dirs = [ "//ydb/core/security/external_idp" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
