unittest_executable("ut") {
  deps = [
    "//library/cpp/json",
    "//library/cpp/testing/unittest",
    "//ydb/core/security/util",
  ]

  sources = [
    "//ydb/core/security/util/counters_ut.cpp",
    "//ydb/core/security/util/jwk_ut.cpp",
    "//ydb/core/security/util/net_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/security/util" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
