unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/sys_view/common",
    "//ydb/core/sys_view/partition_stats",
    "//ydb/core/testlib/actors",
    "//ydb/core/testlib/default",  # peerdir only
  ]

  sources = [ "//ydb/core/sys_view/partition_stats/partition_stats_ut.cpp" ]

  include_dirs = [ "//ydb/core/sys_view/partition_stats" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
