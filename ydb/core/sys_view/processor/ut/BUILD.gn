unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/sys_view/common",
    "//ydb/core/sys_view/processor",
    "//ydb/core/sys_view/service",
    "//ydb/core/tablet_flat/test/libs/table",  # peerdir only
    "//ydb/core/testlib",
    "//ydb/core/testlib/basics",
    "//yql/essentials/public/udf/service/exception_policy",  # peerdir only
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [ "query_metrics_ut.cpp" ]

  include_dirs = [ "//ydb/core/sys_view/processor" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
