unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/sys_view/service",
  ]

  sources = [ "//ydb/core/sys_view/service/query_history_ut.cpp" ]

  include_dirs = [ "//ydb/core/sys_view/service" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
