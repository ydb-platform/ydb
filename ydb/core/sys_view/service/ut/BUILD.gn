unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/protos",
    "//ydb/core/sys_view/common",
    "//ydb/core/sys_view/service",
    "//ydb/core/tablet_flat/test/libs/table",  # peerdir only
    "//ydb/core/testlib/basics",
    "//ydb/core/testlib/basics:default",  # peerdir only
    "//ydb/core/tx/scheme_cache",
    "//ydb/library/services",
    "//yql/essentials/public/udf/service/exception_policy",  # peerdir only
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [
    "//ydb/core/sys_view/service/db_counters_codec_ut.cpp",
    "//ydb/core/sys_view/service/query_history_ut.cpp",
    "//ydb/core/sys_view/service/query_interval_ut.cpp",
    "//ydb/core/sys_view/service/sysview_service_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/sys_view/service" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
