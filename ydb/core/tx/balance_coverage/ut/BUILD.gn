    "//library/cpp/testing/unittest",
    "//ydb/core/tx/balance_coverage",
  ]

  sources = [ "//ydb/core/tx/balance_coverage/balance_coverage_builder_ut.cpp" ]

  include_dirs = [ "//ydb/core/tx/balance_coverage" ]

  link_select = [
    "YqlServicePolicy=stub",
