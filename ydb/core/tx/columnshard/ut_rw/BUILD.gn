unittest_executable("ut_rw") {
  deps = [
    "//contrib/libs/apache/arrow",
    "//contrib/libs/aws-sdk-cpp/aws-cpp-sdk-core",
    "//library/cpp/getopt",  # peerdir only
    "//library/cpp/regex/pcre",  # peerdir only
    "//library/cpp/svnversion",  # peerdir only
    "//library/cpp/testing/hook",
    "//ydb/core/base",
    "//ydb/core/kqp/compute_actor:events",
    "//ydb/core/protos",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/core/tx",
    "//ydb/core/tx/columnshard",
    "//ydb/core/tx/columnshard/engines",
    "//ydb/core/tx/columnshard/engines/portions",
    "//ydb/core/tx/columnshard/hooks/abstract",
    "//ydb/core/tx/columnshard/hooks/testing",
    "//ydb/core/tx/columnshard/operations",
    "//ydb/core/tx/columnshard/test_helper",
    "//ydb/core/wrappers",
    "//ydb/library/actors/protos",
    "//ydb/library/formats/arrow/simple_builder",
    "//ydb/library/testlib/s3_recipe_helper",
    "//ydb/library/yverify_stream",
    "//ydb/public/lib/yson_value",  # peerdir only
    "//ydb/services/metadata",  # peerdir only
  ]

  sources = [
    "ut_backup.cpp",
    "ut_columnshard_read_write.cpp",
    "ut_normalizer.cpp",
  ]

  include_dirs = [ "//ydb/core/tx/columnshard" ]

  test_depends_unbuilt = [
    "//contrib/python/moto/bin",
    "//ydb/tests/tools/s3_recipe",
  ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
