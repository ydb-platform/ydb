unittest_executable("ut_s3_writer") {
  deps = [
    "//library/cpp/string_utils/base64",
    "//library/cpp/testing/unittest",
    "//ydb/core/tx/replication/service",
    "//ydb/core/tx/replication/ut_helpers",
