unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/tx/replication/ut_helpers",
    "//ydb/core/tx/replication/ydb_proxy",
    "//ydb/core/tx/replication/ydb_proxy/local_proxy",  # peerdir only
    "//ydb/public/sdk/cpp/src/client/topic",
  ]

  sources = [
    "//ydb/core/tx/replication/ydb_proxy/partition_end_watcher_ut.cpp",
    "//ydb/core/tx/replication/ydb_proxy/ydb_proxy_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/tx/replication/ydb_proxy" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_wrapper",
    "yql_pg_sql_translator=pg",
    "yt_codegen=llvm16",
  ]
}
