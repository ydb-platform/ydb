unittest_executable("ut_full_backup") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/grpc_services",
    "//ydb/core/protos",  # peerdir only
    "//ydb/core/protos/schemeshard",
    "//ydb/core/testlib",
    "//ydb/core/tx/schemeshard",
    "//ydb/core/tx/schemeshard/ut_helpers",
    "//ydb/public/api/protos",  # peerdir only
    "//ydb/public/sdk/cpp/src/library/operation_id",  # peerdir only
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [
    "ut_full_backup.cpp",
    "ut_full_backup_reboots.cpp",
  ]

  include_dirs = [ "//ydb/core/tx/schemeshard" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
