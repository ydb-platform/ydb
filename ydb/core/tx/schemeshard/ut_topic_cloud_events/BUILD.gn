unittest_executable("ut_topic_cloud_events") {
  deps = [
    "//library/cpp/json",  # peerdir only
    "//library/cpp/testing/unittest",
    "//library/cpp/threading/blocking_queue",
    "//ydb/core/persqueue/events",  # peerdir only
    "//ydb/core/persqueue/public/cloud_events",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/core/tx",  # peerdir only
    "//ydb/core/tx/schemeshard",  # peerdir only
    "//ydb/core/tx/schemeshard/ut_helpers",
  ]

  sources = [ "ut_topic_cloud_events.cpp" ]

  include_dirs = [
    "//ydb/core/tx/schemeshard",  # peerdir only
