unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/library/actors/async",
    "//ydb/library/actors/core",
    "//ydb/library/actors/testlib",
  ]

  sources = [
    "async_ut.cpp",
    "callback_coroutine_ut.cpp",
    "cancellation_ut.cpp",
    "continuation_ut.cpp",
    "event_ut.cpp",
    "frame_cache_ut.cpp",
    "low_priority_ut.cpp",
    "sleep_ut.cpp",
    "task_group_ut.cpp",
    "timeout_ut.cpp",
    "wait_for_event_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/actors/async" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
