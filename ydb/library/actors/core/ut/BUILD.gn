config("ut_private_config") {
  cflags = [ "-Wno-ambiguous-reversed-operator" ]
}

unittest_executable("ut") {
  deps = [
    "//library/cpp/deprecated/atomic",
    "//library/cpp/testing/unittest",
    "//library/cpp/threading/chunk_queue",
    "//ydb/library/actors/core",
    "//ydb/library/actors/interconnect",
    "//ydb/library/actors/protos",
    "//ydb/library/actors/scheduler",
    "//ydb/library/actors/testlib",
    "//ydb/library/actors/util",
  ]

  sources = [
    "actor_basic_ut.cpp",
    "actor_coroutine_ut.cpp",
    "actor_exception_ut.cpp",
    "actor_shared_threads.cpp",
    "actor_ut.cpp",
    "actorsystem_ut.cpp",
    "ask_ut.cpp",
    "benchmark_ut.cpp",
    "event_pb_payload_ut.cpp",
    "event_pb_ut.cpp",
    "executor_pool_basic_ut.cpp",
    "executor_pool_semaphore_ut.cpp",
    "executor_pools_ut.cpp",
    "log_ut.cpp",
    "mailbox_lockfree_ut.cpp",
    "mon_ut.cpp",
    "performance_ut.cpp",
    "process_stats_ut.cpp",
    "scheduler_actor_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/actors/core" ]

  link_select = [ "allocator=tcmalloc" ]

  configs = [ ":ut_private_config" ]
}
