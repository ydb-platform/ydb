unittest_executable("ut_fat") {
  deps = [
    "//library/cpp/deprecated/atomic",
    "//library/cpp/testing/unittest",
    "//library/cpp/threading/chunk_queue",
    "//ydb/library/actors/core",
    "//ydb/library/actors/testlib",
    "//ydb/library/actors/util",
  ]

  sources = [
    "actor_benchmark.cpp",
    "executor_pool_basic_waker.cpp",
    "waiting_benchs.cpp",
  ]

  include_dirs = [ "//ydb/library/actors/core" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
