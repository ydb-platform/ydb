linked_executable("example_02_discovery") {
  deps = [
    "//ydb/library/actors/core",
    "//ydb/library/actors/dnsresolver",
    "//ydb/library/actors/http",
    "//ydb/library/actors/interconnect",
    "//ydb/library/actors/interconnect/poller",
    "//ydb/library/actors/protos",
    "//ydb/library/actors/util",
  ]

  sources = [
    "endpoint.cpp",
    "lookup.cpp",
    "main.cpp",
    "protocol.proto",
    "publish.cpp",
    "replica.cpp",
  ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=lfalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
