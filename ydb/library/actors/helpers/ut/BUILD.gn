    "//library/cpp/testing/unittest",
    "//ydb/library/actors/core",
    "//ydb/library/actors/helpers",
    "//ydb/library/actors/interconnect",  # peerdir only
    "//ydb/library/actors/testlib",
  ]

  sources = [
    "//ydb/library/actors/helpers/actor_liveness_checker_ut.cpp",
    "//ydb/library/actors/helpers/collector_counters_ut.cpp",
    "//ydb/library/actors/helpers/selfping_actor_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/actors/helpers" ]

  link_select = [ "allocator=tcmalloc" ]
}
