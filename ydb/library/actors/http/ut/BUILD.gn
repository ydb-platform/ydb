    "//contrib/libs/poco/Crypto",  # peerdir only
    "//contrib/libs/poco/Foundation",  # peerdir only
    "//contrib/libs/poco/Net",
    "//contrib/libs/poco/NetSSL_OpenSSL",
    "//library/cpp/json",
