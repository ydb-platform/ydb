unittest_executable("ut_fat") {
  deps = [
    "//library/cpp/deprecated/atomic",
    "//library/cpp/digest/crc32c",
    "//library/cpp/testing/unittest",
    "//ydb/library/actors/core",  # peerdir only
    "//ydb/library/actors/interconnect",
    "//ydb/library/actors/interconnect/ut/lib",
    "//ydb/library/actors/interconnect/ut/lib:port_manager",  # peerdir only
    "//ydb/library/actors/interconnect/ut/protos",
  ]

  sources = [ "main.cpp" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
