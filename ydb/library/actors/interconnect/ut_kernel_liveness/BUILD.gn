unittest_executable("ut_kernel_liveness") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/library/actors/core",  # peerdir only
    "//ydb/library/actors/interconnect",  # peerdir only
    "//ydb/library/actors/interconnect/ut/lib",
    "//ydb/library/actors/interconnect/ut/lib:port_manager",  # peerdir only
    "//ydb/library/actors/interconnect/ut/protos",  # peerdir only
  ]

  sources = [ "tcp_user_timeout_ut.cpp" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
