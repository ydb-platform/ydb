unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/library/actors/core",
    "//ydb/library/actors/testlib",
  ]

  sources = [
    "//ydb/library/actors/testlib/decorator_ut.cpp",
    "//ydb/library/actors/testlib/subsystem_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/actors/testlib" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
