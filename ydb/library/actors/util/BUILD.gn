    "//library/cpp/containers/stack_vector",
    "//library/cpp/deprecated/atomic",
    "//library/cpp/sse",
  ]

  deps = [ "//library/cpp/containers/absl_flat_hash" ]

  sources = [
    "affinity.cpp",
    "memory_track.cpp",
    "memory_tracker.cpp",
    "rc_buf.cpp",
    "rope.cpp",
    "shared_data.cpp",
    "should_continue.cpp",
    "spinparkpad.cpp",
    "threadparkpad.cpp",
  ]

  public_configs = [ ":util_public_config" ]
}
