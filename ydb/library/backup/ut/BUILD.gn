unittest_executable("ut") {
  deps = [
    "//contrib/libs/protobuf",
    "//library/cpp/string_utils/quote",
    "//library/cpp/testing/unittest",
    "//ydb/library/backup",
    "//ydb/public/api/protos",
    "//ydb/public/sdk/cpp/src/client/result",
    "//ydb/public/sdk/cpp/src/client/table",
  ]

  sources = [ "ut.cpp" ]

  include_dirs = [ "//ydb/library/backup" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
