unittest_executable("ut") {
  deps = [
    "//contrib/libs/grpc",
    "//contrib/libs/protobuf",
    "//library/cpp/testing/unittest",
    "//ydb/library/grpc/server",
  ]

  sources = [
    "grpc_response_ut.cpp",
    "stream_adaptor_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/grpc/server" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
