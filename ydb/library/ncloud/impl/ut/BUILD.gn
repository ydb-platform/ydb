unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/testlib",  # peerdir only
    "//ydb/core/testlib/actors",
    "//ydb/library/actors/core",
    "//ydb/library/grpc/server",
    "//ydb/library/ncloud/impl",
    "//ydb/library/testlib/service_mocks",
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [ "//ydb/library/ncloud/impl/access_service_ut.cpp" ]

  include_dirs = [ "//ydb/library/ncloud/impl" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
