unittest_executable("ut_range_treap") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/library/range_treap",
  ]

  sources = [ "range_treap_ut.cpp" ]

  include_dirs = [ "//ydb/library/range_treap" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
