library("log") {
  deps = [
    # "//library/cpp/json",
    # "//library/cpp/resource",
    "//ydb/library/workload/abstract",
    "//ydb/public/api/protos",
  ]

  sources = [
    "log/log.cpp",
    "log/registrar.cpp",
  ]

  serialize_enum_headers = [ "log/log.h" ]

  resources = [
    {
      path = "log/select_queries.sql"
      key = "workload_logs_select_queries.sql"
    },
  ]
}

