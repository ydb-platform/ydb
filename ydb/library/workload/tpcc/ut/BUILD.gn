unittest_executable("ut") {
  deps = [
    "//library/cpp/getopt/small",  # peerdir only
    "//library/cpp/logger",
    "//library/cpp/testing/gmock_in_unittest",
    "//library/cpp/testing/unittest",
    "//library/cpp/threading/future",
    "//ydb/public/lib/ydb_cli/commands",
  ]

  sources = [
    "circular_queue_ut.cpp",
    "data_splitter_ut.cpp",
    "histogram_ut.cpp",
    "log_capture_ut.cpp",
    "task_queue_ut.cpp",
    "timer_queue_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/workload/tpcc" ]

  link_select = [
    "allocator=tcmalloc",
    "yql_pg_runtime=pg_dummy",
  ]
}
