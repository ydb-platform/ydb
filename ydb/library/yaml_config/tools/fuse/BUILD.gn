linked_executable("yaml-config-fuse") {
  deps = [
    "//library/cpp/getopt",
    "//ydb/library/fyamlcpp",  # peerdir only
    "//ydb/library/yaml_config/public",
  ]

  sources = [ "main.cpp" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
