  ]

  sources = [
    "accumulator_ut.cpp",
    "block_layout_converter_sliced_blocks_ut.cpp",
    "block_layout_converter_ut.cpp",
    "deep_copy_ut.cpp",
    "hash_table_ut.cpp",
