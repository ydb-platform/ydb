linked_executable("dq_hash_combine_perf") {
  testonly = true

  deps = [
    "//library/cpp/getopt/small",
    "//ydb/library/yql/dq/comp_nodes",
    "//ydb/library/yql/dq/comp_nodes/ut/utils",
    "//yql/essentials/minikql",
  ]

  sources = [ "main.cpp" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
