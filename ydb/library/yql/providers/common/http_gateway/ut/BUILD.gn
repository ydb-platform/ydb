unittest_executable("ut") {
  deps = [
    "//library/cpp/string_utils/quote",
    "//library/cpp/testing/unittest",
    "//ydb/library/yql/providers/common/http_gateway",
  ]

  sources = [
    "//ydb/library/yql/providers/common/http_gateway/yql_aws_signature_ut.cpp",
    "//ydb/library/yql/providers/common/http_gateway/yql_dns_gateway_ut.cpp",
    "//ydb/library/yql/providers/common/http_gateway/yql_http_default_retry_policy_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/yql/providers/common/http_gateway" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
