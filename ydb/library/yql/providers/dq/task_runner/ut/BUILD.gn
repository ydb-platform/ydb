unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/library/yql/providers/dq/api/protos",
    "//ydb/library/yql/providers/dq/common",  # peerdir only
    "//ydb/library/yql/providers/dq/task_runner",
    "//yql/essentials/minikql",
    "//yql/essentials/public/udf/service/exception_policy",  # peerdir only
    "//yql/essentials/sql/pg_dummy",  # peerdir only
    "//yql/essentials/utils/failure_injector",  # peerdir only
  ]

  sources = [
    "tasks_runner_pipe_constructor_ut.cpp",
    "tasks_runner_pipe_metrics_ut.cpp",
    "tasks_runner_pipe_process_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/yql/providers/dq/task_runner" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
