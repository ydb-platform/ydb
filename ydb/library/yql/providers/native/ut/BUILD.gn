unittest_executable("ut") {
  deps = [
    "//contrib/libs/apache/arrow",
    "//library/cpp/testing/unittest",
    "//ydb/library/yql/dq/proto",
    "//ydb/library/yql/providers/common/ut_helpers",
    "//ydb/library/yql/providers/native",
    "//yql/essentials/public/udf/arrow",
    "//yql/essentials/public/udf/service/exception_policy",  # peerdir only
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [ "read_actor_ut.cpp" ]

  include_dirs = [ "//ydb/library/yql/providers/native" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
