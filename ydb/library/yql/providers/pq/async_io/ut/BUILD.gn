unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/library/yql/providers/common/message_stream/async_io",
    "//ydb/library/yql/providers/common/ut_helpers",
    "//ydb/library/yql/providers/pq/async_io",
    "//yql/essentials/parser/pg_wrapper",  # peerdir only
    "//yql/essentials/public/udf/service/stub",  # peerdir only
  ]

  sources = [
    "dq_pq_cpu_quota_ut.cpp",
    "dq_pq_read_state_ut.cpp",
  ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_wrapper",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
