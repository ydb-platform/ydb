unittest_executable("ut") {
  deps = [
    "//contrib/libs/protobuf",
    "//library/cpp/testing/unittest",
    "//ydb/library/yql/providers/pq/common",
    "//ydb/library/yql/providers/pq/proto",
  ]

  sources = [
    "pq_meta_fields_ut.cpp",
    "pq_shared_reading_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/yql/providers/pq/common" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
