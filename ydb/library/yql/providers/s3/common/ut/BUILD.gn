unittest_executable("ut") {
  deps = [
    "//library/cpp/string_utils/quote",
    "//library/cpp/testing/unittest",
    "//ydb/library/yql/providers/s3/common",
    "//yql/essentials/public/udf/service/stub",  # peerdir only
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [
    "//ydb/library/yql/providers/s3/common/source_context_ut.cpp",
    "//ydb/library/yql/providers/s3/common/util_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/yql/providers/s3/common" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
