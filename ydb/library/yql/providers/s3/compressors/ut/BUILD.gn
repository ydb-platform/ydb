unittest_executable("ut") {
  deps = [
    "//library/cpp/scheme",
    "//library/cpp/testing/common",
    "//library/cpp/testing/unittest",
    "//ydb/library/yql/providers/s3/compressors",
    "//ydb/library/yql/udfs/common/clickhouse/client",
    "//yql/essentials/public/udf/service/stub",  # peerdir only
  ]

  sources = [
    "decompressor_ut.cpp",
    "output_queue_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/yql/providers/s3/compressors" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
