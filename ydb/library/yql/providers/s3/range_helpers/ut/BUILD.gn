unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/library/yql/providers/s3/proto",
    "//ydb/library/yql/providers/s3/range_helpers",
    "//yql/essentials/providers/common/provider",
    "//yql/essentials/public/udf/service/exception_policy",  # peerdir only
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [
    "//ydb/library/yql/providers/s3/range_helpers/file_tree_builder_ut.cpp",
    "//ydb/library/yql/providers/s3/range_helpers/path_list_reader_ut.cpp",
  ]

  include_dirs = [ "//ydb/library/yql/providers/s3/range_helpers" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
