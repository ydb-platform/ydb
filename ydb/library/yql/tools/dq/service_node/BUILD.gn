linked_executable("service_node") {
  deps = [
    "//library/cpp/digest/md5",
    "//library/cpp/getopt",  # peerdir only
    "//library/cpp/getopt/small",
    "//library/cpp/threading/future",
    "//ydb/library/yql/providers/dq/actors",
    "//ydb/library/yql/providers/dq/actors/yt",
    "//ydb/library/yql/providers/dq/global_worker_manager",
    "//ydb/library/yql/providers/dq/metrics",
    "//ydb/library/yql/providers/dq/provider",  # peerdir only
    "//ydb/library/yql/providers/dq/service",
    "//ydb/library/yql/providers/dq/stats_collector",
    "//ydb/library/yql/providers/dq/worker_manager/interface",
    "//ydb/library/yql/providers/yt/dq_task_preprocessor",
    "//yql/essentials/minikql/invoke_builtins",
    "//yql/essentials/minikql/invoke_builtins/llvm16",  # peerdir only
    "//yql/essentials/parser/pg_wrapper",  # peerdir only
    "//yql/essentials/public/udf/service/exception_policy",  # peerdir only
    "//yql/essentials/sql/pg",  # peerdir only
    "//yql/essentials/utils/backtrace",
    "//yql/essentials/utils/failure_injector",
    "//yql/essentials/utils/log",
    "//yql/essentials/utils/log/proto",
    "//yt/cpp/mapreduce/client",  # peerdir only
    "//yt/yql/providers/yt/codec/codegen",  # peerdir only
    "//yt/yql/providers/yt/comp_nodes/llvm16",  # peerdir only
    "//yt/yt/client",
    "//yt/yt/core",
  ]

  sources = [ "main.cpp" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "yql_pg_runtime=pg_wrapper",
    "yql_pg_sql_translator=pg",
    "yt_codegen=llvm16",
  ]
}
