unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/library/yql/utils/bindings",
    "//yql/essentials/utils",
  ]

  sources = [ "//ydb/library/yql/utils/bindings/utils_ut.cpp" ]

  include_dirs = [ "//ydb/library/yql/utils/bindings" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
