unittest_executable("ut") {
  deps = [
    "//contrib/libs/jwt-cpp",
    "//library/cpp/json",
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/testlib/actors",
    "//ydb/library/actors/core",
    "//ydb/library/actors/http",
    "//ydb/library/actors/testlib",
    "//ydb/library/security",
    "//ydb/library/testlib/service_mocks",
    "//ydb/mvp/core",
    "//ydb/mvp/core/ut/protos",
    "//ydb/mvp/core:protos",
    "//ydb/public/api/client/nc_private/iam/v1",
    "//ydb/public/api/grpc",
  ]

  sources = [
    "//ydb/mvp/core/mvp_security_printer_ut.cpp",
    "//ydb/mvp/core/mvp_test_runtime.cpp",
    "//ydb/mvp/core/mvp_tokens.cpp",
    "//ydb/mvp/core/mvp_ut.cpp",
    "mvp_startup_options_ut.cpp",
  ]

  include_dirs = [ "//ydb/mvp/core" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
