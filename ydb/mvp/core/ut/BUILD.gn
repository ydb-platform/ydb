unittest_executable("ut") {
  deps = [
    "//contrib/libs/jwt-cpp",  # peerdir only
    "//library/cpp/json",
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/testlib/actors",
    "//ydb/library/actors/core",
    "//ydb/library/security",
    "//ydb/library/testlib/service_mocks",
    "//ydb/mvp/core",
    "//ydb/mvp/core/ut/protos",
    "//ydb/mvp/core:protos",
    "//ydb/public/api/grpc",
  ]

  sources = [
    "//ydb/mvp/core/cracked_page_ut.cpp",
    "//ydb/mvp/core/mvp_security_printer_ut.cpp",
    "//ydb/mvp/core/mvp_startup_options_migration_ut.cpp",
    "//ydb/mvp/core/mvp_startup_options_ut.cpp",
    "//ydb/mvp/core/mvp_startup_options_validation_ut.cpp",
    "//ydb/mvp/core/mvp_test_runtime.cpp",
    "//ydb/mvp/core/mvp_tokens.cpp",
    "//ydb/mvp/core/mvp_ut.cpp",
  ]

  include_dirs = [ "//ydb/mvp/core" ]

  link_select = [
    "allocator=tcmalloc",
    "yql_pg_runtime=pg_dummy",
  ]
}
