unittest_executable("ut") {
  deps = [
    "//contrib/libs/protobuf",
    "//contrib/libs/yaml-cpp",
    "//library/cpp/json",
    "//library/cpp/testing/common",
    "//library/cpp/testing/unittest",
    "//ydb/core/testlib/actors",  # peerdir only
    "//ydb/library/actors/core",
    "//ydb/library/actors/http",
    "//ydb/library/actors/testlib",
    "//ydb/mvp/core",
    "//ydb/mvp/meta",
  ]

  sources = [
    "//ydb/mvp/meta/meta_cache_ut.cpp",
    "//ydb/mvp/meta/meta_capabilities_ut.cpp",
    "//ydb/mvp/meta/meta_support_links_ut.cpp",
    "//ydb/mvp/meta/meta_ut.cpp",
  ]

  include_dirs = [ "//ydb/mvp/meta" ]

  data = [ "//ydb/mvp/meta/examples/" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
