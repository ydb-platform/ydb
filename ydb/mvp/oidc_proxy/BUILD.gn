    "//ydb/mvp/core",
    "//ydb/mvp/core:protos",
    "//ydb/mvp/oidc_proxy/protos",
    "//ydb/public/api/client/nc_private/iam/v1",
    "//ydb/public/api/client/yc_private/oauth",
    # "//ydb/public/sdk/cpp/src/library/grpc/client",
  ]

  deps = [
    # "//contrib/libs/openssl",
