unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/public/lib/ydb_cli/dump",
    "//ydb/public/sdk/cpp/src/client/table",
  ]

  sources = [ "restore_compat_ut.cpp" ]

  include_dirs = [ "//ydb/public/lib/ydb_cli/dump" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
