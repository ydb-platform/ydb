unittest_executable("ut") {
  deps = [
    "//contrib/libs/grpc",
    "//library/cpp/logger",  # peerdir only
    "//library/cpp/testing/unittest",
    "//ydb/core/blobstorage/base",
    "//ydb/core/formats",
    "//ydb/core/protos",
    "//ydb/core/testlib",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/public/api/grpc/draft",
    "//ydb/services/distributed_storage",
  ]

  sources = [ "distributed_storage_ut.cpp" ]

  include_dirs = [ "//ydb/services/distributed_storage" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
