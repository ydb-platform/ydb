unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/persqueue/events",  # peerdir only
    "//ydb/core/persqueue/public",
    "//ydb/core/persqueue/public/describer",
    "//ydb/core/persqueue/public:utils",
    "//ydb/core/testlib/grpc_request",
    "//ydb/public/api/protos",
    "//ydb/public/sdk/cpp/src/client/driver",  # peerdir only
    "//ydb/public/sdk/cpp/src/client/persqueue_public",  # peerdir only
    "//ydb/public/sdk/cpp/src/client/persqueue_public/ut/ut_utils",  # peerdir only
    "//ydb/public/sdk/cpp/src/client/persqueue_public:include",
    "//ydb/public/sdk/cpp/src/client/query",
    "//ydb/public/sdk/cpp/src/client/topic/ut/ut_utils",  # peerdir only
    "//ydb/public/sdk/cpp/src/client/topic/ut/ut_utils:test_setup",
    "//ydb/services/persqueue_v1/actors/schema/pqv1",
  ]

  sources = [
    "//ydb/services/persqueue_v1/actors/schema/pqv1/alter_topic_sdk_ut.cpp",
    "//ydb/services/persqueue_v1/actors/schema/pqv1/create_topic_sdk_ut.cpp",
    "//ydb/services/persqueue_v1/actors/schema/pqv1/create_topic_ut.cpp",
    "//ydb/services/persqueue_v1/actors/schema/pqv1/describe_topic_sdk_ut.cpp",
    "//ydb/services/persqueue_v1/actors/schema/pqv1/pqv1_sdk_test_utils.cpp",
    "//ydb/services/persqueue_v1/actors/schema/pqv1/schema_ops_ut.cpp",
  ]

  include_dirs = [ "//ydb/services/persqueue_v1/actors/schema/pqv1" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
