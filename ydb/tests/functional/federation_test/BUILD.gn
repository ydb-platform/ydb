unittest_executable("federation_test") {
  deps = [
    "//contrib/libs/grpc",
    "//contrib/libs/librdkafka/src-cpp",  # peerdir only
    "//library/cpp/testing/unittest",
    "//ydb/public/sdk/cpp/src/client/driver",
    "//ydb/public/sdk/cpp/src/client/federated_topic",  # peerdir only
    "//ydb/public/sdk/cpp/src/client/table",
    "//ydb/public/sdk/cpp/src/client/topic",
    # "//ydb/tests/functional/kafka/test_common",  # no target
  ]

  data_deps = [ "//ydb/apps/ydbd" ]

  sources = [
    "//ydb/tests/functional/kafka/test_common/helpers.cpp",
    "cluster_write_close_test.cpp",
    "common_functions.cpp",
    "federation_tests.cpp",
    "kafka_compatibility_tests.cpp",
  ]

  test_depends_unbuilt = [
    "//ydb/public/tools/federation_discovery_recipe",
    "//ydb/public/tools/federation_discovery_recipe/bin",
    "//ydb/public/tools/federation_recipe",
    "//ydb/public/tools/federation_recipe/bin",
  ]

  link_select = [ "allocator=tcmalloc" ]
}
