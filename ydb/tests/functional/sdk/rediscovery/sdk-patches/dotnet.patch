+using Xunit;
+
+namespace Ydb.Sdk.Ado.Tests.Internal;
+
+public class LongPollCutoverTests
+{
+    [Fact]
+    public void RejectsMissingRegressingOrRepeatedGeneration()
+    {
+        var headers = new Grpc.Core.Metadata();
+        var trailers = new Grpc.Core.Metadata();
+        Assert.Null(Driver.Generation(null, headers, trailers));
+        Assert.Throws<InvalidDataException>(() => Driver.Generation(1, headers, trailers));
+        trailers.Add("x-ydb-route-generation", "18446744073709551615");
+        Assert.Equal(ulong.MaxValue, Driver.Generation(1, headers, trailers));
+        Assert.Equal(ulong.MaxValue, Driver.Generation(ulong.MaxValue, headers, trailers));
+        headers.Add("x-ydb-route-generation", "1");
+        Assert.Throws<InvalidDataException>(() => Driver.Generation(1, headers, trailers));
+        Assert.Throws<InvalidDataException>(() => Driver.Generation(2, headers, new Grpc.Core.Metadata()));
+    }
+}
