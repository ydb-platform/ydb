+using Grpc.Core;
+using Xunit;
+using GrpcStatusCode = Grpc.Core.StatusCode;
+
+namespace Ydb.Sdk.Ado.Tests.Internal;
+
+public class EdsCutoverTests
+{
+    [Theory]
+    [InlineData(GrpcStatusCode.Unavailable, "12", null, 12)]
+    [InlineData(GrpcStatusCode.Unavailable, null, null, null)]
+    [InlineData(GrpcStatusCode.Unavailable, "11", null, null)]
+    [InlineData(GrpcStatusCode.Unavailable, "10", null, null)]
+    [InlineData(GrpcStatusCode.Unavailable, "bad", null, null)]
+    [InlineData(GrpcStatusCode.Unavailable, "12", "13", null)]
+    [InlineData(GrpcStatusCode.Internal, "12", null, null)]
+    public void OnlyANewerUniqueStampOnUnavailableAllowsFloorOnlyRetry(
+        GrpcStatusCode status, string? first, string? second, int? expected)
+    {
+        var trailers = new Grpc.Core.Metadata();
+        if (first != null) { trailers.Add("x-ydb-route-generation", first); }
+        if (second != null) { trailers.Add("x-ydb-route-generation", second); }
+        var error = new RpcException(new Grpc.Core.Status(status, "closed"), trailers);
+        Assert.Equal((ulong?)expected, Driver.CutoverGeneration(11, error));
+        Assert.Null(Driver.CutoverGeneration(null, error));
+    }
+}
