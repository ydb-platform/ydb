diff --git a/src/Ydb.Sdk/src/Internal/Eds/EdsDiscovery.cs b/src/Ydb.Sdk/src/Internal/Eds/EdsDiscovery.cs
new file mode 100644
index 0000000000000000000000000000000000000000..bf13611d09fca41b1889f414c8716058fbca988e
--- /dev/null
+++ b/src/Ydb.Sdk/src/Internal/Eds/EdsDiscovery.cs
@@ -0,0 +1,235 @@
+using System.Globalization;
+using Google.Protobuf;
+using Grpc.Core;
+using Grpc.Net.Client;
+using Microsoft.Extensions.Logging;
+using Ydb.Discovery;
+using Ydb.Discovery.V1;
+using Ydb.Sdk.Ado;
+using Ydb.Sdk.Ado.Internal;
+using Ydb.Sdk.Internal;
+using Ydb.Sdk.Internal.Eds;
+using EndpointInfo = Ydb.Sdk.Pool.EndpointInfo;
+using GrpcMetadata = Grpc.Core.Metadata;
+
+namespace Ydb.Sdk;
+
+internal sealed partial class Driver
+{
+    private const string EdsType = "type.googleapis.com/envoy.config.endpoint.v3.ClusterLoadAssignment";
+    private const string GenerationHeader = "x-ydb-route-generation";
+    private const string ModeHeader = "x-ydb-route-mode";
+
+    private static readonly Method<DiscoveryRequest, DiscoveryResponse> StreamEndpoints = new(
+        MethodType.DuplexStreaming, "envoy.service.endpoint.v3.EndpointDiscoveryService", "StreamEndpoints",
+        Marshallers.Create(request => request.ToByteArray(), DiscoveryRequest.Parser.ParseFrom),
+        Marshallers.Create(response => response.ToByteArray(), DiscoveryResponse.Parser.ParseFrom));
+
+    private readonly CancellationTokenSource _watchStop = new();
+    private readonly TaskCompletionSource _firstSnapshot = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    private Task? _watch;
+    private ulong? _routeFloor;
+    private bool _requireCurrent;
+
+    private async Task StartEndpointWatch()
+    {
+        _watch = WatchEndpoints(_watchStop.Token);
+        try
+        {
+            await _firstSnapshot.Task.WaitAsync(Config.EndpointDiscoveryTimeout).ConfigureAwait(false);
+        }
+        catch
+        {
+            await StopEndpointWatch().ConfigureAwait(false);
+            throw;
+        }
+    }
+
+    private async ValueTask StopEndpointWatch()
+    {
+        if (_watch == null) { return; }
+        _watchStop.Cancel();
+        try { await _watch.ConfigureAwait(false); }
+        catch (OperationCanceledException) when (_watchStop.IsCancellationRequested) { }
+        catch (RpcException) when (_watchStop.IsCancellationRequested) { }
+        _watchStop.Dispose();
+    }
+
+    private async Task WatchEndpoints(CancellationToken stop)
+    {
+        using var bootstrap = GrpcChannelFactory.CreateChannel(Config.Endpoint);
+        var delayMs = 0;
+        while (!stop.IsCancellationRequested)
+        {
+            ulong? cutover = null;
+            try
+            {
+                using var attempt = CancellationTokenSource.CreateLinkedTokenSource(stop);
+                attempt.CancelAfter(Config.EndpointDiscoveryTimeout);
+                using var stream = bootstrap.CreateCallInvoker().AsyncDuplexStreamingCall(StreamEndpoints, null,
+                    await DiscoveryOptions(attempt.Token).ConfigureAwait(false));
+                var subscription = new DiscoveryRequest { TypeUrl = EdsType, ResourceNames = { Config.Database } };
+                var initial = new GrpcMetadata();
+                var received = false;
+                try
+                {
+                    await stream.RequestStream.WriteAsync(subscription).ConfigureAwait(false);
+                    initial = await stream.ResponseHeadersAsync.ConfigureAwait(false);
+                    await AcceptRoute(initial).ConfigureAwait(false);
+                    while (await stream.ResponseStream.MoveNext(attempt.Token).ConfigureAwait(false))
+                    {
+                        received = true;
+                        var message = stream.ResponseStream.Current;
+                        subscription.ResponseNonce = message.Nonce;
+                        try
+                        {
+                            var endpoints = Decode(message);
+                            await ApplyEndpoints(endpoints).ConfigureAwait(false);
+                        }
+                        catch (Exception error) when (error is InvalidDataException or InvalidProtocolBufferException)
+                        {
+                            subscription.ErrorDetail = new Internal.Eds.Status { Code = 3, Message = error.Message };
+                            await stream.RequestStream.WriteAsync(subscription).ConfigureAwait(false);
+                            await RetireRoute().ConfigureAwait(false);
+                            continue;
+                        }
+                        subscription.ErrorDetail = null;
+                        attempt.CancelAfter(Timeout.InfiniteTimeSpan);
+                        _requireCurrent = false;
+                        delayMs = 0;
+                        _firstSnapshot.TrySetResult();
+                        subscription.VersionInfo = message.VersionInfo;
+                        await stream.RequestStream.WriteAsync(subscription).ConfigureAwait(false);
+                    }
+                }
+                catch (RpcException error) when (!received && error.StatusCode == Grpc.Core.StatusCode.Unimplemented)
+                {
+                    // A trailers-only legacy server has no initial metadata. A managed
+                    // L7 can still have sent a newer generation before UNIMPLEMENTED.
+                    try { initial = await stream.ResponseHeadersAsync.ConfigureAwait(false); }
+                    catch (RpcException rpc) when (rpc.StatusCode == Grpc.Core.StatusCode.Unimplemented) { }
+                    await AcceptRoute(initial).ConfigureAwait(false);
+                    await LegacySnapshot(bootstrap, stop).ConfigureAwait(false);
+                    _firstSnapshot.TrySetResult();
+                    _requireCurrent = false;
+                    delayMs = 0;
+                    await Task.Delay(Config.EndpointDiscoveryInterval, stop).ConfigureAwait(false);
+                    continue;
+                }
+                catch (RpcException error)
+                {
+                    cutover = CutoverGeneration(_routeFloor, error);
+                    throw;
+                }
+            }
+            catch (Exception error) when (!stop.IsCancellationRequested)
+            {
+                Logger.LogWarning(error, "Endpoint discovery watch closed");
+            }
+            if (stop.IsCancellationRequested) { return; }
+
+            _requireCurrent = _routeFloor.HasValue && !cutover.HasValue;
+            _routeFloor = cutover ?? _routeFloor;
+            await RetireRoute().ConfigureAwait(false);
+            if (delayMs > 0)
+            {
+                await Task.Delay(Random.Shared.Next(delayMs / 2, delayMs + 1), stop).ConfigureAwait(false);
+            }
+            delayMs = Math.Min(2000, Math.Max(100, delayMs * 2));
+        }
+    }
+
+    private async Task LegacySnapshot(GrpcChannel bootstrap, CancellationToken stop)
+    {
+        var options = (await DiscoveryOptions(stop).ConfigureAwait(false)).WithDeadline(DateTime.UtcNow + Config.EndpointDiscoveryTimeout);
+        using var call = new DiscoveryService.DiscoveryServiceClient(bootstrap).ListEndpointsAsync(
+            new ListEndpointsRequest { Database = Config.Database }, options);
+        var reply = await call.ResponseAsync.ConfigureAwait(false);
+        await AcceptRoute(await call.ResponseHeadersAsync.ConfigureAwait(false)).ConfigureAwait(false);
+        if (reply.Operation.Status.IsNotSuccess())
+        {
+            throw YdbException.FromServer(reply.Operation.Status, reply.Operation.Issues);
+        }
+        await ApplyEndpoints(reply.Operation.Result.Unpack<ListEndpointsResult>()).ConfigureAwait(false);
+    }
+
+    private async ValueTask<CallOptions> DiscoveryOptions(CancellationToken stop)
+    {
+        var options = await GetCallOptions(new GrpcRequestSettings { CancellationToken = stop }, Config.EndpointInfo)
+            .ConfigureAwait(false);
+        var headers = options.Headers!;
+        headers.AppendObservabilityChain();
+        if (_routeFloor is { } floor)
+        {
+            headers.Add("x-ydb-min-route-generation", floor.ToString(CultureInfo.InvariantCulture));
+        }
+        if (_requireCurrent) { headers.Add("x-ydb-require-current-route", "1"); }
+        return options;
+    }
+
+    internal static ulong? CutoverGeneration(ulong? floor, RpcException error) =>
+        error.StatusCode == Grpc.Core.StatusCode.Unavailable && Generation(error.Trailers) is { } cut && cut > floor
+            ? cut : null;
+
+    private static ulong? Generation(GrpcMetadata headers)
+    {
+        var values = headers.GetAll(GenerationHeader).ToArray();
+        return values.Length == 1 && ulong.TryParse(values[0].Value, NumberStyles.None, CultureInfo.InvariantCulture, out var value)
+            ? value : null;
+    }
+
+    private async ValueTask AcceptRoute(GrpcMetadata headers)
+    {
+        if (!_routeFloor.HasValue && headers.Get(GenerationHeader) == null && headers.Get(ModeHeader) == null) { return; }
+        var modes = headers.GetAll(ModeHeader).ToArray();
+        if (Generation(headers) is not { } generation || generation < _routeFloor || modes.Length != 1 || modes[0].Value != "managed")
+        {
+            throw new InvalidDataException("Missing or stale discovery route metadata");
+        }
+        if (_routeFloor.HasValue && _routeFloor.Value != generation)
+        {
+            await RetireRoute().ConfigureAwait(false);
+        }
+        _routeFloor = generation;
+    }
+
+    private ListEndpointsResult Decode(DiscoveryResponse message)
+    {
+        if (message.VersionInfo == "" || message.Nonce == "" || message.TypeUrl != EdsType
+            || message.Resources.Count != 1 || message.Resources[0].TypeUrl != EdsType)
+        {
+            throw new InvalidDataException("Expected one versioned EDS assignment");
+        }
+        var assignment = ClusterLoadAssignment.Parser.ParseFrom(message.Resources[0].Value);
+        if (assignment.ClusterName != Config.Database || assignment.Endpoints.Count != 1)
+        {
+            throw new InvalidDataException("Unexpected EDS resource");
+        }
+        var group = assignment.Endpoints[0];
+        if (group.Metadata == null || !group.Metadata.TypedFilterMetadata.TryGetValue("ydb.discovery", out var metadata)
+            || !metadata.TryUnpack<ListEndpointsResult>(out var result) || result.Endpoints.Count != group.LbEndpoints.Count)
+        {
+            throw new InvalidDataException("Invalid YDB discovery metadata");
+        }
+        for (var i = 0; i < result.Endpoints.Count; ++i)
+        {
+            var socket = group.LbEndpoints[i].Endpoint?.Address?.SocketAddress;
+            var endpoint = result.Endpoints[i];
+            if (socket == null || socket.Protocol != 0 || socket.Address == "" || socket.Address != endpoint.Address
+                || socket.PortValue is 0 or > 65535 || socket.PortValue != endpoint.Port)
+            {
+                throw new InvalidDataException("Invalid EDS address");
+            }
+        }
+        return result;
+    }
+
+    private ValueTask RetireRoute()
+    {
+        lock (RouteLock)
+        {
+            Interlocked.Increment(ref RouteEpoch);
+            return ChannelPool.RemoveChannels(_endpointPool.Reset(Array.Empty<EndpointInfo>()));
+        }
+    }
+}
