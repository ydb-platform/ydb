+func TestResetSharedTransportOnRouteChange(t *testing.T) {
+	ctx := t.Context()
+	pool := NewPool(ctx, &mockConfig{})
+	t.Cleanup(func() { require.NoError(t, pool.RemoveRef(ctx)) })
+	ep := endpoint.New("node:2135")
+	c := pool.Get(ep).(*conn)
+	require.Same(t, c, pool.Get(ep))
+	c.grpcConn = &mockGrpcConn{}
+	valid := new(atomic.Bool)
+	valid.Store(true)
+	old := WithRouteValidity(ctx, valid)
+	_, err := c.realConn(old)
+	require.NoError(t, err)
+
+	valid.Store(false)
+	pool.ResetTransport(ctx, c)
+	pool.Put(ctx, c)
+	require.Nil(t, testConnGRPCConn(c))
+	_, err = c.realConn(old)
+	require.ErrorIs(t, err, errClosedConnection)
+
+	// The unaffected sibling keeps its wrapper and can use a fresh transport.
+	c.grpcConn = &mockGrpcConn{}
+	sibling, err := c.realConn(ctx)
+	require.NoError(t, err)
+	require.Same(t, c.grpcConn, sibling)
+}
