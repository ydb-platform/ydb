@@ -0,0 +1,38 @@
+package discovery
+
+import (
+	"fmt"
+
+	endpointv3 "github.com/envoyproxy/go-control-plane/envoy/config/endpoint/v3"
+	discoveryv3 "github.com/envoyproxy/go-control-plane/envoy/service/discovery/v3"
+	ydb "github.com/ydb-platform/ydb-go-genproto/protos/Ydb_Discovery"
+
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/discovery/config"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/endpoint"
+)
+
+const EDSResource = "type.googleapis.com/envoy.config.endpoint.v3.ClusterLoadAssignment"
+
+func DecodeEDS(r *discoveryv3.DiscoveryResponse, db string) (*ydb.ListEndpointsResult, error) {
+	var a endpointv3.ClusterLoadAssignment
+	if r.GetTypeUrl() != EDSResource || r.GetNonce() == "" || r.GetVersionInfo() == "" || len(r.GetResources()) != 1 || r.Resources[0].UnmarshalTo(&a) != nil || a.ClusterName != db || len(a.Endpoints) != 1 {
+		return nil, fmt.Errorf("invalid endpoint assignment for %q", db)
+	}
+	group := a.Endpoints[0]
+	attr := group.GetMetadata().GetTypedFilterMetadata()["ydb.discovery"]
+	result := new(ydb.ListEndpointsResult)
+	if attr == nil || attr.UnmarshalTo(result) != nil || len(result.Endpoints) != len(group.GetLbEndpoints()) {
+		return nil, fmt.Errorf("invalid YDB discovery metadata")
+	}
+	for i, ep := range result.Endpoints {
+		addr := group.LbEndpoints[i].GetEndpoint().GetAddress().GetSocketAddress()
+		if addr.GetProtocol() != 0 || ep.GetAddress() == "" || ep.GetPort() == 0 || ep.GetPort() > 65535 || addr.GetAddress() != ep.Address || addr.GetPortValue() != ep.Port {
+			return nil, fmt.Errorf("invalid socket address at index %d", i)
+		}
+	}
+	return result, nil
+}
+
+func FromEDS(result *ydb.ListEndpointsResult, cfg *config.Config) []endpoint.Endpoint {
+	return endpointsFromDiscovery(result, cfg)
+}
