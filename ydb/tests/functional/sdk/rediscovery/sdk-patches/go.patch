+// WithRouteValidity prevents a selection racing a cutover from reopening a
+// previously shared node transport after the balancer has reset it.
+func WithRouteValidity(ctx context.Context, valid *atomic.Bool) context.Context {
+	return context.WithValue(ctx, routeValidityKey{}, valid)
+}
