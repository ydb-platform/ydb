+package balancer
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/ydb-platform/ydb-go-sdk/v3/config"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+func TestEDSRouteFloorSurvivesRollbackAndMissingHeaders(t *testing.T) {
+	current := edsRoute{managed: true, generation: 11}
+	for _, md := range []metadata.MD{nil, metadata.Pairs("x-ydb-route-mode", "managed", "x-ydb-route-generation", "10"), metadata.Pairs("x-ydb-route-mode", "managed", "x-ydb-route-generation", "11", "x-ydb-route-generation", "12")} {
+		if got, err := routeGeneration(md, current); err == nil || got != current {
+			t.Fatalf("accepted ambiguous route %v: %+v %v", md, got, err)
+		}
+	}
+	zero, err := routeGeneration(metadata.Pairs("x-ydb-route-mode", "managed", "x-ydb-route-generation", "0"), edsRoute{})
+	if err != nil || !zero.managed {
+		t.Fatalf("missing generation zero: %v %v", zero, err)
+	}
+	if _, err := routeGeneration(nil, zero); err == nil {
+		t.Fatal("forgot managed route at generation zero")
+	}
+}
+
+func TestEDSRouteRetryHeaders(t *testing.T) {
+	b := &Balancer{driverConfig: config.New()}
+	headers := func(route edsRoute) metadata.MD {
+		ctx, err := b.discoveryEDSContext(context.Background(), route)
+		require.NoError(t, err)
+		md, _ := metadata.FromOutgoingContext(ctx)
+		return md
+	}
+	require.Empty(t, headers(edsRoute{}).Get("x-ydb-require-current-route"))
+	for _, test := range []struct {
+		code    codes.Code
+		stamp   []string
+		floor   string
+		current []string
+	}{
+		{codes.Unavailable, []string{"12"}, "12", nil},
+		{codes.Unavailable, nil, "11", []string{"1"}},
+		{codes.Unavailable, []string{"11"}, "11", []string{"1"}},
+		{codes.Unavailable, []string{"10"}, "11", []string{"1"}},
+		{codes.Unavailable, []string{"12", "13"}, "11", []string{"1"}},
+		{codes.Unavailable, []string{"bogus"}, "11", []string{"1"}},
+		{codes.Internal, []string{"12"}, "11", []string{"1"}},
+	} {
+		route := edsRoute{managed: true, generation: 11}
+		route.watchClosed(status.Error(test.code, "closed"), metadata.MD{"x-ydb-route-generation": test.stamp})
+		md := headers(route)
+		require.Equal(t, []string{test.floor}, md.Get("x-ydb-min-route-generation"))
+		require.Equal(t, test.current, md.Get("x-ydb-require-current-route"))
+	}
+}
diff --git a/internal/balancer/watched_conn.go b/internal/balancer/watched_conn.go
new file mode 100644
index 0000000000000000000000000000000000000000..4e58eb8653a13a65a2e31222089fa337a0c3720b
--- /dev/null
+++ b/internal/balancer/watched_conn.go
@@ -0,0 +1,95 @@
+package balancer
+
+import (
+	"context"
+	"sync"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/conn"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/endpoint"
+	"github.com/ydb-platform/ydb-go-sdk/v3/pkg/xslices"
+)
+
+type connectionPool interface {
+	Get(endpoint.Endpoint) conn.Conn
+	Put(context.Context, conn.Conn)
+	Ban(context.Context, conn.Conn, error)
+	RemoveRef(context.Context) error
+}
+
+// Routing and in-flight RPCs hold independent references on the same channel.
+type watchedPool struct {
+	*conn.Pool
+}
+
+// Each routing reference admits calls until discovery releases it. Each admitted
+// call then owns a reference to the underlying connection until it finishes.
+type watchedConn struct {
+	conn.Conn
+	pool     *conn.Pool
+	mu       sync.Mutex
+	released bool
+}
+
+func newWatchedPool(pool *conn.Pool) *watchedPool {
+	return &watchedPool{Pool: pool}
+}
+
+func (p *watchedPool) Get(e endpoint.Endpoint) conn.Conn {
+	cc := p.Pool.Get(e)
+	if cc == nil {
+		return nil
+	}
+	return &watchedConn{Conn: cc, pool: p.Pool}
+}
+
+func (p *watchedPool) Put(ctx context.Context, c conn.Conn) {
+	route := c.(*watchedConn)
+	route.mu.Lock()
+	route.released = true
+	route.mu.Unlock()
+	p.Pool.Put(ctx, route.Conn)
+}
+
+func (c *watchedConn) acquire() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return !c.released && c.pool.Get(c.Endpoint()) != nil
+}
+
+func (c *watchedConn) Invoke(ctx context.Context, method string, req, reply any, opts ...grpc.CallOption) error {
+	if !c.acquire() {
+		return status.Error(codes.Unavailable, "discovery removed endpoint")
+	}
+	defer c.pool.Put(ctx, c.Conn)
+	return c.Conn.Invoke(ctx, method, req, reply, opts...)
+}
+
+func (c *watchedConn) NewStream(ctx context.Context, desc *grpc.StreamDesc, method string, opts ...grpc.CallOption) (grpc.ClientStream, error) {
+	if !c.acquire() {
+		return nil, status.Error(codes.Unavailable, "discovery removed endpoint")
+	}
+	release := sync.OnceFunc(func() { c.pool.Put(ctx, c.Conn) })
+	stream, err := c.Conn.NewStream(ctx, desc, method, append(opts, grpc.OnFinish(func(error) { release() }))...)
+	if err != nil {
+		release()
+	}
+	return stream, err
+}
+
+func (p *watchedPool) releaseRemoved(ctx context.Context, quarantine []conn.Conn, endpoints []endpoint.Endpoint) []conn.Conn {
+	admitted := make(map[endpoint.Key]bool, len(endpoints))
+	for _, e := range endpoints {
+		admitted[e.Key()] = true
+	}
+	return xslices.Filter(quarantine, func(c conn.Conn) bool {
+		if admitted[c.Endpoint().Key()] {
+			return true
+		}
+		p.Put(ctx, c)
+		return false
+	})
+}
