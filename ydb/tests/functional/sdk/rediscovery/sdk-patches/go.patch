+package discovery
+
+import (
+	"testing"
+
+	corev3 "github.com/envoyproxy/go-control-plane/envoy/config/core/v3"
+	endpointv3 "github.com/envoyproxy/go-control-plane/envoy/config/endpoint/v3"
+	discoveryv3 "github.com/envoyproxy/go-control-plane/envoy/service/discovery/v3"
+	ydb "github.com/ydb-platform/ydb-go-genproto/protos/Ydb_Discovery"
+	"google.golang.org/protobuf/types/known/anypb"
+)
+
+func TestEDSSnapshot(t *testing.T) {
+	ydbResult, err := anypb.New(&ydb.ListEndpointsResult{SelfLocation: "dc1"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assignment, err := anypb.New(&endpointv3.ClusterLoadAssignment{ClusterName: "/db", Endpoints: []*endpointv3.LocalityLbEndpoints{{Metadata: &corev3.Metadata{TypedFilterMetadata: map[string]*anypb.Any{"ydb.discovery": ydbResult}}}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp := &discoveryv3.DiscoveryResponse{TypeUrl: EDSResource, VersionInfo: "a", Nonce: "1", Resources: []*anypb.Any{assignment}}
+	got, err := DecodeEDS(resp, "/db")
+	if err != nil || got.GetSelfLocation() != "dc1" {
+		t.Fatalf("decode: %v, %v", got, err)
+	}
+	if _, err := DecodeEDS(resp, "/other"); err == nil {
+		t.Fatal("accepted a different database")
+	}
+}
