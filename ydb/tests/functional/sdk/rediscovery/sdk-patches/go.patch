diff --git a/internal/balancer/long_poll.go b/internal/balancer/long_poll.go
new file mode 100644
index 0000000000000000000000000000000000000000..bc45d70e15bf96a08a2634ebbac69809e8a00c10
--- /dev/null
+++ b/internal/balancer/long_poll.go
@@ -0,0 +1,131 @@
+package balancer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math/rand/v2"
+	"strconv"
+	"time"
+
+	"github.com/ydb-platform/ydb-go-genproto/Ydb_Discovery_V1"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/metadata"
+
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/discovery"
+	"github.com/ydb-platform/ydb-go-sdk/v3/retry"
+)
+
+type pollRoute struct {
+	managed    bool
+	generation uint64
+}
+
+func routeGeneration(md metadata.MD, previous pollRoute) (pollRoute, error) {
+	values := md.Get("x-ydb-route-generation")
+	if len(values) == 0 && !previous.managed {
+		return previous, nil
+	}
+	if len(values) != 1 {
+		return previous, errors.New("missing or duplicate managed route generation")
+	}
+	g, err := strconv.ParseUint(values[0], 10, 64)
+	if err != nil || g < previous.generation {
+		return previous, fmt.Errorf("invalid or stale route generation %q", values[0])
+	}
+	return pollRoute{managed: true, generation: g}, nil
+}
+
+func (b *Balancer) startLongPoll(ctx context.Context) error {
+	pollCtx, cancel := context.WithCancel(context.WithoutCancel(ctx))
+	b.stopPoll, b.pollDone = cancel, make(chan struct{})
+	var route pollRoute
+	err := retry.Retry(ctx, func(ctx context.Context) error { return b.poll(ctx, &route) },
+		retry.WithIdempotent(true), retry.WithBudget(b.driverConfig.RetryBudget()), retry.WithTrace(b.driverConfig.TraceRetry()))
+	if err != nil {
+		cancel()
+		close(b.pollDone)
+		return err
+	}
+	go func() {
+		defer close(b.pollDone)
+		backoff := time.Duration(0)
+		for pollCtx.Err() == nil {
+			delay := backoff
+			if delay == 0 && !route.managed {
+				delay = b.discoveryConfig.Interval()
+			}
+			if delay > 0 {
+				select {
+				case <-pollCtx.Done():
+					return
+				case <-time.After(delay + rand.N(delay/4+1)):
+				}
+			}
+			if err := b.poll(pollCtx, &route); err != nil {
+				backoff = min(5*time.Second, max(100*time.Millisecond, 2*backoff))
+			} else {
+				backoff = 0
+			}
+		}
+	}()
+	return nil
+}
+
+func (b *Balancer) poll(ctx context.Context, route *pollRoute) error {
+	cc, err := b.discoveryConn(ctx)
+	if err != nil {
+		return err
+	}
+	ctx, err = b.driverConfig.Meta().DiscoveryContext(ctx)
+	if err != nil {
+		return err
+	}
+	ctx = metadata.AppendToOutgoingContext(ctx, "x-ydb-discovery-long-poll", "1")
+	timeout := b.driverConfig.DialTimeout()
+	if route.managed {
+		ctx = metadata.AppendToOutgoingContext(ctx, "x-ydb-if-route-generation", strconv.FormatUint(route.generation, 10))
+		timeout = max(timeout, 45*time.Second)
+	}
+	if timeout > 0 {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, timeout)
+		defer cancel()
+	}
+	var headers, trailers metadata.MD
+	endpoints, location, err := discovery.Discover(ctx, Ydb_Discovery_V1.NewDiscoveryServiceClient(cc), b.discoveryConfig, grpc.Header(&headers), grpc.Trailer(&trailers))
+	if err != nil {
+		return err
+	}
+	next, err := routeGeneration(metadata.Join(headers, trailers), *route)
+	if err != nil {
+		return err
+	}
+	if next != *route {
+		b.retireRoute(ctx)
+		*route = next
+	}
+	if b.policy.DetectsNearestDC() && len(endpoints) > 0 {
+		location, err = b.localDCDetector(ctx, endpoints)
+		if err != nil {
+			return err
+		}
+	}
+	b.applyDiscoveredEndpoints(ctx, endpoints, location)
+	return nil
+}
+
+// Revoke the entire previous assignment on a generation change, including
+// addresses that appear again after a coalesced switch and failback.
+func (b *Balancer) retireRoute(ctx context.Context) {
+	b.closeMu.Lock()
+	if b.closed {
+		b.closeMu.Unlock()
+		return
+	}
+	old := b.connectionsState.Swap(newConnectionsStateWithPriorities(nil, nil, nil, nil))
+	b.lastDiscovered = nil
+	b.closeMu.Unlock()
+	b.pool.(*watchedPool).invalidateMissing(ctx, nil)
+	b.releaseStateConns(ctx, old)
+}
