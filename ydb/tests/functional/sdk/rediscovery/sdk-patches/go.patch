+func (p *Pool) ResetTransport(ctx context.Context, c Conn) {
+	cc, ok := c.(*conn)
+	if !ok {
+		return
+	}
+	cc.mtx.Lock()
+	defer cc.mtx.Unlock()
+	_ = cc.close(ctx)
+}
