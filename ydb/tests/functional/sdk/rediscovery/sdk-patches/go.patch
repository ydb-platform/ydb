@@ -0,0 +1,64 @@
+package balancer
+
+import (
+	"context"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/health"
+	healthpb "google.golang.org/grpc/health/grpc_health_v1"
+
+	"github.com/ydb-platform/ydb-go-sdk/v3/config"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/conn"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/endpoint"
+)
+
+func TestCutoverDrainsSourceStream(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	node := func(state healthpb.HealthCheckResponse_ServingStatus) (endpoint.Endpoint, *health.Server, *atomic.Int64) {
+		listener, err := (&net.ListenConfig{}).Listen(ctx, "tcp", "127.0.0.1:0")
+		require.NoError(t, err)
+		sockets := new(atomic.Int64)
+		server := grpc.NewServer(grpc.StatsHandler(&serverConnStats{active: sockets}))
+		service := health.NewServer()
+		service.SetServingStatus("", state)
+		healthpb.RegisterHealthServer(server, service)
+		go func() { _ = server.Serve(listener) }()
+		t.Cleanup(server.Stop)
+		return endpoint.New(listener.Addr().String(), endpoint.WithID(1)), service, sockets
+	}
+	source, service, sockets := node(healthpb.HealthCheckResponse_SERVING)
+	destination, _, _ := node(healthpb.HealthCheckResponse_NOT_SERVING)
+	cfg := config.New(config.WithGrpcOptions(grpc.WithTransportCredentials(insecure.NewCredentials())))
+	pool := conn.NewPool(ctx, cfg)
+	defer func() { require.NoError(t, pool.RemoveRef(ctx)) }()
+	watched := newWatchedPool(pool)
+	watched.startManaged()
+	b := &Balancer{driverConfig: cfg, pool: watched}
+	b.applyDiscoveredEndpoints(ctx, []endpoint.Endpoint{source}, "")
+	client := healthpb.NewHealthClient(b)
+	streamCtx, stop := context.WithCancel(ctx)
+	defer stop()
+	stream, err := client.Watch(streamCtx, &healthpb.HealthCheckRequest{})
+	require.NoError(t, err)
+	first, err := stream.Recv()
+	require.NoError(t, err)
+	require.Equal(t, healthpb.HealthCheckResponse_SERVING, first.Status)
+	b.retireRoute(ctx)
+	b.applyDiscoveredEndpoints(ctx, []endpoint.Endpoint{destination}, "")
+	fresh, err := client.Check(ctx, &healthpb.HealthCheckRequest{})
+	require.NoError(t, err)
+	require.Equal(t, healthpb.HealthCheckResponse_NOT_SERVING, fresh.Status)
+	service.SetServingStatus("", healthpb.HealthCheckResponse_UNKNOWN)
+	held, err := stream.Recv()
+	require.NoError(t, err)
+	require.Equal(t, healthpb.HealthCheckResponse_UNKNOWN, held.Status)
+	stop()
+	require.Eventually(t, func() bool { return sockets.Load() == 0 }, 2*time.Second, time.Millisecond)
+}
