+// WithDiscoveryLongPoll waits for replica switches on the bootstrap channel.
+// Drivers use periodic discovery when the balancer omits the route generation.
+func WithDiscoveryLongPoll() Option {
+	return func(_ context.Context, d *Driver) error {
+		d.discoveryOptions = append(d.discoveryOptions, discoveryConfig.WithDiscoveryLongPoll())
+		return nil
+	}
