diff --git a/internal/balancer/eds.go b/internal/balancer/eds.go
new file mode 100644
index 0000000000000000000000000000000000000000..68f3701c3d8022c7b6cb31bac3e80becc9b7025f
--- /dev/null
+++ b/internal/balancer/eds.go
@@ -0,0 +1,250 @@
+package balancer
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"math/rand/v2"
+	"strconv"
+	"sync"
+	"time"
+
+	corev3 "github.com/envoyproxy/go-control-plane/envoy/config/core/v3"
+	discoveryv3 "github.com/envoyproxy/go-control-plane/envoy/service/discovery/v3"
+	edsv3 "github.com/envoyproxy/go-control-plane/envoy/service/endpoint/v3"
+	"github.com/ydb-platform/ydb-go-genproto/Ydb_Discovery_V1"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/discovery"
+	rpcstatus "google.golang.org/genproto/googleapis/rpc/status"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+func (b *Balancer) startEDS(initCtx context.Context) error {
+	ctx, cancel := context.WithCancel(context.WithoutCancel(initCtx))
+	b.stopEDS, b.edsDone = cancel, make(chan struct{})
+	ready := make(chan error, 1)
+	go func() {
+		defer close(b.edsDone)
+		var once sync.Once
+		first := func(err error) { once.Do(func() { ready <- err }) }
+		var floor edsRoute
+		delay := time.Duration(0)
+		for ctx.Err() == nil {
+			if delay > 0 {
+				select {
+				case <-ctx.Done():
+					return
+				case <-time.After(delay + rand.N(delay/4+1)):
+				}
+			}
+			cc, err := b.discoveryConn(ctx)
+			assigned := false
+			if err == nil {
+				assigned, err = b.watchEDS(ctx, cc, &floor, func() { first(nil) })
+				if !assigned && status.Code(err) == codes.Unimplemented {
+					err = b.unaryEDS(ctx, cc, &floor)
+					floor.requireCurrent = floor.managed && err != nil
+					if err == nil {
+						first(nil)
+						delay = b.discoveryConfig.Interval()
+						continue
+					}
+				}
+			}
+			if ctx.Err() != nil {
+				return
+			}
+			if !assigned && err != nil {
+				switch status.Code(err) {
+				case codes.Unavailable, codes.DeadlineExceeded, codes.Internal, codes.ResourceExhausted:
+					// A transient bootstrap failure keeps discovery gated until recovery.
+				default:
+					first(err)
+				}
+			}
+			b.clearEDS(ctx)
+			if assigned {
+				delay = 0
+			} else if delay <= 0 {
+				delay = 100 * time.Millisecond
+			} else {
+				delay = min(5*time.Second, delay*2)
+			}
+		}
+	}()
+	select {
+	case <-initCtx.Done():
+		return initCtx.Err()
+	case err := <-ready:
+		return err
+	}
+}
+
+func (b *Balancer) clearEDS(ctx context.Context) {
+	b.closeMu.Lock()
+	if b.closed {
+		b.closeMu.Unlock()
+		return
+	}
+	old := b.connectionsState.Swap(newConnectionsStateWithPriorities(nil, nil, nil, nil))
+	b.lastDiscovered = nil
+	b.closeMu.Unlock()
+	b.releaseStateConns(ctx, old)
+}
+
+func (b *Balancer) discoveryEDSContext(ctx context.Context, floor edsRoute) (context.Context, error) {
+	ctx, err := b.driverConfig.Meta().DiscoveryContext(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if floor.requireCurrent {
+		ctx = metadata.AppendToOutgoingContext(ctx, "x-ydb-require-current-route", "1")
+	}
+	if floor.managed {
+		ctx = metadata.AppendToOutgoingContext(ctx, "x-ydb-min-route-generation", strconv.FormatUint(floor.generation, 10))
+	}
+	return ctx, nil
+}
+
+type edsRoute struct {
+	managed        bool
+	generation     uint64
+	requireCurrent bool
+}
+
+func (r *edsRoute) watchClosed(err error, trailers metadata.MD) {
+	r.requireCurrent = r.managed
+	values := trailers.Get("x-ydb-route-generation")
+	if !r.managed || status.Code(err) != codes.Unavailable || len(values) != 1 {
+		return
+	}
+	if cut, err := strconv.ParseUint(values[0], 10, 64); err == nil && cut > r.generation {
+		r.generation = cut
+		r.requireCurrent = false
+	}
+}
+
+func routeGeneration(md metadata.MD, floor edsRoute) (edsRoute, error) {
+	vals := md.Get("x-ydb-route-generation")
+	mode := md.Get("x-ydb-route-mode")
+	if len(vals) == 0 && len(mode) == 0 && !floor.managed {
+		return floor, nil
+	}
+	if len(vals) != 1 || len(mode) != 1 || mode[0] != "managed" {
+		return floor, fmt.Errorf("missing managed discovery generation")
+	}
+	g, err := strconv.ParseUint(vals[0], 10, 64)
+	if err != nil || g < floor.generation {
+		return floor, fmt.Errorf("invalid or stale discovery route generation")
+	}
+	floor.managed = true
+	floor.generation = g
+	return floor, nil
+}
+
+func (b *Balancer) watchEDS(ctx context.Context, cc *grpc.ClientConn, floor *edsRoute, ready func()) (assigned bool, err error) {
+	var trailers metadata.MD
+	defer func() {
+		if assigned || status.Code(err) != codes.Unimplemented {
+			floor.watchClosed(err, trailers)
+		}
+	}()
+	ctx, err = b.discoveryEDSContext(ctx, *floor)
+	if err != nil {
+		return false, err
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	var handshake *time.Timer
+	if timeout := b.driverConfig.DialTimeout(); timeout > 0 {
+		handshake = time.AfterFunc(timeout, cancel)
+		defer handshake.Stop()
+	}
+	stream, err := edsv3.NewEndpointDiscoveryServiceClient(cc).StreamEndpoints(ctx)
+	if err != nil {
+		return false, err
+	}
+	req := &discoveryv3.DiscoveryRequest{Node: &corev3.Node{Id: "ydb-go-sdk"}, TypeUrl: discovery.EDSResource, ResourceNames: []string{b.driverConfig.Database()}}
+	if err = stream.Send(req); err != nil {
+		if err == io.EOF {
+			_, err = stream.Recv()
+			trailers = stream.Trailer()
+		}
+		return false, err
+	}
+	md, _ := stream.Header()
+	generation, genErr := routeGeneration(md, *floor)
+	if genErr == nil {
+		*floor = generation
+	}
+	for {
+		r, err := stream.Recv()
+		if err != nil {
+			trailers = stream.Trailer()
+			return assigned, err
+		}
+		if genErr != nil {
+			return assigned, genErr
+		}
+		result, err := discovery.DecodeEDS(r, b.driverConfig.Database())
+		req.Node = nil
+		req.ResponseNonce = r.Nonce
+		req.ErrorDetail = nil
+		if err != nil {
+			req.ErrorDetail = &rpcstatus.Status{Code: int32(codes.InvalidArgument), Message: err.Error()}
+		} else {
+			eps := discovery.FromEDS(result, b.discoveryConfig)
+			location := result.SelfLocation
+			if b.policy.DetectsNearestDC() && len(eps) > 0 {
+				location, err = b.localDCDetector(ctx, eps)
+				if err != nil {
+					return assigned, err
+				}
+			}
+			if !assigned && handshake != nil && !handshake.Stop() {
+				return assigned, context.DeadlineExceeded
+			}
+			b.applyDiscoveredEndpoints(ctx, eps, location)
+			req.VersionInfo = r.VersionInfo
+			assigned = true
+			ready()
+		}
+		if err = stream.Send(req); err != nil {
+			if err == io.EOF {
+				_, err = stream.Recv()
+				trailers = stream.Trailer()
+			}
+			return assigned, err
+		}
+	}
+}
+
+func (b *Balancer) unaryEDS(ctx context.Context, cc *grpc.ClientConn, floor *edsRoute) error {
+	ctx, err := b.discoveryEDSContext(ctx, *floor)
+	if err != nil {
+		return err
+	}
+	if timeout := b.driverConfig.DialTimeout(); timeout > 0 {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, timeout)
+		defer cancel()
+	}
+	var md metadata.MD
+	eps, location, err := discovery.Discover(ctx, Ydb_Discovery_V1.NewDiscoveryServiceClient(cc), b.discoveryConfig, grpc.Header(&md))
+	if err != nil {
+		return err
+	}
+	if *floor, err = routeGeneration(md, *floor); err != nil {
+		return err
+	}
+	if b.policy.DetectsNearestDC() && len(eps) > 0 {
+		location, err = b.localDCDetector(ctx, eps)
+		if err != nil {
+			return err
+		}
+	}
+	b.applyDiscoveredEndpoints(ctx, eps, location)
+	return nil
+}
