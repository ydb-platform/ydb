+++ b/internal/balancer/long_poll_connections_test.go
@@ -0,0 +1,89 @@
+package balancer
+
+import (
+	"context"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/health"
+	healthpb "google.golang.org/grpc/health/grpc_health_v1"
+	"google.golang.org/grpc/status"
+
+	"github.com/ydb-platform/ydb-go-sdk/v3/config"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/conn"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/endpoint"
+)
+
+func TestLongPollRetiresSharedRoutesAndClosesLastDataTransport(t *testing.T) {
+	ctx, cancel := context.WithTimeout(conn.WithoutWrapping(t.Context()), 5*time.Second)
+	defer cancel()
+	listener, err := (&net.ListenConfig{}).Listen(ctx, "tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	var sockets atomic.Int64
+	server := grpc.NewServer(grpc.StatsHandler(&serverConnStats{active: &sockets}))
+	healthServer := health.NewServer()
+	healthpb.RegisterHealthServer(server, healthServer)
+	go func() { _ = server.Serve(listener) }()
+	t.Cleanup(server.Stop)
+
+	cfg := config.New(config.WithGrpcOptions(grpc.WithTransportCredentials(insecure.NewCredentials())))
+	pool := conn.NewPool(ctx, cfg)
+	defer func() { _ = pool.RemoveRef(ctx) }()
+	nodes := []endpoint.Endpoint{endpoint.New(listener.Addr().String(), endpoint.WithID(1))}
+	watch := func() (*Balancer, healthpb.Health_WatchClient, context.CancelFunc) {
+		b := &Balancer{driverConfig: cfg, pool: newWatchedPool(pool)}
+		b.applyDiscoveredEndpoints(ctx, nodes, "")
+		streamCtx, stop := context.WithCancel(ctx)
+		t.Cleanup(stop)
+		s, err := healthpb.NewHealthClient(b).Watch(streamCtx, &healthpb.HealthCheckRequest{})
+		require.NoError(t, err)
+		_, err = s.Recv()
+		require.NoError(t, err)
+		return b, s, stop
+	}
+	parent, parentStream, _ := watch()
+	old := parent.connections().All()[0]
+	held := parent.pool.Get(nodes[0]) // concurrent pinned selection
+	child, childStream, stopChild := watch()
+	require.EqualValues(t, 1, sockets.Load())
+	parent.applyDiscoveredEndpoints(ctx, nodes, "")
+	parent.retireRoute(ctx)
+	// A live child stream still owns the shared TCP connection.
+	healthServer.SetServingStatus("", healthpb.HealthCheckResponse_NOT_SERVING)
+	_, err = parentStream.Recv()
+	require.Error(t, err)
+	reply, err := childStream.Recv()
+	require.NoError(t, err)
+	require.Equal(t, healthpb.HealthCheckResponse_NOT_SERVING, reply.Status)
+	require.EqualValues(t, 1, sockets.Load())
+
+	// Re-admitting the same pooled socket creates a fresh route. Previously
+	// retained handles cannot start another RPC, including after failback.
+	parent.applyDiscoveredEndpoints(ctx, nodes, "")
+	parent.pool.Put(ctx, held)
+	_, err = healthpb.NewHealthClient(old).Check(ctx, &healthpb.HealthCheckRequest{})
+	require.Equal(t, codes.Unavailable, status.Code(err))
+	_, err = healthpb.NewHealthClient(parent).Check(ctx, &healthpb.HealthCheckRequest{})
+	require.NoError(t, err)
+	parent.retireRoute(ctx)
+
+	// The sibling still owns a pool reference. As soon as its in-flight RPC
+	// ends, the shared old socket closes. Its next call lazily reconnects.
+	stopChild()
+	require.Eventually(t, func() bool { return sockets.Load() == 0 }, 2*time.Second, time.Millisecond)
+	_, err = healthpb.NewHealthClient(child).Check(ctx, &healthpb.HealthCheckRequest{})
+	require.NoError(t, err)
+	require.EqualValues(t, 1, sockets.Load())
+
+	// A removal within a live watch must retire the last transport immediately.
+	child.applyDiscoveredEndpoints(ctx, nil, "")
+	require.Eventually(t, func() bool { return sockets.Load() == 0 }, 2*time.Second, time.Millisecond)
+	_, err = childStream.Recv()
+	require.Error(t, err)
+}
