@@ -0,0 +1,79 @@
+package balancer
+
+import (
+	"context"
+	"github.com/ydb-platform/ydb-go-sdk/v3/config"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/conn"
+	discoveryConfig "github.com/ydb-platform/ydb-go-sdk/v3/internal/discovery/config"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/metadata"
+)
+
+func TestLongPollRequiresMonotonicGeneration(t *testing.T) {
+	floor := pollRoute{managed: true, generation: 11}
+	for _, value := range []string{"10", "18446744073709551616", "-1", "+1", ""} {
+		_, err := routeGeneration(metadata.Pairs("x-ydb-route-generation", value), floor)
+		require.Error(t, err)
+	}
+	_, err := routeGeneration(nil, floor)
+	require.Error(t, err)
+	_, err = routeGeneration(metadata.Pairs("x-ydb-route-generation", "12", "x-ydb-route-generation", "12"), floor)
+	require.Error(t, err)
+	next, err := routeGeneration(metadata.Pairs("x-ydb-route-generation", "12"), floor)
+	require.NoError(t, err)
+	require.Equal(t, uint64(12), next.generation)
+	legacy, err := routeGeneration(nil, pollRoute{})
+	require.NoError(t, err)
+	require.False(t, legacy.managed)
+}
+
+func TestManagedRollbackRetiresHealthyDataNode(t *testing.T) {
+	loseCapability := make(chan struct{})
+	var restore atomic.Bool
+	intercept := func(ctx context.Context, request any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		if strings.HasSuffix(info.FullMethod, "/ListEndpoints") {
+			md, _ := metadata.FromIncomingContext(ctx)
+			known := md.Get("x-ydb-if-route-generation")
+			if len(known) == 0 {
+				_ = grpc.SetTrailer(ctx, metadata.Pairs("x-ydb-route-generation", "1"))
+			} else {
+				select {
+				case <-ctx.Done():
+					return nil, ctx.Err()
+				case <-loseCapability:
+				}
+				if restore.Load() {
+					if known[0] == "2" {
+						<-ctx.Done()
+						return nil, ctx.Err()
+					}
+					_ = grpc.SetTrailer(ctx, metadata.Pairs("x-ydb-route-generation", "2"))
+				}
+			}
+		}
+		return handler(ctx, request)
+	}
+	server := startDynamicDiscoveryServer(t, []uint32{1}, grpc.UnaryInterceptor(intercept))
+	ctx := t.Context()
+	cfg := config.New(config.WithEndpoint(server.endpoint()), config.WithDatabase("/local"),
+		config.WithGrpcOptions(grpc.WithTransportCredentials(insecure.NewCredentials())))
+	pool := conn.NewPool(ctx, cfg)
+	defer func() { require.NoError(t, pool.RemoveRef(ctx)) }()
+	b, err := New(ctx, cfg, pool, discoveryConfig.WithDiscoveryLongPoll())
+	require.NoError(t, err)
+	defer func() { require.NoError(t, b.Close(ctx)) }()
+	dialWhoAmI(t, b, 1)
+	require.EqualValues(t, 2, server.activeGRPCConns())
+	close(loseCapability)
+	require.Eventually(t, func() bool { return len(activeNodeIDs(b)) == 0 && server.activeGRPCConns() == 1 }, 3*time.Second, time.Millisecond)
+	restore.Store(true)
+	require.Eventually(t, func() bool { return len(activeNodeIDs(b)) == 1 }, 3*time.Second, time.Millisecond)
+	dialWhoAmI(t, b, 1)
+}
diff --git a/internal/balancer/watched_conn.go b/internal/balancer/watched_conn.go
new file mode 100644
index 0000000000000000000000000000000000000000..35ccac61fa5f65a97695142bfc94cb2c9235ee2e
--- /dev/null
+++ b/internal/balancer/watched_conn.go
@@ -0,0 +1,138 @@
+package balancer
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/conn"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/endpoint"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/xerrors"
+	"github.com/ydb-platform/ydb-go-sdk/v3/pkg/xslices"
+)
+
+type connectionPool interface {
+	Get(endpoint.Endpoint) conn.Conn
+	Put(context.Context, conn.Conn)
+	Ban(context.Context, conn.Conn, error)
+	RemoveRef(context.Context) error
+}
+
+// Routing and in-flight RPCs hold independent references on the same channel.
+type watchedPool struct {
+	scope  atomic.Pointer[conn.RouteScope]
+	closed context.Context
+	stop   context.CancelFunc
+	*conn.Pool
+	managed atomic.Bool
+}
+
+// Each routing reference admits calls until discovery releases it. Each admitted
+// call then owns a reference to the underlying connection until it finishes.
+type watchedConn struct {
+	conn.Conn
+	pool     *watchedPool
+	scope    *conn.RouteScope
+	mu       sync.Mutex
+	released bool
+}
+
+func newWatchedPool(pool *conn.Pool) *watchedPool {
+	closed, stop := context.WithCancel(context.Background())
+	return &watchedPool{Pool: pool, closed: closed, stop: stop}
+}
+
+func (p *watchedPool) Get(e endpoint.Endpoint) conn.Conn {
+	scope := p.scope.Load()
+	cc := p.Pool.GetScoped(e, scope)
+	if cc == nil {
+		return nil
+	}
+	return &watchedConn{Conn: cc, pool: p, scope: scope}
+}
+
+func (p *watchedPool) Put(ctx context.Context, c conn.Conn) {
+	route := c.(*watchedConn)
+	route.mu.Lock()
+	route.released = true
+	route.mu.Unlock()
+	p.Pool.Put(ctx, route.Conn)
+}
+
+func (c *watchedConn) acquire() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return !c.released && c.pool.closed.Err() == nil && c.pool.scope.Load() == c.scope && c.pool.GetScoped(c.Endpoint(), c.scope) != nil
+}
+
+// A rejected local selection never sent the request and can always be retried.
+func removedEndpoint(ctx context.Context) error {
+	err := status.Error(codes.Unavailable, "discovery removed endpoint")
+	if conn.UseWrapping(ctx) {
+		return xerrors.Retryable(xerrors.Transport(err))
+	}
+	return err
+}
+
+func (c *watchedConn) Ban(ctx context.Context) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.released && c.pool.scope.Load() == c.scope {
+		c.Conn.Ban(ctx)
+	}
+}
+
+func (c *watchedConn) Invoke(ctx context.Context, method string, req, reply any, opts ...grpc.CallOption) error {
+	if !c.acquire() {
+		return removedEndpoint(ctx)
+	}
+	defer c.pool.Pool.Put(ctx, c.Conn)
+	ctx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(c.pool.closed, cancel)
+	defer func() { stop(); cancel() }()
+	return c.Conn.Invoke(ctx, method, req, reply, opts...)
+}
+
+func (c *watchedConn) NewStream(ctx context.Context, desc *grpc.StreamDesc, method string, opts ...grpc.CallOption) (grpc.ClientStream, error) {
+	if !c.acquire() {
+		return nil, removedEndpoint(ctx)
+	}
+	release := sync.OnceFunc(func() { c.pool.Pool.Put(ctx, c.Conn) })
+	stream, err := c.Conn.NewStream(conn.WithStreamShutdown(ctx, c.pool.closed), desc, method, append(opts, grpc.OnFinish(func(error) { release() }))...)
+	if err != nil {
+		release()
+	}
+	return stream, err
+}
+
+func (p *watchedPool) releaseRemoved(ctx context.Context, quarantine []conn.Conn, endpoints []endpoint.Endpoint) []conn.Conn {
+	if !p.managed.Load() {
+		return quarantine
+	}
+	admitted := make(map[endpoint.Key]bool, len(endpoints))
+	for _, e := range endpoints {
+		admitted[e.Key()] = true
+	}
+	return xslices.Filter(quarantine, func(c conn.Conn) bool {
+		if admitted[c.Endpoint().Key()] {
+			return true
+		}
+		p.Put(ctx, c)
+		return false
+	})
+}
+
+func (p *watchedPool) startManaged() { p.managed.Store(true) }
+
+// Drivers entering the same managed route may share a channel. A driver entering
+// a newer generation must never borrow a live socket from the previous one.
+func (b *Balancer) enroll(generation uint64) {
+	p := b.pool.(*watchedPool)
+	if p.scope.Load() == nil {
+		p.scope.CompareAndSwap(nil, &conn.RouteScope{Bootstrap: b.driverConfig.Endpoint(), Database: b.driverConfig.Database(), Generation: generation})
+	}
