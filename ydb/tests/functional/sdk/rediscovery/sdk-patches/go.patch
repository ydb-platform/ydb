+++ b/internal/balancer/long_poll_test.go
@@ -0,0 +1,26 @@
+package balancer
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/metadata"
+)
+
+func TestLongPollRequiresMonotonicGeneration(t *testing.T) {
+	floor := pollRoute{managed: true, generation: 11}
+	for _, value := range []string{"10", "18446744073709551616", "-1", "+1", ""} {
+		_, err := routeGeneration(metadata.Pairs("x-ydb-route-generation", value), floor)
+		require.Error(t, err)
+	}
+	_, err := routeGeneration(nil, floor)
+	require.Error(t, err)
+	_, err = routeGeneration(metadata.Pairs("x-ydb-route-generation", "12", "x-ydb-route-generation", "12"), floor)
+	require.Error(t, err)
+	next, err := routeGeneration(metadata.Pairs("x-ydb-route-generation", "12"), floor)
+	require.NoError(t, err)
+	require.Equal(t, uint64(12), next.generation)
+	legacy, err := routeGeneration(nil, pollRoute{})
+	require.NoError(t, err)
+	require.False(t, legacy.managed)
+}
diff --git a/internal/balancer/watched_conn.go b/internal/balancer/watched_conn.go
new file mode 100644
index 0000000000000000000000000000000000000000..c8f83c6500ad815e54ab9bb3438e6bd18668c56c
--- /dev/null
+++ b/internal/balancer/watched_conn.go
@@ -0,0 +1,195 @@
+package balancer
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/conn"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/endpoint"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/xcontext"
+	"github.com/ydb-platform/ydb-go-sdk/v3/internal/xerrors"
+	"github.com/ydb-platform/ydb-go-sdk/v3/pkg/xslices"
+)
+
+// Each balancer owns the RPC lifetime for its assignment. Driver.With can
+// share the underlying pool (and TCP connection) across independent databases.
+type watchedConn struct {
+	conn.Conn
+	calls   *xcontext.CancelsGuard
+	retired atomic.Bool
+	refs    int // guarded by watchedPool.mu
+}
+
+func watchConn(c conn.Conn) *watchedConn {
+	return &watchedConn{Conn: c, calls: xcontext.NewCancelsGuard()}
+}
+
+func (p *watchedPool) retire(ctx context.Context, c *watchedConn) {
+	c.retired.Store(true)
+	c.calls.Cancel()
+	p.Pool.CloseTransportWhenIdle(ctx, c.Conn)
+}
+
+var errRouteRetired = status.Error(codes.Unavailable, "discovery retired the data endpoint")
+
+func retirementError(ctx context.Context) error {
+	if conn.UseWrapping(ctx) {
+		return xerrors.Transport(errRouteRetired)
+	}
+	return errRouteRetired
+}
+
+func (c *watchedConn) routeError(ctx context.Context, err error) error {
+	if err != nil && c.retired.Load() &&
+		(xerrors.Is(err, context.Canceled) || status.Code(err) == codes.Canceled || xerrors.IsTransportError(err, codes.Canceled)) {
+		return retirementError(ctx)
+	}
+	return err
+}
+
+func (c *watchedConn) callContext(ctx context.Context) (context.Context, func(), error) {
+	ctx, cancel := c.calls.WithCancel(ctx)
+	if c.retired.Load() {
+		cancel()
+		return nil, nil, retirementError(ctx)
+	}
+	return ctx, cancel, nil
+}
+
+func (c *watchedConn) Invoke(ctx context.Context, method string, req, reply any, opts ...grpc.CallOption) error {
+	ctx, done, err := c.callContext(ctx)
+	if err != nil {
+		return err
+	}
+	defer done()
+	return c.routeError(ctx, c.Conn.Invoke(ctx, method, req, reply, opts...))
+}
+
+func (c *watchedConn) NewStream(ctx context.Context, desc *grpc.StreamDesc, method string, opts ...grpc.CallOption) (grpc.ClientStream, error) {
+	ctx, done, err := c.callContext(ctx)
+	if err != nil {
+		return nil, err
+	}
+	stream, err := c.Conn.NewStream(ctx, desc, method, append(opts, grpc.OnFinish(func(error) { done() }))...)
+	if err != nil {
+		done()
+		return nil, c.routeError(ctx, err)
+	}
+	return &watchedStream{ClientStream: stream, conn: c, ctx: ctx}, nil
+}
+
+func (c *watchedConn) Ban(ctx context.Context) {
+	if !c.retired.Load() {
+		c.Conn.Ban(ctx)
+	}
+}
+
+type watchedStream struct {
+	grpc.ClientStream
+	conn *watchedConn
+	ctx  context.Context
+}
+
+func (s *watchedStream) SendMsg(m any) error {
+	if s.conn.retired.Load() {
+		return retirementError(s.ctx)
+	}
+	return s.conn.routeError(s.ctx, s.ClientStream.SendMsg(m))
+}
+
+func (s *watchedStream) RecvMsg(m any) error {
+	if s.conn.retired.Load() {
+		return retirementError(s.ctx)
+	}
+	return s.conn.routeError(s.ctx, s.ClientStream.RecvMsg(m))
+}
+
+type connectionPool interface {
+	Get(endpoint.Endpoint) conn.Conn
+	Put(context.Context, conn.Conn)
+	Ban(context.Context, conn.Conn, error)
+	RemoveRef(context.Context) error
+}
+
+// Track which calls belong to this balancer even if other balancers use the
+// same physical connection. The last pool reference closes its gRPC transport.
+type watchedPool struct {
+	*conn.Pool
+	mu     sync.Mutex
+	routes map[endpoint.Key]*watchedConn
+}
+
+func newWatchedPool(pool *conn.Pool) *watchedPool {
+	return &watchedPool{Pool: pool, routes: make(map[endpoint.Key]*watchedConn)}
+}
+
+func (p *watchedPool) Get(e endpoint.Endpoint) conn.Conn {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	c := p.Pool.Get(e)
+	if c == nil {
+		return nil
+	}
+	key := e.Key()
+	route := p.routes[key]
+	if route == nil {
+		route = watchConn(c)
+		p.routes[key] = route
+	}
+	route.refs++
+	return route
+}
+
+func (p *watchedPool) Put(ctx context.Context, c conn.Conn) {
+	route := c.(*watchedConn)
+	p.mu.Lock()
+	route.refs--
+	key := route.Endpoint().Key()
+	last := route.refs == 0 && p.routes[key] == route
+	if last {
+		delete(p.routes, key)
+	}
+	p.mu.Unlock()
+
+	if last {
+		p.retire(ctx, route)
+	}
+	p.Pool.Put(ctx, route.Conn)
+}
+
+// A pinned selection can still hold a temporary reference when an assignment
+// is removed. Invalidate the old route before the new generation is visible.
+func (p *watchedPool) invalidateMissing(ctx context.Context, admitted map[endpoint.Key]bool) {
+	p.mu.Lock()
+	var removed []*watchedConn
+	for key, route := range p.routes {
+		if !admitted[key] {
+			delete(p.routes, key)
+			removed = append(removed, route)
+		}
+	}
+	p.mu.Unlock()
+	for _, route := range removed {
+		p.retire(ctx, route)
+	}
+}
+
+func (p *watchedPool) releaseRemoved(ctx context.Context, quarantine []conn.Conn, endpoints []endpoint.Endpoint) []conn.Conn {
+	admitted := make(map[endpoint.Key]bool, len(endpoints))
+	for _, e := range endpoints {
+		admitted[e.Key()] = true
+	}
+	p.invalidateMissing(ctx, admitted)
+	return xslices.Filter(quarantine, func(c conn.Conn) bool {
+		if admitted[c.Endpoint().Key()] {
+			return true
+		}
+		p.Put(ctx, c)
+		return false
+	})
+}
