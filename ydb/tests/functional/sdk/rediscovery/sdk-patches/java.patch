+public class EdsDiscoveryTest {
+    @Test
+    public void requiresTheRequestedClusterAndMatchingEndpoints() throws Exception {
+        String database = "/Root/test";
+        ClusterLoadAssignment.Builder assignment = ClusterLoadAssignment.newBuilder().setClusterName(database);
+        LocalityLbEndpoints.Builder group = assignment.addEndpointsBuilder();
+        ListEndpointsResult endpoints = ListEndpointsResult.newBuilder().addEndpoints(
+                EndpointInfo.newBuilder().setAddress("node").setPort(2135).setNodeId(42).setLocation("dc")).build();
+        group.getMetadataBuilder().putTypedFilterMetadata("ydb.discovery", Any.pack(endpoints));
+        group.addLbEndpointsBuilder().getEndpointBuilder().getAddressBuilder().getSocketAddressBuilder()
+                .setAddress("node").setPortValue(2135);
+
+        Assert.assertEquals(endpoints, EdsDiscovery.decode(database, response(assignment)));
+        Assert.assertThrows(IllegalArgumentException.class, () -> EdsDiscovery.decode("/Root/other",
+                response(assignment)));
+
+        group.getLbEndpointsBuilder(0).getEndpointBuilder().getAddressBuilder().getSocketAddressBuilder()
+                .setPortValue(2136);
+        Assert.assertThrows(IllegalArgumentException.class, () -> EdsDiscovery.decode(database, response(assignment)));
+    }
+
+    @Test
+    public void longLivedWatchDoesNotInheritTheReadDeadline() {
+        MockedScheduler scheduler = new MockedScheduler(MockedClock.create(ZoneOffset.UTC));
+        ManagedChannel channel = Mockito.mock(ManagedChannel.class);
+        AuthCallOptions auth = Mockito.mock(AuthCallOptions.class);
+        Mockito.when(auth.getGrpcCallOptions()).thenReturn(CallOptions.DEFAULT.withDeadlineAfter(2, TimeUnit.SECONDS));
+        Mockito.when(channel.newCall(Mockito.eq(EndpointDiscoveryServiceGrpc.getStreamEndpointsMethod()), Mockito.any()))
+                .thenReturn(MockedCall.neverAnswer());
+        FixedCallOptionsTransport transport = new FixedCallOptionsTransport(scheduler, auth, "/Root/test", "test",
+                new EndpointRecord("localhost", 2135), (host, port, authority) -> channel);
+        EdsDiscovery discovery = new EdsDiscovery(transport, Mockito.mock(YdbDiscovery.class), Duration.ofSeconds(8));
+        discovery.start();
+        scheduler.runNextTask();
+
+        ArgumentCaptor<CallOptions> options = ArgumentCaptor.forClass(CallOptions.class);
+        Mockito.verify(channel).newCall(Mockito.eq(EndpointDiscoveryServiceGrpc.getStreamEndpointsMethod()),
+                options.capture());
+        Assert.assertNull(options.getValue().getDeadline());
+        scheduler.hasTasksCount(1); // The first response still has a timeout.
+    }
+
+    @Test
+    public void newAssignmentDrainsRemovedChannel() throws Exception {
+        ManagedChannel bootstrap = Mockito.mock(ManagedChannel.class);
+        ManagedChannel node = Mockito.mock(ManagedChannel.class);
+        CountDownLatch releaseStream = new CountDownLatch(1);
+        Mockito.when(node.awaitTermination(Mockito.anyLong(), Mockito.any())).thenAnswer(call ->
+                releaseStream.await(5, TimeUnit.SECONDS));
+        CompletableFuture<ClientCall.Listener<DiscoveryResponse>> listener = new CompletableFuture<>();
+        Mockito.when(bootstrap.newCall(Mockito.eq(EndpointDiscoveryServiceGrpc.getStreamEndpointsMethod()), Mockito.any()))
+                .thenReturn(new MockedCall<DiscoveryRequest, DiscoveryResponse>(Runnable::run) {
+                    @Override
+                    protected void complete(Listener<DiscoveryResponse> watch) {
+                        listener.complete(watch);
+                    }
+                });
+        try (GrpcTransport transport = GrpcTransport.forConnectionString("grpc://bootstrap:2135/test")
+                .withInitMode(GrpcTransportBuilder.InitMode.ASYNC)
+                .withEdsDiscovery()
+                .withChannelFactoryBuilder(builder -> (host, port, authority) ->
+                        "bootstrap".equals(host) ? bootstrap : node)
+                .build()) {
+            ClientCall.Listener<DiscoveryResponse> watch = listener.get(5, TimeUnit.SECONDS);
+            watch.onHeaders(new Metadata());
+            watch.onMessage(assignment("source"));
+            ((YdbTransportImpl) transport).getChannel(GrpcRequestSettings.newBuilder().build());
+            watch.onMessage(assignment("target"));
+            Mockito.verify(node).shutdown();
+            Mockito.verify(node, Mockito.never()).shutdownNow();
+            Mockito.verify(bootstrap, Mockito.never()).shutdownNow();
+        } finally {
+            releaseStream.countDown();
+        }
+    }
+
+    private static DiscoveryResponse assignment(String host) {
+        ClusterLoadAssignment.Builder assignment = ClusterLoadAssignment.newBuilder().setClusterName("/test");
+        LocalityLbEndpoints.Builder group = assignment.addEndpointsBuilder();
+        group.getMetadataBuilder().putTypedFilterMetadata("ydb.discovery", Any.pack(ListEndpointsResult.newBuilder()
+                .addEndpoints(EndpointInfo.newBuilder().setAddress(host).setPort(2135).setNodeId(1)).build()));
+        group.addLbEndpointsBuilder().getEndpointBuilder().getAddressBuilder().getSocketAddressBuilder()
+                .setAddress(host).setPortValue(2135);
+        return response(assignment).toBuilder().setNonce(host).setVersionInfo(host).build();
+    }
+
+    @Test
+    public void cutoverRequiresANewerUniqueGenerationOnUnavailable() {
+        Metadata.Key<String> generation = Metadata.Key.of("x-ydb-route-generation", Metadata.ASCII_STRING_MARSHALLER);
+        Metadata trailers = new Metadata();
+        Assert.assertNull(EdsDiscovery.cutoverGeneration(11L, Status.UNAVAILABLE, trailers));
+        trailers.put(generation, "11");
+        Assert.assertNull(EdsDiscovery.cutoverGeneration(11L, Status.UNAVAILABLE, trailers));
+        trailers.removeAll(generation);
+        trailers.put(generation, "12");
+        Assert.assertEquals(Long.valueOf(12), EdsDiscovery.cutoverGeneration(11L, Status.UNAVAILABLE, trailers));
+        Assert.assertNull(EdsDiscovery.cutoverGeneration(null, Status.UNAVAILABLE, trailers));
+        Assert.assertNull(EdsDiscovery.cutoverGeneration(11L, Status.INTERNAL, trailers));
+        trailers.put(generation, "13");
+        Assert.assertNull(EdsDiscovery.cutoverGeneration(11L, Status.UNAVAILABLE, trailers));
+    }
+
+    private static DiscoveryResponse response(ClusterLoadAssignment.Builder assignment) {
+        Any resource = Any.pack(assignment.build());
+        return DiscoveryResponse.newBuilder().addResources(resource).setTypeUrl(resource.getTypeUrl())
+                .setVersionInfo("v1").setNonce("n1").build();
+    }
+}
