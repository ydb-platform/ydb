@@ -0,0 +1,24 @@
+package tech.ydb.core.impl;
+
+import io.grpc.Metadata;
+import org.junit.Assert;
+import org.junit.Test;
+
+public class LongPollDiscoveryTest {
+    private static final Metadata.Key<String> GENERATION = Metadata.Key.of("x-ydb-route-generation",
+            Metadata.ASCII_STRING_MARSHALLER);
+
+    @Test
+    public void checkManagedLeaseAndLegacyFallback() {
+        Metadata headers = new Metadata();
+        Assert.assertNull(LongPollDiscovery.generation(null, headers));
+        Assert.assertThrows(IllegalArgumentException.class, () -> LongPollDiscovery.generation(1L, headers));
+        headers.put(GENERATION, "18446744073709551615");
+        Assert.assertEquals(Long.valueOf(-1), LongPollDiscovery.generation(1L, headers));
+        headers.removeAll(GENERATION);
+        headers.put(GENERATION, "1");
+        Assert.assertThrows(IllegalArgumentException.class, () -> LongPollDiscovery.generation(-1L, headers));
+        headers.put(GENERATION, "2");
+        Assert.assertThrows(IllegalArgumentException.class, () -> LongPollDiscovery.generation(null, headers));
+    }
+}
