+package tech.ydb.core.impl;
+
+import java.time.Duration;
+import java.util.concurrent.Future;
+import java.util.concurrent.ThreadLocalRandom;
+import java.util.concurrent.TimeUnit;
+
+import com.google.protobuf.InvalidProtocolBufferException;
+import io.grpc.CallOptions;
+import io.grpc.ClientCall;
+import io.grpc.Metadata;
+import io.grpc.Status;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import tech.ydb.core.grpc.GrpcRequestSettings;
+import tech.ydb.proto.StatusCodesProtos.StatusIds;
+import tech.ydb.proto.discovery.DiscoveryProtos.ListEndpointsRequest;
+import tech.ydb.proto.discovery.DiscoveryProtos.ListEndpointsResponse;
+import tech.ydb.proto.discovery.DiscoveryProtos.ListEndpointsResult;
+import tech.ydb.proto.discovery.v1.DiscoveryServiceGrpc;
+
+/** Long-poll the authenticated discovery endpoint on one retained bootstrap transport. */
+final class LongPollDiscovery implements AutoCloseable {
+    private static final Logger LOG = LoggerFactory.getLogger(LongPollDiscovery.class);
+    private static final Metadata.Key<String> GENERATION = key("x-ydb-route-generation");
+    private static final Metadata.Key<String> POLL = key("x-ydb-discovery-long-poll");
+    private static final Metadata.Key<String> SINCE = key("x-ydb-if-route-generation");
+    private static final GrpcRequestSettings SETTINGS = GrpcRequestSettings.newBuilder().build();
+
+    private final FixedCallOptionsTransport bootstrap;
+    private final YdbDiscovery discovery;
+    private final Duration timeout;
+    private final String database;
+    private Long floor;
+    private boolean closed;
+    private int delayMs;
+    private ClientCall<?, ?> active;
+    private Future<?> scheduled;
+
+    LongPollDiscovery(FixedCallOptionsTransport transport, YdbDiscovery discovery, Duration timeout) {
+        this.bootstrap = transport;
+        this.discovery = discovery;
+        this.timeout = timeout;
+        this.database = transport.getDatabase();
+    }
+
+    private static Metadata.Key<String> key(String name) {
+        return Metadata.Key.of(name, Metadata.ASCII_STRING_MARSHALLER);
+    }
+
+    static Long generation(Long previous, Metadata headers) {
+        Iterable<String> all = headers.getAll(GENERATION);
+        if (all == null && previous == null) {
+            return null;
+        }
+        if (all != null) {
+            java.util.Iterator<String> values = all.iterator();
+            String value = values.next();
+            if (!values.hasNext() && value.matches("[0-9]{1,20}")) {
+                long current = Long.parseUnsignedLong(value);
+                if (previous == null || Long.compareUnsigned(current, previous) >= 0) {
+                    return current;
+                }
+            }
+        }
+        throw new IllegalArgumentException("Missing or stale discovery route generation");
+    }
+
+    private Metadata headers() {
+        Metadata headers = bootstrap.makeMetadataFromSettings(SETTINGS, bootstrap.serverEndpoint);
+        headers.put(POLL, "1");
+        if (floor != null) {
+            headers.put(SINCE, Long.toUnsignedString(floor));
+        }
+        return headers;
+    }
+
+    synchronized void start() {
+        schedule(this::poll, 0);
+    }
+
+    private void schedule(Runnable next, long millis) {
+        if (!closed) {
+            scheduled = bootstrap.getScheduler().schedule(() -> {
+                synchronized (LongPollDiscovery.this) {
+                    if (!closed) {
+                        try {
+                            next.run();
+                        } catch (RuntimeException e) {
+                            LOG.warn("Discovery attempt failed", e);
+                            if (active != null) {
+                                active.cancel("Discovery attempt failed", e);
+                                active = null;
+                            }
+                            retry();
+                        }
+                    }
+                }
+            }, millis, TimeUnit.MILLISECONDS);
+        }
+    }
+
+    private void retry() {
+        if (floor != null) {
+            discovery.invalidate();
+        }
+        int wait = ThreadLocalRandom.current().nextInt(delayMs / 2, delayMs + 1);
+        delayMs = Math.min(2000, Math.max(100, delayMs * 2));
+        schedule(this::poll, wait);
+    }
+
+    private void poll() {
+        long deadlineMs = floor == null ? timeout.toMillis() : Math.max(45000, timeout.toMillis());
+        CallOptions options = bootstrap.getAuthCallOptions().getGrpcCallOptions()
+                .withDeadlineAfter(deadlineMs, TimeUnit.MILLISECONDS);
+        ClientCall<ListEndpointsRequest, ListEndpointsResponse> call = bootstrap.getChannel(SETTINGS).getReadyChannel()
+                .newCall(DiscoveryServiceGrpc.getListEndpointsMethod(), options);
+        active = call;
+        call.start(new ClientCall.Listener<ListEndpointsResponse>() {
+            private Metadata initial = new Metadata();
+            private ListEndpointsResponse response;
+
+            @Override
+            public void onHeaders(Metadata value) {
+                initial = value;
+            }
+
+            @Override
+            public void onMessage(ListEndpointsResponse value) {
+                response = value;
+            }
+
+            @Override
+            public void onClose(Status status, Metadata trailers) {
+                synchronized (LongPollDiscovery.this) {
+                    if (active != call || closed) {
+                        return;
+                    }
+                    active = null;
+                    if (status.isOk() && response != null
+                            && response.getOperation().getStatus() == StatusIds.StatusCode.SUCCESS) {
+                        try {
+                            initial.merge(trailers);
+                            Long generation = generation(floor, initial);
+                            ListEndpointsResult endpoints = response.getOperation().getResult()
+                                    .unpack(ListEndpointsResult.class);
+                            if (generation != null && !generation.equals(floor)) {
+                                discovery.invalidate();
+                            }
+                            discovery.acceptSnapshot(endpoints);
+                            floor = generation;
+                            delayMs = 0;
+                            schedule(LongPollDiscovery.this::poll, floor == null ? TimeUnit.MINUTES.toMillis(1) : 0);
+                            return;
+                        } catch (IllegalArgumentException | InvalidProtocolBufferException e) {
+                            LOG.warn("Invalid ListEndpoints result", e);
+                        }
+                    }
+                    retry();
+                }
+            }
+        }, headers());
+        call.request(1);
+        call.sendMessage(ListEndpointsRequest.newBuilder().setDatabase(database).build());
+        call.halfClose();
+    }
+
+    @Override
+    public void close() {
+        synchronized (this) {
+            closed = true;
+            if (scheduled != null) {
+                scheduled.cancel(false);
+            }
+            if (active != null) {
+                active.cancel("Driver closed", null);
+                active = null;
+            }
+        }
+        bootstrap.close();
+    }
+}
