+++ b/core/src/main/java/tech/ydb/core/impl/EdsDiscovery.java
@@ -0,0 +1,322 @@
+package tech.ydb.core.impl;
+
+import java.time.Duration;
+import java.util.Iterator;
+import java.util.concurrent.Future;
+import java.util.concurrent.ThreadLocalRandom;
+import java.util.concurrent.TimeUnit;
+
+import com.google.protobuf.Any;
+import com.google.protobuf.InvalidProtocolBufferException;
+import io.envoyproxy.envoy.config.core.v3.SocketAddress;
+import io.envoyproxy.envoy.config.endpoint.v3.ClusterLoadAssignment;
+import io.envoyproxy.envoy.config.endpoint.v3.LocalityLbEndpoints;
+import io.envoyproxy.envoy.service.discovery.v3.DiscoveryRequest;
+import io.envoyproxy.envoy.service.discovery.v3.DiscoveryResponse;
+import io.envoyproxy.envoy.service.endpoint.v3.EndpointDiscoveryServiceGrpc;
+import io.grpc.CallOptions;
+import io.grpc.ClientCall;
+import io.grpc.Metadata;
+import io.grpc.Status;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import tech.ydb.core.grpc.GrpcRequestSettings;
+import tech.ydb.proto.StatusCodesProtos.StatusIds;
+import tech.ydb.proto.discovery.DiscoveryProtos.EndpointInfo;
+import tech.ydb.proto.discovery.DiscoveryProtos.ListEndpointsRequest;
+import tech.ydb.proto.discovery.DiscoveryProtos.ListEndpointsResponse;
+import tech.ydb.proto.discovery.DiscoveryProtos.ListEndpointsResult;
+import tech.ydb.proto.discovery.v1.DiscoveryServiceGrpc;
+
+/** One bootstrap transport and at most one active EDS or legacy lookup. */
+final class EdsDiscovery implements AutoCloseable {
+    private static final Logger LOG = LoggerFactory.getLogger(EdsDiscovery.class);
+    private static final String TYPE = "type.googleapis.com/envoy.config.endpoint.v3.ClusterLoadAssignment";
+    private static final Metadata.Key<String> GENERATION = key("x-ydb-route-generation");
+    private static final Metadata.Key<String> MODE = key("x-ydb-route-mode");
+    private static final Metadata.Key<String> FLOOR = key("x-ydb-min-route-generation");
+    private static final Metadata.Key<String> REQUIRE = key("x-ydb-require-current-route");
+    private static final GrpcRequestSettings SETTINGS = GrpcRequestSettings.newBuilder().build();
+
+    private final FixedCallOptionsTransport bootstrap;
+    private final YdbDiscovery discovery;
+    private final Duration timeout;
+    private final String database;
+    private Long floor;
+    private boolean requireCurrent;
+    private boolean closed;
+    private int delayMs;
+    private ClientCall<?, ?> active;
+    private Future<?> timer;
+    private Future<?> scheduled;
+
+    EdsDiscovery(FixedCallOptionsTransport transport, YdbDiscovery discovery, Duration timeout) {
+        this.bootstrap = transport;
+        this.discovery = discovery;
+        this.timeout = timeout;
+        this.database = transport.getDatabase();
+    }
+
+    private static Metadata.Key<String> key(String name) {
+        return Metadata.Key.of(name, Metadata.ASCII_STRING_MARSHALLER);
+    }
+
+    private static String single(Metadata headers, Metadata.Key<String> key) {
+        Iterable<String> values = headers.getAll(key);
+        if (values == null) {
+            return null;
+        }
+        Iterator<String> it = values.iterator();
+        String value = it.next();
+        return it.hasNext() ? null : value;
+    }
+
+    private static Long generation(Metadata headers) {
+        String value = single(headers, GENERATION);
+        if (value == null || !value.matches("[0-9]+")) {
+            return null;
+        }
+        try {
+            return Long.parseUnsignedLong(value);
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+    private boolean accept(Metadata headers) {
+        if (!headers.containsKey(GENERATION) && !headers.containsKey(MODE)) {
+            return floor == null;
+        }
+        Long value = generation(headers);
+        if (value == null || !"managed".equals(single(headers, MODE))
+                || (floor != null && Long.compareUnsigned(value, floor) < 0)) {
+            return false;
+        }
+        if (floor != null && !floor.equals(value)) {
+            discovery.invalidate();
+        }
+        floor = value;
+        return true;
+    }
+
+    private Metadata headers() {
+        Metadata headers = bootstrap.makeMetadataFromSettings(SETTINGS, bootstrap.serverEndpoint);
+        if (floor != null) {
+            headers.put(FLOOR, Long.toUnsignedString(floor));
+        }
+        if (requireCurrent) {
+            headers.put(REQUIRE, "1");
+        }
+        return headers;
+    }
+
+    synchronized void start() {
+        schedule(this::watch, 0);
+    }
+
+    private void schedule(Runnable next, long millis) {
+        if (!closed) {
+            scheduled = bootstrap.getScheduler().schedule(() -> {
+                synchronized (EdsDiscovery.this) {
+                    if (!closed) {
+                        try {
+                            next.run();
+                        } catch (RuntimeException e) {
+                            LOG.warn("Discovery attempt failed", e);
+                            if (active != null) {
+                                active.cancel("Discovery attempt failed", e);
+                                active = null;
+                            }
+                            retry(null);
+                        }
+                    }
+                }
+            }, millis, TimeUnit.MILLISECONDS);
+        }
+    }
+
+    static Long cutoverGeneration(Long floor, Status status, Metadata trailers) {
+        Long cut = generation(trailers);
+        return floor != null && status.getCode() == Status.Code.UNAVAILABLE && cut != null
+                && Long.compareUnsigned(cut, floor) > 0 ? cut : null;
+    }
+
+    private void retry(Long cut) {
+        discovery.invalidate();
+        requireCurrent = floor != null && cut == null;
+        if (cut != null) {
+            floor = cut;
+        }
+        int wait = delayMs == 0 ? 0 : ThreadLocalRandom.current().nextInt(delayMs / 2, delayMs + 1);
+        delayMs = Math.min(2000, Math.max(100, delayMs * 2));
+        schedule(this::watch, wait);
+    }
+
+    private void watch() {
+        ClientCall<DiscoveryRequest, DiscoveryResponse> call = bootstrap.getChannel(SETTINGS).getReadyChannel()
+                .newCall(EndpointDiscoveryServiceGrpc.getStreamEndpointsMethod(),
+                        bootstrap.getAuthCallOptions().getGrpcCallOptions().withDeadline(null));
+        active = call;
+        DiscoveryRequest.Builder request = DiscoveryRequest.newBuilder().addResourceNames(database).setTypeUrl(TYPE);
+        timer = bootstrap.getScheduler().schedule(() -> call.cancel("First EDS response timed out", null),
+                timeout.toMillis(), TimeUnit.MILLISECONDS);
+        call.start(new ClientCall.Listener<DiscoveryResponse>() {
+            private boolean routeOk;
+            private boolean received;
+            private Metadata initial = new Metadata();
+
+            @Override
+            public void onHeaders(Metadata value) {
+                synchronized (EdsDiscovery.this) {
+                    if (active != call) {
+                        return;
+                    }
+                    initial = value;
+                    routeOk = accept(initial);
+                    if (!routeOk) {
+                        call.cancel("Stale EDS route", null);
+                    }
+                }
+            }
+
+            @Override
+            public void onMessage(DiscoveryResponse message) {
+                synchronized (EdsDiscovery.this) {
+                    if (active != call || !routeOk) {
+                        return;
+                    }
+                    received = true;
+                    request.setResponseNonce(message.getNonce());
+                    try {
+                        discovery.acceptSnapshot(decode(database, message));
+                        timer.cancel(false);
+                        delayMs = 0;
+                        requireCurrent = false;
+                        request.clearErrorDetail().setVersionInfo(message.getVersionInfo());
+                    } catch (Exception e) {
+                        request.setErrorDetail(com.google.rpc.Status.newBuilder()
+                                .setCode(3).setMessage("Invalid EDS assignment"));
+                        discovery.invalidate();
+                        LOG.warn("Rejected EDS assignment", e);
+                    }
+                    call.sendMessage(request.build());
+                    call.request(1);
+                }
+            }
+
+            @Override
+            public void onClose(Status status, Metadata trailers) {
+                synchronized (EdsDiscovery.this) {
+                    if (active != call || closed) {
+                        return;
+                    }
+                    active = null;
+                    timer.cancel(false);
+                    if (!received && status.getCode() == Status.Code.UNIMPLEMENTED && accept(initial)) {
+                        schedule(EdsDiscovery.this::unary, 0);
+                        return;
+                    }
+                    retry(cutoverGeneration(floor, status, trailers));
+                }
+            }
+        }, headers());
+        call.request(1);
+        call.sendMessage(request.build());
+    }
+
+    private void unary() {
+        CallOptions options = bootstrap.getAuthCallOptions().getGrpcCallOptions()
+                .withDeadlineAfter(timeout.toMillis(), TimeUnit.MILLISECONDS);
+        ClientCall<ListEndpointsRequest, ListEndpointsResponse> call = bootstrap.getChannel(SETTINGS).getReadyChannel()
+                .newCall(DiscoveryServiceGrpc.getListEndpointsMethod(), options);
+        active = call;
+        call.start(new ClientCall.Listener<ListEndpointsResponse>() {
+            private Metadata initial = new Metadata();
+            private ListEndpointsResponse response;
+
+            @Override
+            public void onHeaders(Metadata value) {
+                initial = value;
+            }
+
+            @Override
+            public void onMessage(ListEndpointsResponse value) {
+                response = value;
+            }
+
+            @Override
+            public void onClose(Status status, Metadata trailers) {
+                synchronized (EdsDiscovery.this) {
+                    if (active != call || closed) {
+                        return;
+                    }
+                    active = null;
+                    if (status.isOk() && accept(initial) && response != null
+                            && response.getOperation().getStatus() == StatusIds.StatusCode.SUCCESS) {
+                        try {
+                            discovery.acceptSnapshot(response.getOperation().getResult()
+                                    .unpack(ListEndpointsResult.class));
+                            requireCurrent = false;
+                            delayMs = 0;
+                            schedule(EdsDiscovery.this::watch, TimeUnit.MINUTES.toMillis(1));
+                            return;
+                        } catch (InvalidProtocolBufferException e) {
+                            LOG.warn("Invalid ListEndpoints result", e);
+                        }
+                    }
+                    retry(null);
+                }
+            }
+        }, headers());
+        call.request(1);
+        call.sendMessage(ListEndpointsRequest.newBuilder().setDatabase(database).build());
+        call.halfClose();
+    }
+
+    static ListEndpointsResult decode(String database, DiscoveryResponse message)
+            throws InvalidProtocolBufferException {
+        if (message.getNonce().isEmpty() || message.getVersionInfo().isEmpty() || !TYPE.equals(message.getTypeUrl())
+                || message.getResourcesCount() != 1 || !TYPE.equals(message.getResources(0).getTypeUrl())) {
+            throw new IllegalArgumentException("Expected one versioned EDS resource");
+        }
+        ClusterLoadAssignment assignment = message.getResources(0).unpack(ClusterLoadAssignment.class);
+        if (!database.equals(assignment.getClusterName()) || assignment.getEndpointsCount() != 1) {
+            throw new IllegalArgumentException("Unexpected EDS cluster");
+        }
+        LocalityLbEndpoints group = assignment.getEndpoints(0);
+        Any metadata = group.getMetadata().getTypedFilterMetadataOrThrow("ydb.discovery");
+        ListEndpointsResult result = metadata.unpack(ListEndpointsResult.class);
+        if (result.getEndpointsCount() != group.getLbEndpointsCount()) {
+            throw new IllegalArgumentException("Mismatched EDS endpoints");
+        }
+        for (int i = 0; i < result.getEndpointsCount(); ++i) {
+            SocketAddress socket = group.getLbEndpoints(i).getEndpoint().getAddress().getSocketAddress();
+            EndpointInfo info = result.getEndpoints(i);
+            if (socket.getProtocol() != SocketAddress.Protocol.TCP || socket.getAddress().isEmpty()
+                    || socket.getPortValue() <= 0 || socket.getPortValue() > 65535
+                    || !socket.getAddress().equals(info.getAddress()) || socket.getPortValue() != info.getPort()) {
+                throw new IllegalArgumentException("Invalid EDS address");
+            }
+        }
+        return result;
+    }
+
+    @Override
+    public void close() {
+        synchronized (this) {
+            closed = true;
+            if (scheduled != null) {
+                scheduled.cancel(false);
+            }
+            if (timer != null) {
+                timer.cancel(false);
+            }
+            if (active != null) {
+                active.cancel("Driver closed", null);
+                active = null;
+            }
+        }
+        bootstrap.close();
+    }
+}
