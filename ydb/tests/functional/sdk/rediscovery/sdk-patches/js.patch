index 0000000000000000000000000000000000000000..b2c24492cf9e853edf196e34513d6e271e5b5568
--- /dev/null
+++ b/packages/core/src/endpoints/long-poll.ts
@@ -0,0 +1,60 @@
+import { type CallOptions, type Metadata, RpcError, Status } from '@ydbjs/grpc'
+import type { DiscoveryResult } from './endpoints-runtime.js'
+
+export class LongPollDiscovery {
+	#since: bigint | undefined
+	#listEndpoints: (options: CallOptions) => Promise<DiscoveryResult>
+	#timeoutMs: number
+
+	constructor(
+		listEndpoints: (options: CallOptions) => Promise<DiscoveryResult>,
+		timeoutMs: number
+	) {
+		this.#listEndpoints = listEndpoints
+		this.#timeoutMs = timeoutMs
+	}
+
+	async *watch(signal: AbortSignal): AsyncGenerator<DiscoveryResult> {
+		for (;;) {
+			let metadata: Record<string, string> = { 'x-ydb-discovery-long-poll': '1' }
+			let timeout = this.#timeoutMs
+			if (this.#since !== undefined) {
+				metadata['x-ydb-if-route-generation'] = this.#since.toString()
+				timeout = Math.max(45_000, timeout)
+			}
+			let stamps: unknown[] = []
+			let read = (headers: Metadata) => {
+				if ('x-ydb-route-generation' in headers)
+					stamps.push(headers['x-ydb-route-generation'])
+			}
+			// oxlint-disable-next-line no-await-in-loop -- Each poll needs the previous response generation.
+			let result = await this.#listEndpoints({
+				signal,
+				metadata,
+				deadline: Date.now() + timeout,
+				onHeader: read,
+				onTrailer: read,
+			})
+			if (stamps.length === 0 && this.#since === undefined) {
+				yield result
+				return
+			}
+			let [stamp] = stamps
+			if (stamps.length !== 1 || typeof stamp !== 'string' || !/^\d{1,20}$/.test(stamp)) {
+				throw new RpcError(Status.UNAVAILABLE, 'Missing or invalid route generation')
+			}
+			let next = BigInt(stamp)
+			if (
+				next > 0xffff_ffff_ffff_ffffn ||
+				(this.#since !== undefined && next < this.#since)
+			) {
+				throw new RpcError(Status.UNAVAILABLE, 'Invalid or stale route generation')
+			}
+			if (this.#since !== next) {
