index 0000000000000000000000000000000000000000..b4fc07983081d7e4b04c959c6dd33935219dc1d8
--- /dev/null
+++ b/packages/core/src/endpoints/eds.ts
@@ -0,0 +1,193 @@
+import { randomUUID } from 'node:crypto'
+import { create, fromBinary, toBinary } from '@bufbuild/protobuf'
+import { anyUnpack } from '@bufbuild/protobuf/wkt'
+import { ListEndpointsResultSchema } from '@ydbjs/api/discovery'
+import { AsyncQueue } from '@ydbjs/fsm/queue'
+import { type CallOptions, type Metadata, RpcError, Status, type Transport } from '@ydbjs/grpc'
+
+import {
+	ClusterLoadAssignmentSchema,
+	type DiscoveryRequest,
+	DiscoveryRequestSchema,
+	DiscoveryResponseSchema,
+} from './wire/eds_pb.js'
+import { type DiscoveryResult, mapDiscoveryResult } from './endpoints-runtime.js'
+
+let typeUrl = 'type.googleapis.com/envoy.config.endpoint.v3.ClusterLoadAssignment'
+let method = {
+	path: '/envoy.service.endpoint.v3.EndpointDiscoveryService/StreamEndpoints',
+	requestStream: true,
+	responseStream: true,
+	requestSerialize: (msg: DiscoveryRequest) => toBinary(DiscoveryRequestSchema, msg),
+	responseDeserialize: (bytes: Uint8Array) => fromBinary(DiscoveryResponseSchema, bytes),
+}
+type Response = ReturnType<typeof method.responseDeserialize>
+
+function decode(database: string, response: Response): DiscoveryResult {
+	let resource = response.resources[0]
+	if (
+		!response.versionInfo ||
+		!response.nonce ||
+		response.typeUrl !== typeUrl ||
+		response.resources.length !== 1 ||
+		resource?.typeUrl !== typeUrl
+	) {
+		throw new Error('Expected one versioned EDS resource')
+	}
+	let assignment = fromBinary(ClusterLoadAssignmentSchema, resource.value)
+	let group = assignment.endpoints[0]
+	let extension = group?.metadata?.typedFilterMetadata['ydb.discovery']
+	let result = extension && anyUnpack(extension, ListEndpointsResultSchema)
+	if (
+		assignment.clusterName !== database ||
+		assignment.endpoints.length !== 1 ||
+		!group ||
+		!result ||
+		result.endpoints.length !== group.lbEndpoints.length
+	) {
+		throw new Error('Invalid database or YDB discovery attributes')
+	}
+	for (let [index, endpoint] of result.endpoints.entries()) {
+		let socket = group.lbEndpoints[index]?.endpoint?.address?.socketAddress
+		if (
+			!socket ||
+			socket.protocol !== 0 ||
+			!socket.address ||
+			endpoint.address !== socket.address ||
+			socket.portSpecifier.case !== 'portValue' ||
+			endpoint.port < 1 ||
+			endpoint.port > 65535 ||
+			endpoint.port !== socket.portSpecifier.value
+		) {
+			throw new Error('Invalid EDS socket address')
+		}
+	}
+	return mapDiscoveryResult(result)
+}
+
+function generation(metadata: Metadata): bigint | undefined {
+	let value = metadata['x-ydb-route-generation']
+	if (typeof value !== 'string' || !/^\d{1,20}$/.test(value)) return undefined
+	let parsed = BigInt(value)
+	return parsed <= 0xffff_ffff_ffff_ffffn ? parsed : undefined
+}
+
+export class EdsDiscovery {
+	#database: string
+	#transport: Transport
+	#listEndpoints: (options: CallOptions) => Promise<DiscoveryResult>
+	#id = randomUUID()
+	#floor: bigint | undefined
+	#current = false
+	#unsupportedUntil = 0
+
+	constructor(
+		database: string,
+		transport: Transport,
+		listEndpoints: (options: CallOptions) => Promise<DiscoveryResult>
+	) {
+		this.#database = database
+		this.#transport = transport
+		this.#listEndpoints = listEndpoints
+	}
+
+	#accept(headers: Metadata): void {
+		let value = generation(headers)
+		if (
+			this.#floor === undefined &&
+			!('x-ydb-route-generation' in headers) &&
+			!('x-ydb-route-mode' in headers)
+		)
+			return
+		if (
+			headers['x-ydb-route-mode'] !== 'managed' ||
+			value === undefined ||
+			(this.#floor !== undefined && value < this.#floor)
+		) {
+			throw new RpcError(Status.UNAVAILABLE, 'Stale or missing discovery route generation')
+		}
+		this.#floor = value
+	}
+
+	#options(signal: AbortSignal, onHeader: (headers: Metadata) => void): CallOptions {
+		let metadata: Record<string, string> = {}
+		if (this.#floor !== undefined)
+			metadata['x-ydb-min-route-generation'] = this.#floor.toString()
+		if (this.#current) metadata['x-ydb-require-current-route'] = '1'
+		return { signal, metadata, onHeader }
+	}
+
+	async *watch(signal: AbortSignal): AsyncGenerator<DiscoveryResult> {
+		let initial: Metadata = {}
+		let onHeader = (headers: Metadata) => {
+			initial = headers
+		}
+		if (performance.now() >= this.#unsupportedUntil) {
+			using requests = new AsyncQueue<DiscoveryRequest>()
+			let base = { typeUrl, resourceNames: [this.#database] }
+			requests.push(create(DiscoveryRequestSchema, { ...base, node: { id: this.#id } }))
+			let version = ''
+			let received = false
+			try {
+				for await (let response of this.#transport.call(
+					method,
+					requests,
+					this.#options(signal, onHeader)
+				)) {
+					received = true
+					let result: DiscoveryResult
+					try {
+						result = decode(this.#database, response)
+					} catch (error) {
+						requests.push(
+							create(DiscoveryRequestSchema, {
+								...base,
+								versionInfo: version,
+								responseNonce: response.nonce,
+								errorDetail: {
+									code: Status.INVALID_ARGUMENT,
+									message: String(error),
+								},
+							})
+						)
+						continue
+					}
+					this.#accept(initial)
+					this.#current = false
+					yield result
+					version = response.versionInfo
+					requests.push(
+						create(DiscoveryRequestSchema, {
+							...base,
+							versionInfo: version,
+							responseNonce: response.nonce,
+						})
+					)
+				}
+				throw new RpcError(Status.UNAVAILABLE, 'EDS stream ended')
+			} catch (err) {
+				if (signal.aborted) throw err
+				if (received || !(err instanceof RpcError) || err.code !== Status.UNIMPLEMENTED) {
+					let cut =
+						err instanceof RpcError && err.code === Status.UNAVAILABLE
+							? generation(err.metadata)
+							: undefined
+					if (this.#floor !== undefined && cut !== undefined && cut > this.#floor) {
+						this.#floor = cut
+						this.#current = false
+					} else if (received || this.#floor !== undefined) {
+						this.#current = true
+					}
+					throw err
+				}
+				this.#accept(initial)
+				this.#unsupportedUntil = performance.now() + 5 * 60_000
+			}
+		}
+		initial = {}
+		let result = await this.#listEndpoints(this.#options(signal, onHeader))
+		this.#accept(initial)
+		this.#current = false
+		yield result
+	}
+}
