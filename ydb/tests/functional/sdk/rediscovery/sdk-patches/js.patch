+test('long polling cancels an active data RPC before routing to the replacement', async (tc) => {
+	let bootstrap = new Server()
+	let first = new Server()
+	let second = new Server()
+	let entered = Promise.withResolvers<void>()
+	let wake = Promise.withResolvers<void>()
+	let cut = false
+	let firstDataPort = 0
+	let oldSocketClosed = Promise.withResolvers<void>()
+	let proxy = createServer((socket) => {
+		let upstream = createConnection(firstDataPort, '127.0.0.1')
+		socket.pipe(upstream).pipe(socket)
+		socket.on('close', () => {
+			upstream.destroy()
+			oldSocketClosed.resolve()
+		})
+	})
+	let firstPort = 0
+	let secondPort = 0
+	let polls: unknown[] = []
+	bootstrap.add(DiscoveryServiceDefinition, {
+		async listEndpoints(_, ctx) {
+			polls.push(ctx.metadata['x-ydb-if-route-generation'])
+			expect(ctx.metadata['x-ydb-discovery-long-poll']).toBe('1')
+			let since = ctx.metadata['x-ydb-if-route-generation']
+			if (since === '1' && !cut) await wake.promise
+			if (since === '2')
+				await new Promise<void>((resolve) =>
+					ctx.signal.addEventListener('abort', () => resolve(), { once: true })
+				)
+			ctx.setTrailer({ 'x-ydb-route-generation': cut ? '2' : '1' })
+			return create(ListEndpointsResponseSchema, {
+				operation: {
+					ready: true,
+					status: StatusIds_StatusCode.SUCCESS,
+					result: anyPack(
+						ListEndpointsResultSchema,
+						create(ListEndpointsResultSchema, {
+							endpoints: [
+								{
+									nodeId: 1,
+									address: '127.0.0.1',
+									port: cut ? secondPort : firstPort,
+								},
+							],
+						})
+					),
+				},
+			})
+		},
+	})
+	first.add(DiscoveryServiceDefinition, {
+		async whoAmI(_, ctx) {
+			entered.resolve()
+			await new Promise<void>((resolve) =>
+				ctx.signal.addEventListener('abort', () => resolve(), { once: true })
+			)
+			return create(WhoAmIResponseSchema)
+		},
+	})
+	second.add(DiscoveryServiceDefinition, {
+		async whoAmI() {
+			return create(WhoAmIResponseSchema, { operation: { id: 'replacement' } })
+		},
+	})
+	try {
+		let port = await bootstrap.listen('127.0.0.1:0')
+		firstDataPort = await first.listen('127.0.0.1:0')
+		proxy.listen(0, '127.0.0.1')
+		await once(proxy, 'listening')
+		firstPort = (proxy.address() as AddressInfo).port
+		secondPort = await second.listen('127.0.0.1:0')
+		using driver = new Driver(`grpc://127.0.0.1:${port}/local`, {
+			'ydb.sdk.enable_long_poll': true,
+		})
+		await driver.ready(tc.signal)
+		let client = driver.createClient(DiscoveryServiceDefinition)
+		let abandoned = client.whoAmI({}, { signal: tc.signal }).catch((err: unknown) => err)
+		await entered.promise
+		cut = true
+		wake.resolve()
+		expect(await abandoned).toBeInstanceOf(Error)
+		await oldSocketClosed.promise
+		await expect.poll(() => polls.includes('2')).toBe(true)
+		expect((await client.whoAmI({}, { signal: tc.signal })).operation?.id).toBe('replacement')
+		expect(polls.slice(0, 3)).toEqual([undefined, '1', '2'])
+	} finally {
+		wake.resolve()
+		proxy.close()
+		await Promise.all([bootstrap.close(), first.close(), second.close()])
+	}
+})
