+}
+
+message SocketAddress {
+    uint32 protocol = 1;
+    string address = 2;
+    oneof port_specifier {
+        uint32 port_value = 3;
+        string named_port = 4;
+    }
+}
+
+message Address {
+    SocketAddress socket_address = 1;
+}
+
+message Endpoint {
+    Address address = 1;
+}
+
+message LbEndpoint {
+    Endpoint endpoint = 1;
+}
+
+message Locality {
+    string region = 1;
+}
+
+message LocalityLbEndpoints {
