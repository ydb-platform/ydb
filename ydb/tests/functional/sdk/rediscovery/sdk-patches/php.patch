+{
+    const TYPE = 'type.googleapis.com/envoy.config.endpoint.v3.ClusterLoadAssignment';
+    const RESULT = 'type.googleapis.com/Ydb.Discovery.ListEndpointsResult';
+    const WATCH = '/envoy.service.endpoint.v3.EndpointDiscoveryService/StreamEndpoints';
+    const UNARY = '/Ydb.Discovery.V1.DiscoveryService/ListEndpoints';
+    const MAX_MESSAGE = 4194304;
+
+    private $ydb;
+    private $base;
+    private $multi;
+    private $curl;
+    private $unary = false;
+    private $legacyUntil = 0;
+    private $send = '';
+    private $recv = '';
+    private $headers = [];
+    private $trailers = [];
+    private $initialDone = false;
+    private $status;
+    private $floor;
+    private $current = false;
+    private $version = '';
+    private $epoch = 0;
+    private $snapshot;
+    private $tlsRoot;
+    private $callbackError;
+    private $resume = false;
+
+    public function __construct(Ydb $ydb, string $bootstrap, array $options)
+    {
+        if (!(curl_version()['features'] & CURL_VERSION_HTTP2)) {
+            throw new \RuntimeException('EDS requires HTTP/2 in the PHP curl extension');
+        }
+        if ($options || !preg_match('/^(?:[a-zA-Z0-9._-]+|\[[0-9a-fA-F:]+\]):[0-9]+$/D', $bootstrap)) {
+            throw new \InvalidArgumentException('EDS requires host:port bootstrap and default gRPC channel options');
+        }
+        $this->ydb = $ydb;
+        $this->base = ($ydb->iam()->config('insecure') ? 'http://' : 'https://') . $bootstrap;
+        $this->tlsRoot = $ydb->iam()->config('root_cert_file');
+        $this->multi = curl_multi_init();
+    }
+
+    private static function frame($message): string
+    {
+        $data = $message->serializeToString();
+        return pack('CN', 0, strlen($data)) . $data;
+    }
+
+    private function request(string $nonce = '', string $error = ''): string
+    {
+        $request = new DiscoveryRequest([
+            'type_url' => self::TYPE, 'resource_names' => [$this->ydb->database()],
+            'version_info' => $this->version, 'response_nonce' => $nonce
+        ]);
+        if ($nonce === '') {
+            $request->setNode(new Node(['id' => 'ydb-php-sdk']));
+        }
+        if ($error !== '') {
+            $request->setErrorDetail(new Status(['code' => 3, 'message' => $error]));
+        }
+        return self::frame($request);
+    }
+
+    private function start()
+    {
+        $this->headers = $this->trailers = [];
+        $this->status = $this->callbackError = null;
+        $this->initialDone = $this->resume = false;
+        $this->version = $this->recv = '';
+        $this->send = $this->unary ? '' : $this->request();
+        $headers = ['content-type: application/grpc', 'te: trailers', 'expect:'];
+        foreach ($this->ydb->meta() as $key => $values) {
+            foreach ($values as $value) {
+                if (preg_match('/[\r\n]/', $value)) {
+                    throw new \InvalidArgumentException('Invalid discovery metadata');
+                }
+                $headers[] = "$key: $value";
+            }
+        }
+        if ($this->floor !== null) {
+            $headers[] = 'x-ydb-min-route-generation: ' . $this->floor;
+        }
+        if ($this->current) {
+            $headers[] = 'x-ydb-require-current-route: 1';
+        }
+        $this->curl = curl_init($this->base . ($this->unary ? self::UNARY : self::WATCH));
+        $options = [
+            CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_2_PRIOR_KNOWLEDGE,
+            CURLOPT_HTTPHEADER => $headers, CURLOPT_NOSIGNAL => true, CURLOPT_PROXY => '',
+            CURLOPT_HEADERFUNCTION => function ($curl, $line) {
+                if (trim($line) === '') {
+                    $this->initialDone = true;
+                } elseif (($pos = strpos($line, ':')) !== false) {
+                    $key = strtolower(substr($line, 0, $pos));
+                    $value = trim(substr($line, $pos + 1));
+                    if ($this->initialDone) {
+                        $this->trailers[$key] = $value;
+                    } else {
+                        $this->headers[$key] = $value;
+                    }
+                    if ($key === 'grpc-status') {
+                        $this->status = (int)$value;
+                    }
+                }
+                return strlen($line);
+            },
+            CURLOPT_WRITEFUNCTION => function ($curl, $chunk) {
+                try {
+                    $this->receive($chunk);
+                    return strlen($chunk);
+                } catch (\Throwable $error) {
+                    $this->callbackError = $error;
+                    return 0;
+                }
+            }
+        ];
+        if ($this->tlsRoot) {
+            $options[CURLOPT_CAINFO] = $this->tlsRoot;
+        }
+        if ($this->unary) {
+            $this->snapshot = null;
+            $options[CURLOPT_POSTFIELDS] = self::frame(new ListEndpointsRequest(['database' => $this->ydb->database()]));
+        } else {
+            $options[CURLOPT_UPLOAD] = true;
+            $options[CURLOPT_CUSTOMREQUEST] = 'POST';
+            $options[CURLOPT_READFUNCTION] = function ($curl, $fd, $size) {
+                if ($this->send === '') {
+                    return CURL_READFUNC_PAUSE;
+                }
+                $part = substr($this->send, 0, $size);
+                $this->send = substr($this->send, strlen($part));
+                return $part;
+            };
