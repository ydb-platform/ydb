+            }
+            $this->routeSnapshot = $state;
+        }
+        return $this->routeEpoch;
+    }
+
+    /** @internal Share the current route's data transport between service stubs. */
+    public function serviceClient(string $class, ?string $legacyEndpoint = null)
+    {
+        $opts = $this->grpcOpts();
+        if (!$this->longPoll) {
+            return new $class($legacyEndpoint ?? $this->endpoint, $opts);
+        }
+        if ($this->routeSnapshot === null) {
+            throw new \RuntimeException('No current endpoint assignment');
+        }
+        if (!$this->routeDataChannel) {
+            $opts['force_new'] = true;
+            $opts['grpc.use_local_subchannel_pool'] = 1;
+            $this->routeDataChannel = \Grpc\BaseStub::getDefaultChannel($this->endpoint, $opts);
+        }
+        return new $class($this->endpoint, $opts, $this->routeDataChannel);
+    }
+
+    private function attachDiscoveryLoop($loop)
+    {
+        if (!class_exists(\WeakReference::class) || !($loop instanceof \React\EventLoop\LoopInterface)) {
+            throw new \InvalidArgumentException('discoveryLoop requires ReactPHP EventLoop and PHP 7.4 or later');
+        }
+        $this->discoveryLoop = $loop;
+        $driver = \WeakReference::create($this);
+        $this->discoveryTimer = $loop->addPeriodicTimer(0.1, static function () use ($driver) {
+            $owner = $driver->get();
+            if ($owner) {
+                try {
+                    $owner->refreshLongPoll(0);
+                } catch (\Throwable $error) {
+                    $owner->logger()->debug('Background ListEndpoints failed: ' . $error->getMessage());
+                }
+            }
+        });
+    }
+
+    /** @internal Release the native gRPC call even while the application holds its generator. */
+    public function dataResponses($call)
+    {
+        $stream = (object)['call' => $call, 'responses' => $call->responses()];
+        unset($call);
+        $this->routeStreams->attach($stream);
+        try {
+            while ($stream->responses && $stream->responses->valid()) {
+                $this->refreshLongPoll();
+                if (!$stream->responses) {
+                    break;
+                }
+                yield $stream->responses->current();
+                $this->refreshLongPoll();
+                if ($stream->responses) {
+                    $stream->responses->next();
+                }
+            }
+            if (!$stream->responses) {
+                throw new \RuntimeException('Data stream belongs to a retired replica');
+            }
+        } finally {
+            $this->routeStreams->detach($stream);
+        }
+    }
+
+    public function __destruct()
+    {
+        if ($this->discoveryTimer) {
+            $this->discoveryLoop->cancelTimer($this->discoveryTimer);
+        }
+    }
+
+    private function closeRouteChannel()
+    {
+        foreach ($this->routeStreams as $stream) {
+            if ($stream->call) {
+                $stream->call->cancel();
+                $stream->call = $stream->responses = null;
+            }
+        }
+        if ($this->routeDataChannel) {
+            $this->routeDataChannel->close();
+            $this->routeDataChannel = null;
+        }
     }
 
