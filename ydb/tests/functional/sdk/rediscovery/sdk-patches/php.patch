+                    throw new \RuntimeException('ListEndpoints fallback failed');
+                }
+                $this->snapshot = self::result($op->getResult());
+            } else {
+                $reply = new DiscoveryResponse();
+                $reply->mergeFromString($message);
+                try {
+                    $this->snapshot = self::decode($reply, $this->ydb->database());
+                    $this->version = $reply->getVersionInfo();
+                    $this->send .= $this->request($reply->getNonce());
+                } catch (\Exception $error) {
+                    $this->send .= $this->request($reply->getNonce(), $error->getMessage());
+                }
+                $this->resume = true;
+            }
+        }
+    }
+
+    private static function result($any): array
+    {
+        if (!$any || $any->getTypeUrl() !== self::RESULT) {
+            throw new \UnexpectedValueException('Missing YDB endpoint metadata');
+        }
+        $result = new ListEndpointsResult();
+        $result->mergeFromString($any->getValue());
+        return json_decode($result->serializeToJsonString(), true)['endpoints'] ?? [];
+    }
+
+    public static function decode(DiscoveryResponse $reply, string $database): array
+    {
+        $resources = $reply->getResources();
+        if ($reply->getTypeUrl() !== self::TYPE || $reply->getVersionInfo() === '' || $reply->getNonce() === ''
+            || count($resources) !== 1 || $resources[0]->getTypeUrl() !== self::TYPE) {
+            throw new \UnexpectedValueException('Expected one versioned EDS resource');
+        }
+        $cla = new ClusterLoadAssignment();
+        $cla->mergeFromString($resources[0]->getValue());
+        if ($cla->getClusterName() !== $database || count($cla->getEndpoints()) !== 1) {
+            throw new \UnexpectedValueException('Unexpected EDS resource name or localities');
+        }
+        $group = $cla->getEndpoints()[0];
+        $metadata = $group->getMetadata();
+        $data = $metadata ? $metadata->getTypedFilterMetadata() : [];
+        $result = self::result($data['ydb.discovery'] ?? null);
+        if (count($group->getLbEndpoints()) !== count($result)) {
+            throw new \UnexpectedValueException('Inconsistent EDS endpoints');
+        }
+        foreach ($group->getLbEndpoints() as $i => $entry) {
+            $endpoint = $entry->getEndpoint();
+            $address = $endpoint && $endpoint->getAddress() ? $endpoint->getAddress()->getSocketAddress() : null;
+            if (!$address || $address->getProtocol() || !$address->getPortValue() || $address->getPortValue() > 65535
+                || $address->getAddress() === '' || $address->getAddress() !== ($result[$i]['address'] ?? null)
+                || $address->getPortValue() !== ($result[$i]['port'] ?? null)) {
+                throw new \UnexpectedValueException('Inconsistent EDS endpoint address');
+            }
+        }
+        return $result;
+    }
+
+    private function closeCall()
+    {
+        if ($this->curl) {
+            curl_multi_remove_handle($this->multi, $this->curl);
+            curl_close($this->curl);
+            $this->curl = null;
+        }
+    }
+
+    public function poll(int $timeoutMs): array
+    {
+        $deadline = microtime(true) + $timeoutMs / 1000;
+        $attempts = 0;
+        do {
+            if (!$this->curl) {
+                if ($this->unary && $this->snapshot !== null) {
+                    if (microtime(true) < $this->legacyUntil) {
+                        return $this->snapshot;
+                    }
+                    // A rolling upgrade can add EDS while this driver is using unary discovery.
+                    $this->unary = false;
+                    $this->snapshot = null;
+                    ++$this->epoch;
+                }
+                $this->start();
+            }
+            if (!$this->unary) {
+                // libcurl can defer completed HTTP/2 trailers while this upload is paused.
+                curl_pause($this->curl, CURLPAUSE_CONT);
+                $this->resume = false;
+            }
+            do {
+                $code = curl_multi_exec($this->multi, $running);
+            } while ($code === CURLM_CALL_MULTI_PERFORM);
+            $finished = curl_multi_info_read($this->multi);
+            if ($this->callbackError) {
+                $this->snapshot = null;
+                $this->closeCall();
+                throw $this->callbackError;
+            }
+            if ($this->status !== null || $finished || $code !== CURLM_OK) {
+                $status = $this->status;
+                $this->closeCall();
+                if ($status === 0 && $this->unary && $this->snapshot !== null) {
+                    $this->current = false;
+                    $this->legacyUntil = microtime(true) + $this->ydb->discoveryInterval();
+                    return $this->snapshot;
+                }
+                $this->snapshot = null;
+                ++$this->epoch;
+                if ($status === 12 && !$this->unary) {
+                    $this->verify();
+                    $this->unary = true;
+                } else {
+                    $trailer = $this->trailers['x-ydb-route-generation'] ?? '';
+                    if ($status === 14 && $this->floor !== null && ctype_digit($trailer)
+                        && bccomp($trailer, $this->floor, 0) >= 0) {
+                        $this->floor = $trailer;
+                        $this->current = false;
+                    } else {
+                        $this->current = true;
+                    }
+                    if (++$attempts > 1) {
+                        usleep(random_int(10000, 30000));
+                    }
+                }
+                continue;
+            }
+            if (!$this->unary && $this->snapshot !== null && !$this->resume) {
+                $this->current = false;
+                return $this->snapshot;
+            }
+            if (!$this->resume) {
+                curl_multi_select($this->multi, min(0.05, max(0, $deadline - microtime(true))));
+            }
+        } while (microtime(true) < $deadline);
+        $this->snapshot = null;
+        throw new \RuntimeException('Timed out waiting for current endpoint discovery');
+    }
+
+    /** Identify compatible native channels, including across drivers on the same assignment. */
+    public function channelPoolKey(): ?string
+    {
+        return $this->floor === null ? null : hash('sha256',
+            serialize([$this->base, $this->ydb->database(), $this->floor]));
+    }
+
+    public function epoch(): int
+    {
+        return $this->epoch;
+    }
+
+    public function __destruct()
+    {
+        $this->closeCall();
+        if ($this->multi) {
+            curl_multi_close($this->multi);
+        }
+    }
+}
