+            if (!$stream->responses) {
+                throw new \RuntimeException('Data stream belongs to a retired replica');
+            }
+        } finally {
+            $this->routeStreams->detach($stream);
+        }
+    }
+
+    public function __destruct()
+    {
+        if ($this->discoveryTimer) {
+            $this->discoveryLoop->cancelTimer($this->discoveryTimer);
+        }
+    }
+
+    private function closeRouteChannel()
+    {
+        if ($this->table) {
+            $this->table->retireSessions();
+        }
+        foreach ($this->routeStreams as $stream) {
+            if ($stream->call) {
+                $stream->call->cancel();
+                $stream->call = $stream->responses = null;
+            }
+        }
+        if ($this->routeDataChannel) {
+            $this->routeDataChannel->close();
+            $this->routeDataChannel = null;
+        }
     }
 
