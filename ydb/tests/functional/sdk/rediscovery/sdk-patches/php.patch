+        curl_setopt_array($this->curl, $options);
+        curl_multi_add_handle($this->multi, $this->curl);
+    }
+
+    private function verify()
+    {
+        $generation = $this->headers['x-ydb-route-generation'] ?? null;
+        $mode = $this->headers['x-ydb-route-mode'] ?? null;
+        if ($this->floor === null && $mode === null && $generation === null) {
+            return;
+        }
+        if (!in_array($mode, ['managed', 'legacy'], true) || !is_string($generation) || !ctype_digit($generation)
