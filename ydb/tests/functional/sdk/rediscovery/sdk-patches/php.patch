+    public function testFullUnsignedRange()
+    {
+        self::assertSame('18446744073709551615', LongPoll::generation(['18446744073709551615'], '1'));
+        self::assertSame('0', LongPoll::generation(['0'], null));
+    }
+
+    public function testReleasesNativeCallWhileGeneratorIsHeld()
+    {
+        $driver = new class extends \YdbPlatform\Ydb\Ydb {
+            public function __construct() {}
+            public function refreshLongPoll(?int $timeoutMs = null) { return 1; }
+        };
+        $streams = new \ReflectionProperty(\YdbPlatform\Ydb\Ydb::class, 'routeStreams');
+        $streams->setAccessible(true);
+        $streams->setValue($driver, new \SplObjectStorage());
+        $call = new class {
+            public $cancelled = false;
+            public function responses() { yield 1; yield 2; }
+            public function cancel() { $this->cancelled = true; }
+        };
+        $held = $driver->dataResponses($call);
+        self::assertSame(1, $held->current());
+        $close = new \ReflectionMethod(\YdbPlatform\Ydb\Ydb::class, 'closeRouteChannel');
+        $close->setAccessible(true);
+        $close->invoke($driver);
+        self::assertTrue($call->cancelled);
+        $this->expectException(\RuntimeException::class);
+        $held->next();
+    }
