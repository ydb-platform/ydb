+    /** @dataProvider routeBeforeRefresh */
+    public function testFailedRefreshPreservesOnlyInstalledLegacyAssignment($generation, $snapshot, $keep)
+    {
+        $driver = new \YdbPlatform\Ydb\Ydb(['database'=>'/db', 'iam_config'=>['anonymous'=>true, 'insecure'=>true]]);
+        $listener = stream_socket_server('tcp://127.0.0.1:0');
+        $endpoint = stream_socket_get_name($listener, false);
+        fclose($listener);
+        $poll = new LongPoll($driver, $endpoint, []);
+        foreach (['generation'=>$generation, 'snapshot'=>$snapshot] as $name=>$value) {
+            $property = new \ReflectionProperty($poll, $name);
+            $property->setAccessible(true);
+            $property->setValue($poll, $value);
+        }
+
+        // Drive a native curl refresh until the failed connection is observed.
+        $backoff = new \ReflectionProperty($poll, 'nextPoll');
+        $backoff->setAccessible(true);
+        if (!$keep) {
+            $this->expectException(\RuntimeException::class);
+        }
+        $deadline = microtime(true) + 2;
+        do {
+            $result = $poll->poll(100);
+        } while ($backoff->getValue($poll) == 0 && microtime(true) < $deadline);
+        self::assertGreaterThan(0, $backoff->getValue($poll));
+        self::assertSame([null, $snapshot], $result);
+    }
