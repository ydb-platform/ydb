+
+class EdsTest extends TestCase
+{
+    public function testNativeChannelsSeparateGenerationsAtTheSameAddress()
+    {
+        $listener = stream_socket_server('tcp://127.0.0.1:0');
+        $endpoint = stream_socket_get_name($listener, false);
+        $set = static function ($object, $property, $value) {
+            $field = new \ReflectionProperty($object, $property);
+            $field->setAccessible(true);
+            $field->setValue($object, $value);
+        };
+        $client = static function ($generation) use ($endpoint, $set) {
+            $driver = new \YdbPlatform\Ydb\Ydb([
+                'endpoint' => $endpoint, 'database' => '/db',
+                'iam_config' => ['anonymous' => true, 'insecure' => true],
+            ]);
+            $eds = new Eds($driver, $endpoint, []);
+            $set($eds, 'floor', $generation);
+            $set($driver, 'eds', $eds);
+            $set($driver, 'edsSnapshot', [0, []]);
+            return $driver->serviceClient(\Ydb\Table\V1\TableServiceClient::class);
+        };
+        $accept = function ($client) use ($listener) {
+            $client->getConnectivityState(true);
+            $peer = @stream_socket_accept($listener, 2);
+            self::assertTrue(is_resource($peer), 'A new route must dial a new socket even at the same address');
+            fwrite($peer, "\x00\x00\x00\x04\x00\x00\x00\x00\x00");
+            self::assertTrue($client->waitForReady(2000000));
+            return $peer;
+        };
+        try {
+            $held = $client('1');
+            $a = $accept($held);
+            $fresh = $client('2');
+            $b = $accept($fresh);
+            // A separate driver on the same authoritative assignment can reuse its data socket.
+            self::assertTrue($client('2')->waitForReady(2000000));
+            self::assertSame(\Grpc\CHANNEL_READY, $held->getConnectivityState());
+        } finally {
+            if (isset($a)) { fclose($a); }
+            if (isset($b)) { fclose($b); }
+            fclose($listener);
+        }
+    }
+
+    private function response($port)
+    {
+        $result = new ListEndpointsResult(['endpoints' => [new EndpointInfo([
+            'address' => 'node.example', 'port' => 2135, 'node_id' => 7
+        ])]]);
+        $extension = new Any(['type_url' => Eds::RESULT, 'value' => $result->serializeToString()]);
+        $socket = new SocketAddress(['address' => 'node.example', 'port_value' => $port]);
+        $group = new LocalityLbEndpoints([
+            'metadata' => new Metadata(['typed_filter_metadata' => ['ydb.discovery' => $extension]]),
+            'lb_endpoints' => [new LbEndpoint(['endpoint' => new Endpoint([
+                'address' => new Address(['socket_address' => $socket])
+            ])])]
+        ]);
+        $assignment = new ClusterLoadAssignment(['cluster_name' => '/db', 'endpoints' => [$group]]);
+        return new DiscoveryResponse([
+            'type_url' => Eds::TYPE, 'version_info' => 'v1', 'nonce' => 'n1',
+            'resources' => [new Any(['type_url' => Eds::TYPE, 'value' => $assignment->serializeToString()])]
+        ]);
+    }
+
+    public function testAcceptsCompleteYdbEndpoint()
+    {
+        $this->assertSame([['address' => 'node.example', 'port' => 2135, 'nodeId' => 7]],
+            Eds::decode($this->response(2135), '/db'));
+    }
+
+    public function testExistingScanChecksDiscoveryBeforeReadingAnotherResponse()
+    {
+        $rpc = new class {
+            public $reads = 0;
+            public function StreamExecuteScanQuery($request, $metadata, $options) { return $this; }
+            public function responses() {
+                while (++$this->reads <= 2) {
+                    yield new \Ydb\Table\ExecuteScanQueryPartialResponse([
+                        'status' => \Ydb\StatusIds\StatusCode::SUCCESS,
+                        'result' => new \Ydb\Table\ExecuteScanQueryPartialResult(),
+                    ]);
+                }
+            }
+        };
+        $epoch = 1;
+        $driver = $this->createMock(\YdbPlatform\Ydb\Ydb::class);
+        $driver->method('needDiscovery')->willReturn(true);
+        $driver->method('refreshEds')->willReturnCallback(function () use (&$epoch) { return $epoch; });
+        $driver->method('serviceClient')->willReturn($rpc);
+        $driver->method('iam')->willReturn($this->createMock(\YdbPlatform\Ydb\Contracts\IamTokenContract::class));
+        $logger = new \Psr\Log\NullLogger();
+        $retry = new \YdbPlatform\Ydb\Retry\Retry($logger);
+        $table = new \YdbPlatform\Ydb\Table($driver, $logger, $retry);
+        $scan = $table->scanQuery('SELECT 1');
+        self::assertTrue($scan->valid());
+        $epoch = 2;
+        try {
+            $scan->next();
+            self::fail('A scan on the removed node returned another response');
+        } catch (\YdbPlatform\Ydb\Exceptions\Grpc\UnavailableException $expected) {
+            self::assertSame(1, $rpc->reads);
+        }
+    }
+
+    public function testRejectsInconsistentStandardAddress()
+    {
+        $this->expectException(\UnexpectedValueException::class);
+        Eds::decode($this->response(2136), '/db');
+    }
+}
