diff --git a/src/Internal/LongPoll.php b/src/Internal/LongPoll.php
new file mode 100644
index 0000000000000000000000000000000000000000..07e6e95d16bc97bf3c01526fec07f9c10cd84c26
--- /dev/null
+++ b/src/Internal/LongPoll.php
@@ -0,0 +1,294 @@
+<?php
+
+namespace YdbPlatform\Ydb\Internal;
+
+use Ydb\Discovery\ListEndpointsRequest;
+use Ydb\Discovery\ListEndpointsResponse;
+use Ydb\Discovery\ListEndpointsResult;
+use Ydb\StatusIds\StatusCode;
+use YdbPlatform\Ydb\Ydb;
+
+/** @internal One conditional ListEndpoints call on a reusable bootstrap connection. */
+final class LongPoll
+{
+    private $ydb;
+    private $url;
+    private $multi;
+    private $call;
+    private $tlsRoot;
+    private $proxy;
+    private $generation;
+    private $snapshot;
+    private $nextPoll = 0;
+    private $retryDelay = 0.1;
+    private $generations;
+    private $status;
+    private $body;
+    private $receivingReply = false;
+
+    public function __construct(Ydb $ydb, string $bootstrap, array $options)
+    {
+        if (!(curl_version()['features'] & CURL_VERSION_HTTP2)) {
+            throw new \RuntimeException('Long polling requires HTTP/2 support in the PHP curl extension');
+        }
+        if ($options || !preg_match('/^(?:[a-zA-Z0-9._-]+|\[[0-9a-fA-F:]+\]):[0-9]+$/D', $bootstrap)) {
+            throw new \InvalidArgumentException('Long polling requires host:port bootstrap and default gRPC channel options');
+        }
+        $this->ydb = $ydb;
+        $this->url = ($ydb->iam()->config('insecure') ? 'http://' : 'https://') . $bootstrap
+            . '/Ydb.Discovery.V1.DiscoveryService/ListEndpoints';
+        $this->proxy = self::proxyFor(trim(parse_url($this->url, PHP_URL_HOST), '[]'));
+        if (!$ydb->iam()->config('insecure')) {
+            $this->tlsRoot = self::rootFile($ydb->iam()->config('root_cert_file'));
+        }
+        $this->multi = curl_multi_init();
+    }
+
+    /** Match the trust anchor selection of the native gRPC bootstrap stub. */
+    public static function rootFile(?string $configured): string
+    {
+        $path = $configured ?: getenv('GRPC_DEFAULT_SSL_ROOTS_FILE_PATH');
+        if (!$path) {
+            if (\Grpc\ChannelCredentials::isDefaultRootsPemSet()) {
+                // The extension exposes no getter for an application-installed PEM.
+                throw new \InvalidArgumentException('Set root_cert_file for discovery with process-wide gRPC roots');
+            }
+            $stub = new \ReflectionClass(\Grpc\BaseStub::class);
+            $path = dirname($stub->getFileName(), 3) . '/etc/roots.pem';
+        }
+        if (!is_file($path) || !is_readable($path)) {
+            throw new \InvalidArgumentException('Cannot read the gRPC discovery trust roots');
+        }
+        return $path;
+    }
+
+    public static function proxyFor(string $host): string
+    {
+        if (getenv('GRPC_ADDRESS_HTTP_PROXY') && getenv('GRPC_ADDRESS_HTTP_PROXY_ENABLED_ADDRESSES')) {
+            throw new \InvalidArgumentException('Address-based gRPC proxy mapping requires native discovery');
+        }
+        $proxy = false;
+        foreach (['grpc_proxy', 'https_proxy', 'http_proxy'] as $key) {
+            $proxy = getenv($key);
+            if ($proxy !== false) {
+                break;
+            }
+        }
+        if (!$proxy) {
+            return '';
+        }
+        $bypass = getenv('no_grpc_proxy');
+        if ($bypass === false) {
+            $bypass = getenv('no_proxy');
+        }
+        foreach (explode(',', (string)$bypass) as $entry) {
+            $entry = trim($entry);
+            if ($entry !== '' && (strcasecmp(substr($host, -strlen($entry)), $entry) === 0
+                || self::inSubnet($host, $entry))) {
+                return '';
+            }
+        }
+        if (parse_url($proxy, PHP_URL_SCHEME) !== 'http' || !parse_url($proxy, PHP_URL_HOST)) {
+            throw new \InvalidArgumentException('Invalid gRPC HTTP CONNECT proxy');
+        }
+        return $proxy;
+    }
+
+    private static function inSubnet(string $host, string $entry): bool
+    {
+        $parts = explode('/', $entry, 2);
+        if (count($parts) !== 2 || !ctype_digit($parts[1])) {
+            return false;
+        }
+        $ip = inet_pton($host);
+        $network = inet_pton($parts[0]);
+        $bits = (int)$parts[1];
+        if ($ip === false || $network === false || strlen($ip) !== strlen($network) || $bits > strlen($ip) * 8) {
+            return false;
+        }
+        $bytes = intdiv($bits, 8);
+        $tail = $bits % 8;
+        return substr($ip, 0, $bytes) === substr($network, 0, $bytes) &&
+            ($tail === 0 || ((ord($ip[$bytes]) ^ ord($network[$bytes])) >> (8 - $tail)) === 0);
+    }
+
+    public static function generation(array $values, ?string $previous): ?string
+    {
+        if (!$values && $previous === null) {
+            return null;
+        }
+        if (count($values) !== 1 || !ctype_digit($values[0])
+            || bccomp($values[0], '18446744073709551615', 0) > 0
+            || ($previous !== null && bccomp($values[0], $previous, 0) < 0)) {
+            throw new \UnexpectedValueException('Invalid or stale managed route generation');
+        }
+        return ltrim($values[0], '0') ?: '0';
+    }
+
+    private function start()
+    {
+        $headers = ['content-type: application/grpc', 'te: trailers', 'expect:', 'x-ydb-discovery-long-poll: 1'];
+        foreach ($this->ydb->meta() as $key => $values) {
+            foreach ($values as $value) {
+                if (preg_match('/[\r\n]/', $value)) {
+                    throw new \InvalidArgumentException('Invalid discovery metadata');
+                }
+                $headers[] = "$key: $value";
+            }
+        }
+        if ($this->generation !== null) {
+            $headers[] = 'x-ydb-if-route-generation: ' . $this->generation;
+        }
+        $request = (new ListEndpointsRequest(['database' => $this->ydb->database()]))->serializeToString();
+        $this->body = '';
+        $this->receivingReply = false;
+        $this->generations = [];
+        $this->status = null;
+        $this->call = curl_init($this->url);
+        $options = [
+            CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_2_PRIOR_KNOWLEDGE,
+            CURLOPT_HTTPHEADER => $headers, CURLOPT_NOSIGNAL => true,
+            CURLOPT_PROXY => $this->proxy, CURLOPT_HTTPPROXYTUNNEL => true,
+            CURLOPT_NOPROXY => '', CURLOPT_HEADEROPT => CURLHEADER_SEPARATE,
+            CURLOPT_TIMEOUT_MS => 45000,
+            CURLOPT_POSTFIELDS => pack('CN', 0, strlen($request)) . $request,
+            CURLOPT_HEADERFUNCTION => function ($curl, $line) {
+                if (strncmp($line, 'HTTP/', 5) === 0) {
+                    // HTTP CONNECT uses a separate response before the HTTP/2 RPC.
+                    $this->receivingReply = strncmp($line, 'HTTP/2 ', 7) === 0;
+                    $this->generations = [];
+                    $this->status = null;
+                } elseif ($this->receivingReply && ($pos = strpos($line, ':')) !== false) {
+                    $key = strtolower(substr($line, 0, $pos));
+                    $value = trim(substr($line, $pos + 1));
+                    if ($key === 'x-ydb-route-generation') {
+                        $this->generations[] = $value;
+                    } elseif ($key === 'grpc-status') {
+                        $this->status = $value;
+                    }
+                }
+                return strlen($line);
+            },
+            CURLOPT_WRITEFUNCTION => function ($curl, $chunk) {
+                if (strlen($this->body) + strlen($chunk) > 4194309) {
+                    return 0;
+                }
+                $this->body .= $chunk;
+                return strlen($chunk);
+            }
+        ];
+        if ($this->tlsRoot) {
+            $options[CURLOPT_CAINFO] = $this->tlsRoot;
+            // libcurl also loads hashed roots from its system CA directory.
+            // Our installed PHP source directory contains no hashed CAs.
+            $options[CURLOPT_CAPATH] = __DIR__;
+        }
+        curl_setopt_array($this->call, $options);
+        curl_multi_add_handle($this->multi, $this->call);
+    }
+
+    private function accept()
+    {
+        $frame = strlen($this->body) >= 5 ? unpack('Ccompressed/Nlength', substr($this->body, 0, 5)) : null;
+        if ($this->status !== '0' || !$frame || $frame['compressed'] || $frame['length'] !== strlen($this->body) - 5) {
+            throw new \RuntimeException('ListEndpoints long poll failed');
+        }
+        $generation = self::generation($this->generations, $this->generation);
+        $response = new ListEndpointsResponse();
+        $response->mergeFromString(substr($this->body, 5));
+        $op = $response->getOperation();
+        if (!$op || !$op->getReady() || $op->getStatus() !== StatusCode::SUCCESS || !$op->getResult()
+            || $op->getResult()->getTypeUrl() !== 'type.googleapis.com/Ydb.Discovery.ListEndpointsResult') {
+            throw new \RuntimeException('Unsuccessful ListEndpoints operation');
+        }
+        $result = new ListEndpointsResult();
+        $result->mergeFromString($op->getResult()->getValue());
+        $this->snapshot = json_decode($result->serializeToJsonString(), true)['endpoints'] ?? [];
+        $this->generation = $generation;
+        $this->retryDelay = 0.1;
+        $this->nextPoll = $generation === null ? microtime(true) + $this->ydb->discoveryInterval() : 0;
+    }
+
+    private function closeCall()
+    {
+        if ($this->call) {
+            curl_multi_remove_handle($this->multi, $this->call);
+            curl_close($this->call);
+            $this->call = null;
+        }
+    }
+
+    private function advance()
+    {
+        if (!$this->call && microtime(true) >= $this->nextPoll) {
+            $this->start();
+        }
+        if (!$this->call) {
+            return;
+        }
+        do {
+            $code = curl_multi_exec($this->multi, $running);
+            $finished = curl_multi_info_read($this->multi);
+        } while (!$finished && ($code === CURLM_CALL_MULTI_PERFORM
+            || ($code === CURLM_OK && curl_multi_select($this->multi, 0) > 0)));
+        if (!$finished && $code === CURLM_OK) {
+            return;
+        }
+        $this->closeCall();
+        if ($code !== CURLM_OK || $finished['result'] !== CURLE_OK) {
+            throw new \RuntimeException('Discovery bootstrap unavailable');
+        }
+        $this->accept();
+        // Start the next held call before returning to the application.
+        if ($this->generation !== null) {
+            $this->start();
+            curl_multi_exec($this->multi, $running);
+        }
+    }
+
+    public function poll(int $timeoutMs): array
+    {
+        $deadline = microtime(true) + $timeoutMs / 1000;
+        do {
+            try {
+                $this->advance();
+            } catch (\Throwable $error) {
+                $this->closeCall();
+                $this->nextPoll = microtime(true) + $this->retryDelay;
+                $this->retryDelay = min(5, 2 * $this->retryDelay);
+                if ($this->generation === null && $this->snapshot) {
+                    return [null, $this->snapshot];
+                }
+                $this->snapshot = null;
+                throw $error;
+            }
+            // gRPC trailers can carry the generation in a separate HTTP/2 frame.
+            // Once a managed reply has started, data dispatch must wait for its
+            // trailers. The event loop's nonblocking tick can finish it later.
+            $receiving = $this->call && $this->generation !== null && $this->receivingReply;
+            if ($this->snapshot !== null && (!$receiving || $timeoutMs === 0)) {
+                return [$this->generation, $this->snapshot];
+            }
+            if (microtime(true) >= $deadline) {
+                if ($receiving && $timeoutMs > 0) {
+                    $this->snapshot = null;
+                }
+                break;
+            }
+            if ($this->call) {
+                curl_multi_select($this->multi, min(0.05, max(0, $deadline - microtime(true))));
+            } else {
+                usleep(10000);
+            }
+        } while (microtime(true) < $deadline);
+        throw new \RuntimeException('Timed out waiting for endpoint discovery');
+    }
+
+    public function __destruct()
+    {
+        $this->closeCall();
+        if ($this->multi) {
+            curl_multi_close($this->multi);
+        }
+    }
+}
