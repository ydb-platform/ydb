+            public $busy = false;
+            public $meta = [];
+            public function checkDiscovery() {}
+            public function take() { $this->busy = true; }
+            public function release() { $this->busy = false; }
+            public function buildGrpcOptions() { return []; }
+            public function read() { return $this->doStreamRequest('Table', 'StreamReadTable', ['skip_get_token'=>true]); }
+            public function __construct() {
+                $this->client = new class {
+                    public function StreamReadTable($request, $meta, $opts) {
+                        return new class {
+                            public function responses() { throw new \RuntimeException('stream retired'); yield; }
+                        };
+                    }
+                };
+            }
+        };
+        try {
+            $service->read()->current();
+            self::fail('Expected stream retirement');
+        } catch (\RuntimeException $error) {
+            self::assertSame('stream retired', $error->getMessage());
+        }
+        self::assertFalse($service->busy);
+    }
