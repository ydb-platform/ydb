+            throw new \RuntimeException('Missing or stale EDS route generation');
+        }
+        $this->floor = $generation;
+    }
+
+    private function receive(string $chunk)
+    {
+        $this->recv .= $chunk;
+        while (strlen($this->recv) >= 5) {
+            $frame = unpack('Ccompressed/Nlength', substr($this->recv, 0, 5));
+            if ($frame['compressed'] || $frame['length'] > self::MAX_MESSAGE) {
+                throw new \RuntimeException('Invalid discovery gRPC frame');
+            }
+            if (strlen($this->recv) < 5 + $frame['length']) {
+                return;
+            }
+            $message = substr($this->recv, 5, $frame['length']);
+            $this->recv = substr($this->recv, 5 + $frame['length']);
+            $this->verify();
