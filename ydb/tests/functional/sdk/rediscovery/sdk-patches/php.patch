+    public function testTwoDriversShareDataSocketUntilLastRouteRetires()
+    {
+        $listener = stream_socket_server('tcp://127.0.0.1:0');
+        $endpoint = stream_socket_get_name($listener, false);
+        $drivers = $clients = [];
+        for ($i = 0; $i < 2; ++$i) {
+            $driver = new \YdbPlatform\Ydb\Ydb([
+                'endpoint' => $endpoint,
+                'database' => '/db' . $i,
+                'iam_config' => ['anonymous' => true, 'insecure' => true],
+            ]);
+            // Both drivers have received an assignment for this node.
+            foreach (['longPoll' => true, 'routeSnapshot' => ['1', []], 'routeStreams' => new \SplObjectStorage()] as $key => $value) {
+                $field = new \ReflectionProperty($driver, $key);
+                $field->setAccessible(true);
+                $field->setValue($driver, $value);
+            }
+            $drivers[] = $driver;
+            $clients[] = $driver->serviceClient(\Ydb\Table\V1\TableServiceClient::class);
+        }
+
+        $clients[0]->getConnectivityState(true);
+        $peer = stream_socket_accept($listener, 3);
+        self::assertTrue(is_resource($peer));
+        // HTTP/2 SETTINGS. Only this socket gets a handshake.
+        fwrite($peer, "\x00\x00\x00\x04\x00\x00\x00\x00\x00");
+        try {
+            self::assertTrue($clients[0]->waitForReady(3000000));
+            self::assertTrue($clients[1]->waitForReady(3000000), 'Sibling should reuse the established data socket');
+            $close = new \ReflectionMethod($driver, 'closeRouteChannel');
+            $close->setAccessible(true);
+            $close->invoke($drivers[0]);
+            self::assertSame(\Grpc\CHANNEL_READY, $clients[1]->getConnectivityState());
+            $close->invoke($drivers[1]);
+            stream_set_timeout($peer, 3);
+            stream_get_contents($peer);
+            self::assertTrue(feof($peer), 'Last route retirement should close the TCP socket');
+        } finally {
+            fclose($peer);
+            fclose($listener);
+        }
+    }
