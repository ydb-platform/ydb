+@pytest.mark.parametrize("async_driver", [False, True])
+@pytest.mark.parametrize("roll_back_after_ready", [False, True])
+def test_rotate_bootstrap_with_one_socket_and_keep_managed_floor(async_driver, roll_back_after_ready):
+    from unittest.mock import patch
+
+    class Bootstrap(unary.DiscoveryServiceServicer):
+        def __init__(self, primary):
+            self.primary = primary
+
+        def ListEndpoints(self, request, context):
+            headers = dict(context.invocation_metadata())
+            assert request.database == "/database" and headers["x-ydb-auth-ticket"] == "ticket"
+            generation = 1 if self.primary else 2
+            if self.primary and not roll_back_after_ready:
+                context.abort(grpc.StatusCode.UNAVAILABLE, "primary unavailable at start")
+            if self.primary and "x-ydb-if-route-generation" in headers:
+                while context.is_active() and not lose_capability.wait(0.01):
+                    pass
+                generation = None
+            elif not self.primary:
+                alternate_headers.append(headers)
+                if headers.get("x-ydb-if-route-generation") == "2":
+                    while context.is_active():
+                        threading.Event().wait(0.01)
+                else:
+                    while context.is_active() and not allow_alternate.wait(0.01):
+                        pass
+            if generation is not None:
+                context.set_trailing_metadata((("x-ydb-route-generation", str(generation)),))
+            result = _apis.ydb_discovery.ListEndpointsResult()
+            result.endpoints.add(address="127.0.0.1", port=ports[2 if self.primary else 3], node_id=1)
+            reply = _apis.ydb_discovery.ListEndpointsResponse()
+            reply.operation.ready = True
+            reply.operation.status = 400000
+            reply.operation.result.Pack(result)
+            return reply
+
+    async def run():
+        async def wait_until(check):
+            async def wait():
+                while not check():
+                    await asyncio.sleep(0.01)
+
+            await asyncio.wait_for(wait(), 6)
+
+        for server in servers:
+            server.start()
+        config = ydb.DriverConfig(
+            f"127.0.0.1:{ports[0]}",
+            "/database",
+            endpoints=[f"127.0.0.1:{ports[1]}"],
+            use_long_poll=True,
+            auth_token="ticket",
+        )
+        discovery_owner = ydb.aio.pool.Discovery if async_driver else ydb.pool.Discovery
+        with patch.object(discovery_owner, "_emergency_retry_interval", return_value=0.02):
+            driver = (ydb.aio.Driver if async_driver else ydb.Driver)(config)
+            try:
+                if roll_back_after_ready:
+                    await wait_until(lambda: bool(driver._store.connections))
+                    assert list(driver._store.connections) == [f"127.0.0.1:{ports[2]}"]
+                    lose_capability.set()
+                await wait_until(lambda: bool(alternate_headers))
+                assert alternate_headers[0].get("x-ydb-if-route-generation") == ("1" if roll_back_after_ready else None)
+                assert not driver._store.connections
+                if Path("/proc/net/tcp").exists():
+                    assert not established(ports[0]) and not established(ports[2])
+                allow_alternate.set()
+                await wait_until(lambda: list(driver._store.connections) == [f"127.0.0.1:{ports[3]}"])
+            finally:
+                allow_alternate.set()
+                lose_capability.set()
+                if async_driver:
+                    await driver.stop()
+                else:
+                    await asyncio.to_thread(driver.stop)
+        if Path("/proc/net/tcp").exists():
+            await wait_until(lambda: not established(ports[1]))
+
+    servers = [grpc.server(ThreadPoolExecutor(max_workers=3)) for _ in range(4)]
+    ports = [s.add_insecure_port("127.0.0.1:0") for s in servers]
+    alternate_headers = []
+    lose_capability, allow_alternate = threading.Event(), threading.Event()
+    for index in (0, 1):
+        unary.add_DiscoveryServiceServicer_to_server(Bootstrap(primary=index == 0), servers[index])
+    try:
+        asyncio.run(run())
+    finally:
+        for server in servers:
+            server.stop(0).wait()
