+                assert driver._store.values()
+                replicas.server_cancel.set()
+                await assert_socket_closed(replicas.ports[0])
+                assert not driver._store.values()
+            finally:
+                if async_driver:
+                    await driver.stop()
+                else:
+                    await asyncio.to_thread(driver.stop)
+
+    asyncio.run(run())
