+@pytest.mark.parametrize("async_driver", [False, True])
+def test_refresh_while_poll_prepares_credentials(async_driver, monkeypatch):
+    from ydb import connection
+    from ydb.aio import connection as aio_connection
+
+    async def run():
+        with services(False) as (replicas, endpoint):
+            config = ydb.DriverConfig(endpoint, "/database", use_long_poll=True, credentials=ydb.AnonymousCredentials())
+            channel = (grpc.aio if async_driver else grpc).insecure_channel(endpoint)
+            watch = LongPoll(config, SimpleNamespace(_channel=channel))
+            watch.generation = 1
+            replicas.cut.set()  # Even an erroneously conditional request will return immediately.
+
+            def metadata(*args):
+                watch.refresh()
+                return []
+
+            async def aio_metadata(*args):
+                return metadata(*args)
+
+            try:
+                if async_driver:
+                    monkeypatch.setattr(aio_connection, "_construct_metadata", aio_metadata)
+                    result, generation = await watch.poll_async(lambda: False)
+                else:
+                    monkeypatch.setattr(connection, "_construct_metadata", metadata)
+                    result, generation = await asyncio.to_thread(watch.poll, lambda: False)
+                assert result.endpoints and generation == 2
+                assert [r.get("x-ydb-if-route-generation") for r in replicas.requests] == [None]
+            finally:
+                if async_driver:
+                    await channel.close()
+                else:
+                    channel.close()
+
+    asyncio.run(run())
+
