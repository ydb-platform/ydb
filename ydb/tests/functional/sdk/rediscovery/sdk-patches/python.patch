+@pytest.mark.parametrize("async_driver", [False, True])
+def test_same_data_listener_across_generations(async_driver):
+    resume = threading.Event()
+
+    async def run():
+        async def call(fn, *args):
+            return await fn(*args) if async_driver else await asyncio.to_thread(fn, *args)
+
+        with query_services(resume) as (replicas, endpoint):
+            old_port, dest_port = replicas.ports
+            backend = old_port
+            clients = []
+
+            async def proxy(reader, client):
+                clients.append(client)
+                upstream, peer = await asyncio.open_connection("127.0.0.1", backend)
+
+                async def relay(incoming, outgoing):
+                    try:
+                        while data := await incoming.read(65536):
+                            outgoing.write(data)
+                            await outgoing.drain()
+                    finally:
+                        outgoing.close()
+
+                await asyncio.gather(relay(reader, peer), relay(upstream, client))
+
+            async with await asyncio.start_server(proxy, "127.0.0.1", 0) as listener:
+                port = listener.sockets[0].getsockname()[1]
+                replicas.ports = [port, port]
+                driver = (ydb.aio.Driver if async_driver else ydb.Driver)(
+                    ydb.DriverConfig(endpoint, "/database", use_eds=True, credentials=ydb.AnonymousCredentials())
+                )
+                try:
+                    await call(driver.wait, 5)
+                    held = await call(
+                        driver, _apis.ydb_query.AttachSessionRequest(), _apis.QueryService.Stub, "AttachSession"
+                    )
+                    read = anext if async_driver else next
+                    assert (await call(read, held)).status == 400000
+                    backend = dest_port
+                    replicas.generation = 2
+                    replicas.switch.set()
+                    for _ in range(250):
+                        if len(replicas.requests) >= 2 and driver._store.values():
+                            break
+                        await asyncio.sleep(0.01)
+                    assert len(replicas.requests) >= 2 and driver._store.values()
+                    fresh = await call(
+                        driver, _apis.ydb_query.CreateSessionRequest(), _apis.QueryService.Stub, "CreateSession"
+                    )
+                    assert fresh.session_id == "new"
+                    late = (ydb.aio.Driver if async_driver else ydb.Driver)(
+                        ydb.DriverConfig(endpoint, "/database", use_eds=True, credentials=ydb.AnonymousCredentials())
+                    )
+                    try:
+                        await call(late.wait, 5)
+                        new_driver = await call(
+                            late, _apis.ydb_query.CreateSessionRequest(), _apis.QueryService.Stub, "CreateSession"
+                        )
+                        assert new_driver.session_id == "new"
+                    finally:
+                        await call(late.stop)
+                    resume.set()
+                    assert (await call(read, held)).status == 400001
+                finally:
+                    resume.set()
+                    await call(driver.stop)
+                    for client in clients:
+                        client.close()
+
+    asyncio.run(asyncio.wait_for(run(), 15))
+
