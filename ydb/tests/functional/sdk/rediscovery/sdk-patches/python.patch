+@pytest.mark.parametrize("cancel", [False, True])
+def test_interceptor_generator_releases_stream_ownership(cancel):
+    from ydb.connection import Connection
+
+    class InterceptedTable:
+        def __init__(self, channel):
+            pass
+
+        def StreamReadTable(self, *args, **kwargs):
+            yield 1
+
+    config = ydb.DriverConfig("localhost:1", "/database", use_eds=True, credentials=ydb.AnonymousCredentials())
+    data = Connection(config.endpoint, config)
+    try:
+        held = data(_apis.ydb_table.ReadTableRequest(), InterceptedTable, "StreamReadTable")
+        assert next(held) == 1
+        data.close()
+        assert data._channel is not None
+        if cancel:
+            held.cancel()
+        else:
+            assert list(held) == []
+        assert data._channel is None
+    finally:
+        data.close()
