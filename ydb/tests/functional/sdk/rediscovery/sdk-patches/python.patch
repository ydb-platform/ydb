index 0000000000000000000000000000000000000000..fc8cdf1c9675b5994f455ee33141fcd7b50b8c0f
--- /dev/null
+++ b/ydb/_long_poll.py
@@ -0,0 +1,92 @@
+"""Conditional ListEndpoints on the driver's bootstrap channel."""
+
+import asyncio
+import threading
+from contextlib import contextmanager
+from itertools import cycle
+
+import grpc
+
+from . import _apis, connection, resolver
+from .aio import connection as aio_connection
+
+
+class LongPoll:
+    def __init__(self, config, bootstrap):
+        self.config = config
+        self.bootstrap = bootstrap
+        alternates = list(dict.fromkeys(endpoint for endpoint in config.endpoints if endpoint != config.endpoint))
+        self.alternates = cycle(alternates + [config.endpoint]) if alternates else None
+        self.generation = None
+        self.active = None
+        self.refresh_pending = False
+        self.lock = threading.Lock()
+
+    def next_bootstrap(self):
+        self.bootstrap = type(self.bootstrap)(next(self.alternates), self.config)
+
+    def options(self):
+        headers = [("x-ydb-discovery-long-poll", "1")]
+        timeout = self.config.discovery_request_timeout
+        if self.generation is not None and not self.refresh_pending:
+            headers.append(("x-ydb-if-route-generation", str(self.generation)))
+            timeout = max(45, timeout)
+        return headers, timeout
+
+    def result(self, response, headers, trailers):
+        values = [v for k, v in (*headers, *trailers) if k == "x-ydb-route-generation"]
+        generation = None
+        if values or self.generation is not None:
+            if len(values) != 1 or not values[0].isascii() or not values[0].isdigit():
+                raise ValueError("Missing or invalid route generation")
+            generation = int(values[0])
+            if generation >= 2**64 or (self.generation is not None and generation < self.generation):
+                raise ValueError("Invalid or stale route generation")
+        result = resolver.DiscoveryResult.from_response(None, response, self.config.use_all_nodes)
+        return result, generation
+
+    def cancel(self):
+        with self.lock:
+            if self.active is not None:
+                self.active.cancel()
+
+    def refresh(self):
+        with self.lock:
+            self.refresh_pending = True
+            if self.active is not None and self.active.cancel():
+                self.active = None
+
+    @contextmanager
+    def _request(self, rpc, metadata, stopped):
+        with self.lock:
+            if stopped():
+                raise RuntimeError("Driver stopped")
+            headers, timeout = self.options()
+            self.refresh_pending = False
+            self.active = call = rpc(
+                resolver._list_endpoints_request_factory(self.config), metadata=metadata + headers, timeout=timeout
+            )
+        try:
+            yield call
+        except (grpc.FutureCancelledError, asyncio.CancelledError):
+            # Only refresh() clears an active RPC after successfully cancelling it.
+            with self.lock:
+                if self.active is call or stopped():
+                    raise
+        finally:
+            with self.lock:
+                self.active = None
+
+    def poll(self, stopped):
+        while True:
+            metadata = connection._construct_metadata(self.config, None)
+            rpc = _apis.DiscoveryService.Stub(self.bootstrap._channel).ListEndpoints.future
+            with self._request(rpc, metadata, stopped) as call:
+                return self.result(call.result(), call.initial_metadata(), call.trailing_metadata())
+
+    async def poll_async(self, stopped):
+        while True:
+            metadata = await aio_connection._construct_metadata(self.config, None)
+            rpc = _apis.DiscoveryService.Stub(self.bootstrap._channel).ListEndpoints
+            with self._request(rpc, metadata, stopped) as call:
+                return self.result(await call, await call.initial_metadata(), await call.trailing_metadata())
