+@pytest.mark.parametrize("async_driver", [False, True])
+def test_two_drivers_share_the_data_socket(async_driver):
+    async def check(replicas, endpoint):
+        async with AsyncExitStack() as cleanup:
+            streams = []
+            for _ in range(2):
+                config = ydb.DriverConfig(endpoint, "/db", credentials=ydb.AnonymousCredentials(), use_long_poll=True)
+                args = (_apis.ydb_query.AttachSessionRequest(), _apis.QueryService.Stub, "AttachSession")
+                if async_driver:
+                    driver = await cleanup.enter_async_context(ydb.aio.Driver(config))
+                    await driver.wait(timeout=5)
+                    stream = await driver(*args)
+                    await anext(stream)
+                else:
+                    driver = ydb.Driver(config)
+                    cleanup.push_async_callback(asyncio.to_thread, driver.stop)
+                    await asyncio.to_thread(driver.wait, 5)
+                    stream = await asyncio.to_thread(driver, *args)
+                    await asyncio.to_thread(next, stream)
+                streams.append(stream)
+            assert len(replicas.attach_peers) == 2
+            assert len(set(replicas.attach_peers)) == 1
+
+    with services(legacy=False) as (replicas, endpoint):
+        asyncio.run(check(replicas, endpoint))
+
