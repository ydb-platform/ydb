+@pytest.mark.parametrize("async_driver", [False, True])
+def test_remote_conditional_cancellation_retires_route(async_driver):
+    async def run():
+        with services(False) as (replicas, endpoint):
+            config = ydb.DriverConfig(endpoint, "/database", use_long_poll=True, credentials=ydb.AnonymousCredentials())
+            driver = (ydb.aio.Driver if async_driver else ydb.Driver)(config)
+            try:
