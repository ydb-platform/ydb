+@pytest.mark.parametrize("async_driver", [False, True])
+@pytest.mark.parametrize("replace_snapshot", [False, True])
+def test_cutover_drains_active_source_stream(async_driver, replace_snapshot):
+    resume = threading.Event()
+
+    async def run():
+        async def call(fn, *args):
+            return await fn(*args) if async_driver else await asyncio.to_thread(fn, *args)
+
+        with query_services(resume) as (replicas, endpoint):
+            replicas.replace_snapshot = replace_snapshot
+            config = ydb.DriverConfig(endpoint, DATABASE, use_eds=True, credentials=ydb.AnonymousCredentials())
+            driver = (ydb.aio.Driver if async_driver else ydb.Driver)(config)
+            try:
+                await call(driver.wait, 5)
+                held = await call(
+                    driver, _apis.ydb_query.AttachSessionRequest(), _apis.QueryService.Stub, "AttachSession"
+                )
+                read = anext if async_driver else next
+                assert (await call(read, held)).status == 400000
+                replicas.generation = 2
+                replicas.switch.set()
+                for _ in range(150):
+                    if list(driver._store.connections) == [f"localhost:{replicas.ports[1]}"]:
+                        break
+                    await asyncio.sleep(0.02)
+                assert list(driver._store.connections) == [f"localhost:{replicas.ports[1]}"]
+                fresh = await call(
+                    driver, _apis.ydb_query.CreateSessionRequest(), _apis.QueryService.Stub, "CreateSession"
+                )
+                assert fresh.session_id == "new"
+                resume.set()
+                assert (await call(read, held)).status == 400001
+            finally:
+                resume.set()
+                await call(driver.stop)
+
+    asyncio.run(run())
+
