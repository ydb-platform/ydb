@@ -0,0 +1,223 @@
+"""State-of-the-world endpoint discovery on the driver's bootstrap channel."""
+
+from __future__ import annotations
+
+import queue
+
+import grpc
+from envoy.config.endpoint.v3 import endpoint_pb2
+from envoy.service.discovery.v3 import discovery_pb2
+from envoy.service.endpoint.v3 import eds_pb2_grpc
+
+from . import _apis, connection, resolver
+from .aio import connection as aio_connection
+
+TYPE_URL = "type.googleapis.com/envoy.config.endpoint.v3.ClusterLoadAssignment"
+GENERATION = "x-ydb-route-generation"
+MODE = "x-ydb-route-mode"
+
+
+class InvalidAssignment(ValueError):
+    pass
+
+
+class Route:
+    def __init__(self, config):
+        self.config = config
+        self.floor = None
+        self.require_current = False
+
+    def headers(self):
+        result = []
+        if self.floor is not None:
+            result.append(("x-ydb-min-route-generation", str(self.floor)))
+        if self.require_current:
+            result.append(("x-ydb-require-current-route", "1"))
+        return result
+
+    def verify(self, metadata):
+        headers = dict(metadata or ())
+        mode = headers.get(MODE)
+        if mode is None and GENERATION not in headers and self.floor is None:
+            return
+        value = headers.get(GENERATION, "")
+        if mode not in ("managed", "legacy") or not value.isascii() or not value.isdecimal():
+            raise InvalidAssignment("Missing or invalid managed route metadata")
+        generation = int(value)
+        if self.floor is not None and generation < self.floor:
+            raise InvalidAssignment("Worker is behind the accepted route generation")
+        self.floor = generation
+
+    def lost(self, code, trailers):
+        value = dict(trailers or ()).get(GENERATION, "")
+        if (
+            self.floor is not None
+            and code == grpc.StatusCode.UNAVAILABLE
+            and value.isascii()
+            and value.isdecimal()
+            and int(value) >= self.floor
+        ):
+            self.floor = int(value)
+            self.require_current = False
+        else:
+            self.require_current = True
+
+    def request(self, version="", nonce="", error=""):
+        request = discovery_pb2.DiscoveryRequest(
+            version_info=version, response_nonce=nonce, type_url=TYPE_URL, resource_names=[self.config.database]
+        )
+        if not nonce:
+            request.node.id = "ydb-python-sdk"
+        if error:
+            request.error_detail.code = 3
+            request.error_detail.message = error
+        return request
+
+    def assignment(self, response):
+        if (
+            response.type_url != TYPE_URL
+            or not response.version_info
+            or not response.nonce
+            or len(response.resources) != 1
+            or response.resources[0].type_url != TYPE_URL
+        ):
+            raise InvalidAssignment("Expected one versioned ClusterLoadAssignment")
+        assignment = endpoint_pb2.ClusterLoadAssignment()
+        if (
+            not response.resources[0].Unpack(assignment)
+            or assignment.cluster_name != self.config.database
+            or len(assignment.endpoints) != 1
+        ):
+            raise InvalidAssignment("Assignment does not match the requested database")
+        group = assignment.endpoints[0]
+        result = _apis.ydb_discovery.ListEndpointsResult()
+        typed = group.metadata.typed_filter_metadata
+        if (
+            "ydb.discovery" not in typed
+            or not typed["ydb.discovery"].Unpack(result)
+            or len(group.lb_endpoints) != len(result.endpoints)
+        ):
+            raise InvalidAssignment("Invalid YDB endpoint metadata")
+        for lb, ep in zip(group.lb_endpoints, result.endpoints):
+            socket = lb.endpoint.address.socket_address
+            if (
+                socket.protocol
+                or not socket.address
+                or socket.address != ep.address
+                or socket.port_value != ep.port
+                or not 0 < ep.port <= 65535
+            ):
+                raise InvalidAssignment("EDS address disagrees with the YDB endpoint")
+        self.require_current = False
+        return resolver.DiscoveryResult.from_result(result, self.config.use_all_nodes)
+
+    def unary_result(self, response, headers):
+        self.verify(headers)
+        result = resolver.DiscoveryResult.from_response(None, response, self.config.use_all_nodes)
+        self.require_current = False
+        return result
+
+
+class SyncWatch:
+    def __init__(self, route, channel):
+        self.route = route
+        self.channel = channel
+        self.active = None
+
+    def cancel(self):
+        active = self.active
+        if active is not None:
+            active.cancel()
+
+    def subscribe(self, apply, stopped):
+        route = self.route
+        requests = queue.Queue()
+        requests.put(route.request())
+        metadata = connection._construct_metadata(route.config, None) + route.headers()
+        call = eds_pb2_grpc.EndpointDiscoveryServiceStub(self.channel).StreamEndpoints(
+            iter(requests.get, None), metadata=metadata
+        )
+        self.active = call
+        try:
+            if stopped():
+                return False
+            route.verify(call.initial_metadata())
+            version = ""
+            for response in call:
+                try:
+                    resolved = route.assignment(response)
+                except InvalidAssignment as error:
+                    requests.put(route.request(version, response.nonce, str(error)))
+                    continue
+                apply(resolved)
+                version = response.version_info
+                requests.put(route.request(version, response.nonce))
+            route.lost(call.code(), call.trailing_metadata())
+        except grpc.RpcError as error:
+            if error.code() == grpc.StatusCode.UNIMPLEMENTED:
+                route.verify(error.initial_metadata())
+                metadata = connection._construct_metadata(route.config, None) + route.headers()
+                unary = _apis.DiscoveryService.Stub(self.channel).ListEndpoints
+                response, rpc = unary.with_call(
+                    resolver._list_endpoints_request_factory(route.config),
+                    metadata=metadata,
+                    timeout=route.config.discovery_request_timeout,
+                )
+                return apply(route.unary_result(response, rpc.initial_metadata()))
+            route.lost(error.code(), error.trailing_metadata())
+            raise
+        finally:
+            call.cancel()
+            requests.put(None)
+            self.active = None
+        return False
+
+
+class AsyncWatch:
+    def __init__(self, route, channel):
+        self.route = route
+        self.channel = channel
+        self.active = None
+
+    def cancel(self):
+        if self.active is not None:
+            self.active.cancel()
+
+    async def subscribe(self, apply, stopped):
+        route = self.route
+        metadata = await aio_connection._construct_metadata(route.config, None) + route.headers()
+        call = eds_pb2_grpc.EndpointDiscoveryServiceStub(self.channel).StreamEndpoints(metadata=metadata)
+        self.active = call
+        try:
+            if stopped():
+                return False
+            await call.write(route.request())
+            route.verify(await call.initial_metadata())
+            version = ""
+            async for response in call:
+                try:
+                    resolved = route.assignment(response)
+                except InvalidAssignment as error:
+                    await call.write(route.request(version, response.nonce, str(error)))
+                    continue
+                await apply(resolved)
+                version = response.version_info
+                await call.write(route.request(version, response.nonce))
+            route.lost(await call.code(), await call.trailing_metadata())
+        except grpc.aio.AioRpcError as error:
+            if error.code() == grpc.StatusCode.UNIMPLEMENTED:
+                route.verify(error.initial_metadata())
+                metadata = await aio_connection._construct_metadata(route.config, None) + route.headers()
+                unary = _apis.DiscoveryService.Stub(self.channel).ListEndpoints(
+                    resolver._list_endpoints_request_factory(route.config),
+                    metadata=metadata,
+                    timeout=route.config.discovery_request_timeout,
+                )
+                response = await unary
+                return await apply(route.unary_result(response, await unary.initial_metadata()))
+            route.lost(error.code(), error.trailing_metadata())
+            raise
+        finally:
+            call.cancel()
+            self.active = None
+        return False
