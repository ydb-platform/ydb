diff --git a/ydb/eds_test.py b/ydb/eds_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..31a1dcceae7f6bf3a1a7ef3c497d7ac749832993
--- /dev/null
+++ b/ydb/eds_test.py
@@ -0,0 +1,127 @@
+"""Exercise both driver discovery owners with real gRPC channels."""
+
+import asyncio
+from concurrent.futures import ThreadPoolExecutor
+from contextlib import contextmanager
+import threading
+
+import grpc
+import pytest
+
+import ydb
+from ydb import _apis
+from ydb._grpc.common import ydb_discovery_v1_pb2_grpc as unary
+
+pytest.importorskip("envoy.service.discovery.v3.discovery_pb2")
+from envoy.service.discovery.v3 import discovery_pb2  # noqa: E402
+from envoy.service.endpoint.v3 import eds_pb2_grpc  # noqa: E402
+from envoy.config.endpoint.v3 import endpoint_pb2  # noqa: E402
+
+DATABASE = "/database"
+TYPE = "type.googleapis.com/envoy.config.endpoint.v3.ClusterLoadAssignment"
+
+
+class Replicas(eds_pb2_grpc.EndpointDiscoveryServiceServicer, unary.DiscoveryServiceServicer):
+    def __init__(self):
+        self.generation = 1
+        self.switch = threading.Event()
+        self.requests = []
+        self.unary_requests = []
+
+    def topology(self):
+        topology = _apis.ydb_discovery.ListEndpointsResult()
+        topology.endpoints.add(address="localhost", port=self.ports[self.generation - 1], node_id=1)
+        return topology
+
+    def StreamEndpoints(self, requests, context):
+        generation = self.generation
+        first = next(requests)
+        headers = dict(context.invocation_metadata())
+        self.requests.append((first, headers))
+        context.send_initial_metadata((("x-ydb-route-generation", str(generation)), ("x-ydb-route-mode", "managed")))
+        if self.legacy:
+            context.abort(grpc.StatusCode.UNIMPLEMENTED, "old server")
+        assignment = endpoint_pb2.ClusterLoadAssignment(cluster_name=DATABASE)
+        locality = assignment.endpoints.add()
+        topology = self.topology()
+        locality.metadata.typed_filter_metadata["ydb.discovery"].Pack(topology)
+        sock = locality.lb_endpoints.add().endpoint.address.socket_address
+        sock.address, sock.port_value = "localhost", self.ports[generation - 1]
+        response = discovery_pb2.DiscoveryResponse(type_url=TYPE, version_info="opaque", nonce="one")
+        response.resources.add().Pack(assignment)
+        yield response
+        ack = next(requests)
+        assert ack.version_info == "opaque" and ack.response_nonce == "one"
+        while context.is_active():
+            if generation == 1 and self.switch.wait(0.02):
+                context.set_trailing_metadata((("x-ydb-route-generation", "2"),))
+                context.abort(grpc.StatusCode.UNAVAILABLE, "cutover")
+            elif generation != 1:
+                threading.Event().wait(0.02)
+
+    def ListEndpoints(self, request, context):
+        self.unary_requests.append(dict(context.invocation_metadata()))
+        context.send_initial_metadata(
+            (("x-ydb-route-generation", str(self.generation)), ("x-ydb-route-mode", "managed"))
+        )
+        response = _apis.ydb_discovery.ListEndpointsResponse()
+        response.operation.ready = True
+        response.operation.status = 400000
+        response.operation.result.Pack(self.topology())
+        return response
+
+
+@contextmanager
+def services(legacy):
+    replicas = Replicas()
+    replicas.legacy = legacy
+    servers = [grpc.server(ThreadPoolExecutor(max_workers=4)) for _ in range(3)]
+    unary.add_DiscoveryServiceServicer_to_server(replicas, servers[0])
+    eds_pb2_grpc.add_EndpointDiscoveryServiceServicer_to_server(replicas, servers[0])
+    ports = [s.add_insecure_port("localhost:0") for s in servers]
+    replicas.ports = ports[1:]
+    try:
+        for s in servers:
+            s.start()
+        yield replicas, f"localhost:{ports[0]}"
+    finally:
+        for s in servers:
+            s.stop(0).wait()
+
+
+@pytest.mark.parametrize("async_driver", [False, True])
+@pytest.mark.parametrize("legacy", [False, True])
+def test_eds_discovery(async_driver, legacy):
+    async def run():
+        with services(legacy) as (replicas, endpoint):
+            config = ydb.DriverConfig(endpoint, DATABASE, use_eds=True, credentials=ydb.AnonymousCredentials())
+            driver = (ydb.aio.Driver if async_driver else ydb.Driver)(config)
+            try:
+                if async_driver:
+                    await driver.wait(timeout=5)
+                else:
+                    await asyncio.to_thread(driver.wait, 5)
+                assert len(replicas.requests) == 1
+                first, headers = replicas.requests[0]
+                assert first.type_url == TYPE and list(first.resource_names) == [DATABASE]
+                assert headers["x-ydb-database"] == DATABASE
+                assert list(driver._store.connections) == [f"localhost:{replicas.ports[0]}"]
+                if legacy:
+                    assert replicas.unary_requests[0]["x-ydb-min-route-generation"] == "1"
+                    return
+                replicas.generation = 2
+                replicas.switch.set()
+                for _ in range(150):
+                    if list(driver._store.connections) == [f"localhost:{replicas.ports[1]}"]:
+                        break
+                    await asyncio.sleep(0.02)
+                assert list(driver._store.connections) == [f"localhost:{replicas.ports[1]}"]
+                assert replicas.requests[1][1]["x-ydb-min-route-generation"] == "2"
+                assert not replicas.unary_requests
+            finally:
+                if async_driver:
+                    await driver.stop()
+                else:
+                    await asyncio.to_thread(driver.stop)
+
+    asyncio.run(run())
