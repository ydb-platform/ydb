+import asyncio
+from concurrent.futures import ThreadPoolExecutor
+from contextlib import contextmanager
+from pathlib import Path
+import threading
+
+from ydb._long_poll import LongPoll
+
+import grpc
+import pytest
+
+import ydb
+from ydb import _apis
+from ydb._grpc.common import ydb_discovery_v1_pb2_grpc as unary
+
+
+class Replicas(unary.DiscoveryServiceServicer):
+    def __init__(self, legacy):
+        self.legacy = legacy
+        self.cut = threading.Event()
+        self.requests = []
+        self.unary_started = threading.Event()
+        self.unary_finish = threading.Event()
+
+    def ListEndpoints(self, request, context):
+        headers = dict(context.invocation_metadata())
+        self.requests.append(headers)
+        if not self.legacy:
+            previous = headers.get("x-ydb-if-route-generation")
+            while context.is_active() and previous == str(1 + self.cut.is_set()):
+                threading.Event().wait(0.01)
+        generation = 1 + self.cut.is_set()
+        if not self.legacy:
+            context.set_trailing_metadata((("x-ydb-route-generation", str(generation)),))
+        result = _apis.ydb_discovery.ListEndpointsResult()
+        result.endpoints.add(address="127.0.0.1", port=self.ports[generation - 1], node_id=1)
+        response = _apis.ydb_discovery.ListEndpointsResponse()
+        response.operation.ready = True
+        response.operation.status = 400000
+        response.operation.result.Pack(result)
+        return response
+
+
+@contextmanager
+def services(legacy):
+    replicas = Replicas(legacy)
+    servers = [grpc.server(ThreadPoolExecutor(max_workers=4)) for _ in range(3)]
+    unary.add_DiscoveryServiceServicer_to_server(replicas, servers[0])
+
+    def attach(request, context):
+        yield _apis.ydb_query.SessionState(status=400000).SerializeToString()
+        while context.is_active():
+            threading.Event().wait(0.01)
+
+    def create(request, context):
+        context.add_callback(replicas.unary_finish.set)
+        replicas.unary_started.set()
+        replicas.unary_finish.wait(5)
+        return _apis.ydb_query.CreateSessionResponse(status=400000, session_id="old").SerializeToString()
+
+    def unavailable(request, context):
+        context.abort(grpc.StatusCode.UNAVAILABLE, "temporary transport failure")
+
+    query = grpc.method_handlers_generic_handler(
+        "Ydb.Query.V1.QueryService",
+        {
+            "AttachSession": grpc.unary_stream_rpc_method_handler(attach),
+            "CreateSession": grpc.unary_unary_rpc_method_handler(create),
+            "BeginTransaction": grpc.unary_unary_rpc_method_handler(unavailable),
+        },
+    )
+    for node in servers[1:]:
+        node.add_generic_rpc_handlers((query,))
+    ports = [s.add_insecure_port("127.0.0.1:0") for s in servers]
+    replicas.ports = ports[1:]
+    try:
+        for server in servers:
+            server.start()
+        yield replicas, f"127.0.0.1:{ports[0]}"
+    finally:
+        for server in servers:
+            server.stop(0).wait()
+
+
+def established(port):
+    return any(
+        int(fields[2].split(":")[1], 16) == port and fields[3] == "01"
+        for table in ("/proc/net/tcp", "/proc/net/tcp6")
+        if Path(table).exists()
+        for line in Path(table).read_text().splitlines()[1:]
+        if (fields := line.split())
+    )
+
+
+async def assert_socket_closed(port):
+    if Path("/proc/net/tcp").exists():
+        for _ in range(50):
+            if not established(port):
+                return
+            await asyncio.sleep(0.02)
+        pytest.fail(f"Retained stream kept the TCP socket to port {port} open")
+
+
+@pytest.mark.parametrize("async_driver", [False, True])
+@pytest.mark.parametrize("legacy", [False, True])
+def test_long_poll_cutover(async_driver, legacy):
+    async def run():
+        with services(legacy) as (replicas, endpoint):
+            config = ydb.DriverConfig(endpoint, "/database", use_long_poll=True, credentials=ydb.AnonymousCredentials())
+            driver = (ydb.aio.Driver if async_driver else ydb.Driver)(config)
+            try:
+                if async_driver:
+                    await driver.wait(timeout=5)
+                else:
+                    await asyncio.to_thread(driver.wait, 5)
+                assert replicas.requests[0]["x-ydb-discovery-long-poll"] == "1"
+                assert "x-ydb-if-route-generation" not in replicas.requests[0]
+                if legacy:
+                    await asyncio.sleep(0.1)
+                    assert len(replicas.requests) == 1
+                    return
+                attach_args = (_apis.ydb_query.AttachSessionRequest(), _apis.QueryService.Stub, "AttachSession")
+                if async_driver:
+                    held = await driver(*attach_args)
+                    await held.__anext__()
+                else:
+                    held = await asyncio.to_thread(driver, *attach_args)
+                    await asyncio.to_thread(next, held)
+                if Path("/proc/net/tcp").exists():
+                    assert established(replicas.ports[0])
+                # Simulate the Topic reader's background read. Its application
+                # keeps the error for later while the driver replaces the route.
+                if async_driver:
+                    abandoned = await driver(*attach_args)
+                    await anext(abandoned)
+                    del abandoned
+                    cancelled_stream = await driver(*attach_args)
+                    await anext(cancelled_stream)
+                    saved_read = asyncio.create_task(anext(cancelled_stream))
+                    await asyncio.sleep(0)
+                    cancelled_stream.cancel()
+                    with pytest.raises(asyncio.CancelledError) as saved_error:
+                        await saved_read
+                pending_read = asyncio.create_task(held.__anext__()) if async_driver else None
+                args = (_apis.ydb_query.CreateSessionRequest(), _apis.QueryService.Stub, "CreateSession")
+                call = asyncio.create_task(driver(*args) if async_driver else asyncio.to_thread(driver, *args))
+                assert await asyncio.to_thread(replicas.unary_started.wait, 3)
+                replicas.cut.set()
+                for _ in range(150):
+                    if len(replicas.requests) >= 3:
+                        break
+                    await asyncio.sleep(0.02)
+                assert [r.get("x-ydb-if-route-generation") for r in replicas.requests[:3]] == [None, "1", "2"]
+                assert list(driver._store.connections) == [f"127.0.0.1:{replicas.ports[1]}"]
+                with pytest.raises(ydb.Error):
+                    await asyncio.wait_for(call, 3)
+                if pending_read is not None:
+                    with pytest.raises(ydb.issues.ConnectionLost):
+                        await pending_read
+                await assert_socket_closed(replicas.ports[0])
+                if async_driver:
+                    assert isinstance(saved_error.value, asyncio.CancelledError)
+                    active = await driver(*attach_args)
+                    await anext(active)
+                else:
+                    active = await asyncio.to_thread(driver, *attach_args)
+                    await asyncio.to_thread(next, active)
+            finally:
+                if async_driver:
+                    await driver.stop()
+                else:
+                    await asyncio.to_thread(driver.stop)
+            await assert_socket_closed(replicas.ports[1])
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("async_driver", [False, True])
+@pytest.mark.parametrize("action", ["finish", "cutover", "stop"])
+def test_rpc_failure_allows_concurrent_call_until_route_retirement(async_driver, action):
+    async def run():
+        async def call(fn, *args):
+            return await fn(*args) if async_driver else await asyncio.to_thread(fn, *args)
+
+        with services(False) as (replicas, endpoint):
+            config = ydb.DriverConfig(endpoint, "/database", use_long_poll=True, credentials=ydb.AnonymousCredentials())
+            driver = (ydb.aio.Driver if async_driver else ydb.Driver)(config)
+            try:
+                await call(driver.wait, 5)
+                (source,) = driver._store.values()
+                healthy = asyncio.create_task(
+                    call(driver, _apis.ydb_query.CreateSessionRequest(), _apis.QueryService.Stub, "CreateSession")
+                )
+                assert await asyncio.to_thread(replicas.unary_started.wait, 3)
+                failing = asyncio.create_task(
+                    call(driver, _apis.ydb_query.BeginTransactionRequest(), _apis.QueryService.Stub, "BeginTransaction")
+                )
+                try:
+                    for _ in range(100):
+                        if source.closing:
+                            break
+                        await asyncio.sleep(0.01)
+                    assert source.closing
+                    if action == "finish":
+                        replicas.unary_finish.set()
+                        assert (await healthy).session_id == "old"
+                    else:
+                        if action == "cutover":
+                            replicas.cut.set()
+                        else:
+                            await call(driver.stop)
+                        with pytest.raises(ydb.Error):
+                            await asyncio.wait_for(healthy, 3)
+                        await assert_socket_closed(replicas.ports[0])
+                    with pytest.raises(ydb.Error):
+                        await asyncio.wait_for(failing, 3)
+                finally:
+                    replicas.unary_finish.set()
+                    await asyncio.gather(healthy, failing, return_exceptions=True)
+            finally:
+                await call(driver.stop)
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("values", [[], ["9"], ["-1"], ["2.5"], ["10", "10"], ["18446744073709551616"]])
+def test_rejects_missing_or_invalid_managed_generation(values):
+    channel = grpc.insecure_channel("localhost:1")
+    try:
+        poll = LongPoll(ydb.DriverConfig("localhost:1", "/database"), None)
+        poll.generation = 10
+        with pytest.raises(ValueError):
+            poll.result(None, [("x-ydb-route-generation", v) for v in values], [])
+    finally:
+        channel.close()
+
