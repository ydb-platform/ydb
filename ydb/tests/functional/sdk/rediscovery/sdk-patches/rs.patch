diff --git a/ydb/src/grpc_wrapper/eds/eds.proto b/ydb/src/grpc_wrapper/eds/eds.proto
new file mode 100644
index 0000000000000000000000000000000000000000..e175e7ded8c906a1aeab340a9f9282329d8d80df
--- /dev/null
+++ b/ydb/src/grpc_wrapper/eds/eds.proto
@@ -0,0 +1,76 @@
+syntax = "proto3";
+
+package Ydb.Xds;
+
+import "google/protobuf/any.proto";
+import "google/protobuf/wrappers.proto";
+
+// Wire projection of the Envoy v3 EDS messages used by YDB. Keep field numbers
+// aligned with envoy/service/discovery/v3 and envoy/config/{core,endpoint}/v3.
+// The private package avoids registering partial Envoy message descriptors.
+message Node {
+    string id = 1;
+    string cluster = 2;
+}
+
+message Status {
+    int32 code = 1;
+    string message = 2;
+}
+
+message DiscoveryRequest {
+    string version_info = 1;
+    Node node = 2;
+    repeated string resource_names = 3;
+    string type_url = 4;
+    string response_nonce = 5;
+    Status error_detail = 6;
+}
+
+message DiscoveryResponse {
+    string version_info = 1;
+    repeated google.protobuf.Any resources = 2;
+    string type_url = 4;
+    string nonce = 5;
+}
+
+message Metadata {
+    map<string, google.protobuf.Any> typed_filter_metadata = 2;
+}
+
+message SocketAddress {
+    uint32 protocol = 1;
+    string address = 2;
+    oneof port_specifier {
+        uint32 port_value = 3;
+        string named_port = 4;
+    }
+}
+
+message Address {
+    SocketAddress socket_address = 1;
+}
+
+message Endpoint {
+    Address address = 1;
+}
+
+message LbEndpoint {
+    Endpoint endpoint = 1;
+}
+
+message Locality {
+    string region = 1;
+}
+
+message LocalityLbEndpoints {
+    Locality locality = 1;
+    repeated LbEndpoint lb_endpoints = 2;
+    google.protobuf.UInt32Value load_balancing_weight = 3;
+    Metadata metadata = 9;
+}
+
+message ClusterLoadAssignment {
+    string cluster_name = 1;
+    repeated LocalityLbEndpoints endpoints = 2;
+}
diff --git a/ydb/src/grpc_wrapper/eds/mod.rs b/ydb/src/grpc_wrapper/eds/mod.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9affb00d191b9334c6f6d72aabd4a93eca1f587f
--- /dev/null
+++ b/ydb/src/grpc_wrapper/eds/mod.rs
@@ -0,0 +1,390 @@
+pub(crate) mod routes;
+
+#[path = "ydb.xds.rs"]
+mod wire;
+
+use super::grpc_limits::WithGrpcMaxMessageSize;
+use super::raw_discovery_client::EndpointInfo;
+use super::raw_services::{GrpcServiceForDiscovery, Service};
+use super::runtime_interceptors::InterceptedChannel;
+use crate::{YdbError, YdbResult};
+use prost::Message;
+use std::time::Duration;
+use tokio::sync::mpsc;
+use tokio::time::{Instant, timeout_at};
+use tokio_stream::wrappers::ReceiverStream;
+use tonic::{Code, Request, Status, metadata::MetadataMap};
+use ydb_grpc::ydb_proto::discovery::ListEndpointsResult;
+
+const TYPE_URL: &str = "type.googleapis.com/envoy.config.endpoint.v3.ClusterLoadAssignment";
+const METHOD: &str = "/envoy.service.endpoint.v3.EndpointDiscoveryService/StreamEndpoints";
+const GENERATION: &str = "x-ydb-route-generation";
+
+#[derive(Default)]
+pub(crate) struct Route {
+    floor: Option<u64>,
+    current: bool,
+}
+
+fn generation(headers: &MetadataMap) -> Option<u64> {
+    let mut values = headers.get_all(GENERATION).iter();
+    let value = values.next()?.to_str().ok()?;
+    if values.next().is_some() || value.is_empty() || !value.bytes().all(|c| c.is_ascii_digit()) {
+        return None;
+    }
+    value.parse().ok()
+}
+
+impl Route {
+    pub(crate) fn apply<T>(&self, request: &mut Request<T>) {
+        if let Some(floor) = self.floor {
+            request
+                .metadata_mut()
+                .insert("x-ydb-min-route-generation", floor.into());
+        }
+        if self.current {
+            request.metadata_mut().insert(
+                "x-ydb-require-current-route",
+                tonic::metadata::MetadataValue::from_static("1"),
+            );
+        }
+    }
+
+    pub(crate) fn accept(&mut self, headers: &MetadataMap) -> YdbResult<()> {
+        let mut modes = headers.get_all("x-ydb-route-mode").iter();
+        let mode = modes.next();
+        if self.floor.is_none() && mode.is_none() && !headers.contains_key(GENERATION) {
+            return Ok(());
+        }
+        let value = generation(headers);
+        if modes.next().is_some()
+            || mode.is_none_or(|v| v != "managed")
+            || value.is_none()
+            || value < self.floor
+        {
+            return Err(Status::unavailable("Stale or missing discovery route generation").into());
+        }
+        self.floor = value;
+        Ok(())
+    }
+
+    pub(crate) fn installed(&mut self) {
+        self.current = false;
+    }
+
+    fn lost(&mut self, status: &Status) {
+        if status.code() == Code::Unavailable
+            && let Some(cut) = generation(status.metadata())
+            && self.floor.is_some_and(|old| cut > old)
+        {
+            self.floor = Some(cut);
+            self.current = false;
+        } else {
+            self.current = true;
+        }
+    }
+}
+
+pub(crate) struct EdsClient(tonic::client::Grpc<InterceptedChannel>);
+
+impl EdsClient {
+    pub(crate) fn new(channel: InterceptedChannel) -> Self {
+        Self(tonic::client::Grpc::new(channel))
+    }
+}
+
+impl WithGrpcMaxMessageSize for EdsClient {
+    fn with_grpc_max_message_size(self, bytes: usize) -> Self {
+        Self(
+            self.0
+                .max_decoding_message_size(bytes)
+                .max_encoding_message_size(bytes),
+        )
+    }
+}
+
+impl GrpcServiceForDiscovery for EdsClient {
+    fn get_grpc_discovery_service() -> Service {
+        Service::Discovery
+    }
+}
+
+fn decode(database: &str, response: &wire::DiscoveryResponse) -> YdbResult<Vec<EndpointInfo>> {
+    let invalid = || YdbError::custom(format!("Invalid EDS assignment for {database}"));
+    let [resource] = response.resources.as_slice() else {
+        return Err(invalid());
+    };
+    if response.type_url != TYPE_URL
+        || resource.type_url != TYPE_URL
+        || response.version_info.is_empty()
+        || response.nonce.is_empty()
+    {
+        return Err(invalid());
+    }
+    let assignment =
+        wire::ClusterLoadAssignment::decode(resource.value.as_slice()).map_err(|_| invalid())?;
+    let [group] = assignment.endpoints.as_slice() else {
+        return Err(invalid());
+    };
+    if assignment.cluster_name != database {
+        return Err(invalid());
+    }
+    let typed = group
+        .metadata
+        .as_ref()
+        .and_then(|m| m.typed_filter_metadata.get("ydb.discovery"))
+        .ok_or_else(invalid)?;
+    if typed.type_url != "type.googleapis.com/Ydb.Discovery.ListEndpointsResult" {
+        return Err(invalid());
+    }
+    let decoded = ListEndpointsResult::decode(typed.value.as_slice()).map_err(|_| invalid())?;
+    if decoded.endpoints.len() != group.lb_endpoints.len() {
+        return Err(invalid());
+    }
+    for (ep, lb) in decoded.endpoints.iter().zip(&group.lb_endpoints) {
+        let socket = lb
+            .endpoint
+            .as_ref()
+            .and_then(|e| e.address.as_ref())
+            .and_then(|a| a.socket_address.as_ref())
+            .ok_or_else(invalid)?;
+        if socket.protocol != 0
+            || socket.address.is_empty()
+            || ep.address != socket.address
+            || !(1..=65535).contains(&ep.port)
+            || socket.port_specifier
+                != Some(wire::socket_address::PortSpecifier::PortValue(ep.port))
+        {
+            return Err(invalid());
+        }
+    }
+    Ok(EndpointInfo::from_result(decoded))
+}
+
+pub(crate) enum WatchEnd {
+    Unimplemented,
+}
+
+impl EdsClient {
+    pub(crate) async fn watch(
+        &mut self,
+        database: &str,
+        id: &str,
+        route: &mut Route,
+        mut publish: impl FnMut(Vec<EndpointInfo>) -> YdbResult<()>,
+    ) -> YdbResult<WatchEnd> {
+        let first_deadline = Instant::now() + Duration::from_secs(10);
+        let (requests, rx) = mpsc::channel(1);
+        let base = wire::DiscoveryRequest {
+            resource_names: vec![database.to_owned()],
+            type_url: TYPE_URL.to_owned(),
+            ..Default::default()
+        };
+        let initial = wire::DiscoveryRequest {
+            node: Some(wire::Node {
+                id: id.to_owned(),
+                ..Default::default()
+            }),
+            ..base.clone()
+        };
+        requests
+            .send(initial)
+            .await
+            .map_err(|_| YdbError::custom("Closed EDS request stream"))?;
+        let mut request = Request::new(ReceiverStream::new(rx));
+        route.apply(&mut request);
+        let open = async {
+            self.0
+                .ready()
+                .await
+                .map_err(|e| Status::unavailable(e.to_string()))?;
+            self.0
+                .streaming(
+                    request,
+                    http::uri::PathAndQuery::from_static(METHOD),
+                    tonic_prost::ProstCodec::default(),
+                )
+                .await
+        };
+        let response = match timeout_at(first_deadline, open)
+            .await
+            .map_err(|_| YdbError::DeadlineExceeded)?
+        {
+            Ok(response) => response,
+            Err(status) if status.code() == Code::Unimplemented => {
+                route.accept(status.metadata())?;
+                return Ok(WatchEnd::Unimplemented);
+            }
+            Err(status) => {
+                route.lost(&status);
+                return Err(status.into());
+            }
+        };
+        let (headers, mut stream, _) = response.into_parts();
+        let mut version = String::new();
+        let mut received = false;
+        loop {
+            let next = if version.is_empty() {
+                timeout_at(first_deadline, stream.message())
+                    .await
+                    .map_err(|_| YdbError::DeadlineExceeded)?
+            } else {
+                stream.message().await
+            };
+            let message: wire::DiscoveryResponse = match next {
+                Ok(Some(message)) => message,
+                Err(status) if !received && status.code() == Code::Unimplemented => {
+                    route.accept(&headers)?;
+                    return Ok(WatchEnd::Unimplemented);
+                }
+                ended => {
+                    let status = match ended {
+                        Err(s) => s,
+                        _ => Status::unavailable("EDS stream ended"),
+                    };
+                    route.lost(&status);
+                    return Err(status.into());
+                }
+            };
+            received = true;
+            let error_detail = match decode(database, &message) {
+                Ok(endpoints) => {
+                    route.accept(&headers)?;
+                    publish(endpoints)?;
+                    route.installed();
+                    version = message.version_info;
+                    None
+                }
+                Err(err) => Some(wire::Status {
+                    code: Code::InvalidArgument as i32,
+                    message: err.to_string(),
+                }),
+            };
+            requests
+                .send(wire::DiscoveryRequest {
+                    version_info: version.clone(),
+                    response_nonce: message.nonce,
+                    error_detail,
+                    ..base.clone()
+                })
+                .await
+                .map_err(|_| YdbError::custom("Closed EDS response stream"))?;
+        }
+    }
+}
