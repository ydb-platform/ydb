+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::discovery::NodeInfo;
+    use crate::grpc_wrapper::eds::routes::EndpointRoutes;
+    use http::Uri;
+
+    #[tokio::test]
+    async fn cut_drains_admitted_rpc_and_new_calls_use_destination() {
+        use crate::grpc_wrapper::runtime_interceptors::{InterceptedChannel, MultiInterceptor};
+        use tokio::net::TcpListener;
+        use tokio::sync::Notify;
+        use tokio::time::{Duration, timeout};
+        use ydb_grpc::ydb_proto::auth::v1::{
+            auth_service_client::AuthServiceClient,
+            auth_service_server::{AuthService, AuthServiceServer},
+        };
+        use ydb_grpc::ydb_proto::auth::{LoginRequest, LoginResponse};
+
+        #[derive(Default)]
+        struct Service {
+            accepted: Notify,
+            release: Notify,
+        }
+
+        #[tonic::async_trait]
+        impl AuthService for Service {
+            async fn login(
+                &self,
+                _: tonic::Request<LoginRequest>,
+            ) -> Result<tonic::Response<LoginResponse>, tonic::Status> {
+                self.accepted.notify_one();
+                self.release.notified().await;
+                Ok(tonic::Response::new(LoginResponse::default()))
+            }
+        }
+
+        async fn server() -> (NodeInfo, std::sync::Arc<Service>) {
+            let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let uri: Uri = format!("http://{}/", listener.local_addr().unwrap())
+                .parse()
+                .unwrap();
+            let service = std::sync::Arc::new(Service::default());
+            let incoming = futures_util::stream::unfold(listener, |listener| async {
+                Some((listener.accept().await.map(|(stream, _)| stream), listener))
+            });
+            tokio::spawn(
+                tonic::transport::Server::builder()
+                    .add_service(AuthServiceServer::from_arc(service.clone()))
+                    .serve_with_incoming(incoming),
+            );
+            (NodeInfo::new(uri, String::new()), service)
+        }
+
+        timeout(Duration::from_secs(10), async {
+            let (source, a) = server().await;
+            let (destination, b) = server().await;
+            let routes = EndpointRoutes::default();
+            routes.install(std::slice::from_ref(&source));
+            let (channel, token) = routes
+                .connection(&source.uri, &Default::default())
+                .await
+                .unwrap();
+            let mut old = AuthServiceClient::new(
+                InterceptedChannel::new(channel, MultiInterceptor::new()).with_route(token),
+            );
+            let mut held = old.clone();
+            let call = tokio::spawn(async move { held.login(LoginRequest::default()).await });
+            a.accepted.notified().await;
+            routes.install(std::slice::from_ref(&destination));
+            assert!(
+                routes
+                    .connection(&source.uri, &Default::default())
+                    .await
+                    .is_err()
+            );
+            assert_eq!(
+                old.login(LoginRequest::default()).await.unwrap_err().code(),
+                tonic::Code::Unavailable
+            );
+            b.release.notify_one();
+            let (channel, token) = routes
+                .connection(&destination.uri, &Default::default())
+                .await
+                .unwrap();
+            AuthServiceClient::new(
+                InterceptedChannel::new(channel, MultiInterceptor::new()).with_route(token),
+            )
+            .login(LoginRequest::default())
+            .await
+            .unwrap();
+            b.accepted.notified().await;
+            a.release.notify_one();
+            call.await.unwrap().unwrap();
+        })
+        .await
+        .expect("cutover did not drain the admitted call");
+    }
+
+    #[test]
+    fn stale_or_missing_generation_after_a_cut_is_rejected() {
+        let mut route = Route::default();
+        let mut headers = MetadataMap::new();
+        headers.insert("x-ydb-route-mode", "managed".parse().unwrap());
+        headers.insert(GENERATION, 1.into());
+        route.accept(&headers).unwrap();
+        let mut trailers = MetadataMap::new();
+        trailers.insert(GENERATION, 2.into());
+        route.lost(&Status::with_metadata(Code::Unavailable, "cut", trailers));
+        assert!(route.accept(&headers).is_err());
+        assert!(route.accept(&MetadataMap::new()).is_err());
+        headers.insert(GENERATION, 2.into());
+        route.accept(&headers).unwrap();
+    }
+}
