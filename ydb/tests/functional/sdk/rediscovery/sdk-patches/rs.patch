diff --git a/ydb/src/grpc_wrapper/endpoint_routes.rs b/ydb/src/grpc_wrapper/endpoint_routes.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c3eb2680500db80715674ab00403ca5ebc4e982f
--- /dev/null
+++ b/ydb/src/grpc_wrapper/endpoint_routes.rs
@@ -0,0 +1,223 @@
+//! Each admitted authority owns one data channel and cancellation token. A cut
+//! retires these together. Cached service handles keep their original token.
+use crate::connection_pool::{endpoint, normalize_uri_scheme};
+use crate::discovery::NodeInfo;
+use crate::{GrpcOptions, YdbResult};
+use http::Uri;
+use std::collections::{HashMap, HashSet};
+use std::pin::Pin;
+use std::sync::Arc;
+use std::task::{Context, Poll};
+use tokio::sync::{OnceCell, watch};
+use tokio_util::sync::{CancellationToken, WaitForCancellationFutureOwned};
+use tonic::{Status, body::Body, codegen::Bytes, transport::Channel};
+
+#[derive(Debug, Default)]
+pub(crate) struct RouteEndpoint {
+    cancelled: CancellationToken,
+    channel: OnceCell<Channel>,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct EndpointRoutes(watch::Sender<HashMap<Uri, Arc<RouteEndpoint>>>);
+
+impl Default for EndpointRoutes {
+    fn default() -> Self {
+        Self(watch::channel(HashMap::new()).0)
+    }
+}
+
+impl EndpointRoutes {
+    pub(crate) fn install(&self, nodes: &[NodeInfo]) {
+        let members: HashSet<&Uri> = nodes.iter().map(|node| &node.uri).collect();
+        self.0.send_modify(|routes| {
+            routes.retain(|uri, entry| {
+                if members.contains(uri) {
+                    true
+                } else {
+                    entry.cancelled.cancel();
+                    false
+                }
+            });
+            for uri in members {
+                routes.entry(uri.clone()).or_default();
+            }
+        });
+    }
+
+    fn endpoint(&self, uri: &Uri) -> YdbResult<Arc<RouteEndpoint>> {
+        Ok(self.0.borrow().get(uri).cloned().ok_or_else(retired)?)
+    }
+
+    pub(crate) async fn connection(
+        &self,
+        uri: &Uri,
+        opts: &GrpcOptions,
+    ) -> YdbResult<(Channel, CancellationToken)> {
+        let route = self.endpoint(uri)?;
+        let channel = route
+            .channel
+            .get_or_try_init(|| async {
+                Ok::<_, crate::YdbError>(
+                    endpoint(normalize_uri_scheme(uri.clone())?, None, opts)?
+                        .executor(RouteExecutor(route.cancelled.clone()))
+                        .connect_lazy(),
+                )
+            })
+            .await?;
+        Ok((channel.clone(), route.cancelled.clone()))
+    }
+}
+
+// Tonic runs both its request queue and HTTP/2 I/O on the endpoint executor.
+// Dropping those tasks closes the socket even when a client still owns a Channel.
+struct RouteExecutor(CancellationToken);
+
+impl<F: Future<Output = ()> + Send + 'static> hyper::rt::Executor<F> for RouteExecutor {
+    fn execute(&self, task: F) {
+        let cancelled = self.0.clone();
+        tokio::spawn(async move {
+            tokio::select! {
+                biased;
+                _ = cancelled.cancelled() => (),
+                _ = task => (),
+            }
+        });
+    }
+}
+
+pub(crate) fn retired() -> Status {
+    Status::unavailable("Discovery retired the data endpoint")
+}
+
+// Watching both bodies wakes an idle reader and stops a writer with queued
+// batches. The existing Topic reconnectors own redelivery and acknowledgement.
+pub(crate) struct RouteBody {
+    inner: Body,
+    cancelled: Pin<Box<WaitForCancellationFutureOwned>>,
+}
+
+impl RouteBody {
+    pub(crate) fn wrap(body: Body, token: CancellationToken) -> Body {
+        Body::new(Self {
+            inner: body,
+            cancelled: Box::pin(token.cancelled_owned()),
+        })
+    }
+}
+
+impl http_body::Body for RouteBody {
+    type Data = Bytes;
+    type Error = Status;
+
+    fn poll_frame(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+    ) -> Poll<Option<Result<http_body::Frame<Self::Data>, Self::Error>>> {
+        if self.cancelled.as_mut().poll(cx).is_ready() {
+            return Poll::Ready(Some(Err(retired())));
+        }
+        Pin::new(&mut self.inner).poll_frame(cx)
+    }
+}
+
+const GENERATION: &str = "x-ydb-route-generation";
+
+pub(crate) fn generation(
+    previous: Option<u64>,
+    headers: &tonic::metadata::MetadataMap,
+) -> YdbResult<Option<u64>> {
+    let mut entries = headers.get_all(GENERATION).iter();
+    if let Some(entry) = entries.next() {
+        let value = entry
+            .to_str()
+            .map_err(|_| Status::unavailable("Invalid route generation"))?;
+        if entries.next().is_none()
+            && !value.is_empty()
+            && value.bytes().all(|c| c.is_ascii_digit())
+            && let Ok(current) = value.parse::<u64>()
+            && Some(current) >= previous
+        {
+            return Ok(Some(current));
+        }
+    } else if previous.is_none() {
+        return Ok(None);
+    }
+    Err(Status::unavailable("Missing or stale discovery route generation").into())
+}
+
+#[cfg(test)]
