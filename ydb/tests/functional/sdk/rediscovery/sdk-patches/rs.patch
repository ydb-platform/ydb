+        let routes = EndpointRoutes::default();
+        routes.install(&[NodeInfo::new(uri.clone(), String::new())]);
+        let (mut channel, _) = routes.connection(&uri, &Default::default()).await.unwrap();
+        std::future::poll_fn(|cx| channel.poll_ready(cx))
+            .await
+            .unwrap();
+        let pending = channel.call(http::Request::new(Body::empty()));
+
+        timeout(Duration::from_secs(3), async {
+            let (mut peer, _) = listener.accept().await.unwrap();
+            let mut preface = [0; 24];
+            peer.read_exact(&mut preface).await.unwrap();
