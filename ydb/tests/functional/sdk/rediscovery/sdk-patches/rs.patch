+                    .await
+                    .is_err()
+            );
+        })
+        .await
+        .expect("the retired TCP transport stayed open");
+    }
+
+    #[test]
+    fn poll_accepts_initial_generation_without_a_mode_and_rejects_regressions() {
+        let mut previous = None;
+        let mut headers = MetadataMap::new();
+        previous = generation(previous, &headers).unwrap();
+        headers.insert(GENERATION, u64::MAX.into());
+        previous = generation(previous, &headers).unwrap();
+        assert!(generation(previous, &MetadataMap::new()).is_err());
+        headers.insert(GENERATION, 1.into());
+        assert!(generation(previous, &headers).is_err());
+    }
+}
