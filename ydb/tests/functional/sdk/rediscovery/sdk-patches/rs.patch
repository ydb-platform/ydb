+        routes.install(&[]);
+        assert!(original.cancelled.is_cancelled());
+        assert!(routes.endpoint(&uri).is_err());
+        routes.install(&[node]);
+        assert!(!routes.endpoint(&uri).unwrap().cancelled.is_cancelled());
+        assert!(original.cancelled.is_cancelled());
+    }
+
+    #[tokio::test]
+    async fn removing_an_endpoint_closes_tcp_with_a_retained_channel() {
+        use tokio::io::AsyncReadExt;
