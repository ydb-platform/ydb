linked_executable("blobsan") {
  deps = [
    "//library/cpp/containers/absl",
    "//library/cpp/streams/bzip2",
    "//ydb/core/blobstorage",  # peerdir only
    "//ydb/core/blobstorage/groupinfo",
    "//ydb/core/blobstorage/vdisk/query",
  ]

  sources = [ "main.cpp" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
