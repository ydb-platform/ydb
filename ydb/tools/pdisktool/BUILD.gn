linked_executable("pdisktool") {
  deps = [
    "//library/cpp/getopt",  # peerdir only
    "//ydb/core/blobstorage/crypto",
    "//ydb/core/driver_lib/version",  # peerdir only
    "//ydb/tools/pdisktool/lib",
  ]

  sources = [ "main.cpp" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
