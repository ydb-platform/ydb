unittest_executable("ut") {
  deps = [
    "//library/cpp/blockcodecs",
    "//library/cpp/testing/unittest",
    "//ydb/core/base",
    "//ydb/core/blobstorage/crypto",
    "//ydb/core/blobstorage/pdisk",
    "//ydb/core/blobstorage/vdisk/common",
    "//ydb/core/blobstorage/vdisk/hulldb/base",
    "//ydb/core/blobstorage/vdisk/hulldb/base:base_types",
    "//ydb/core/erasure",
    "//ydb/core/protos",
    "//ydb/core/scheme",
    "//ydb/core/tablet_flat",
    "//ydb/core/testlib/actors",
    "//ydb/library/actors/core",
    "//ydb/library/pdisk_io",
    "//ydb/library/services",
    "//ydb/tools/pdisktool/lib",
  ]

  sources = [
    "pdisktool_oracle_ut.cpp",
    "pdisktool_tablet_ut.cpp",
    "pdisktool_version_ut.cpp",
  ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
  ]
}
