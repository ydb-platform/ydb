# The two builds of the codegen part of minikql/computation: llvm16 (with LLVM
# codegen) and no_llvm (MKQL_DISABLE_CODEGEN, LLVM headers from llvm_stub).
# ya make needs a module per configuration and copies the sources into each
# (ya.make.inc); here both are instances of one template over the same files.
# variant_sources.gni is generated by yamake2gn from ya.make.inc.

import("//yql/essentials/minikql/computation/variant_sources.gni")

_codegen_headers = [
  "mkql_block_impl_codegen",
  "mkql_computation_node_codegen",
  "mkql_llvm_base",
]

template("mkql_computation_variant") {
  assert(defined(invoker.codegen), "mkql_computation_variant needs `codegen`")

  # The *.h.txt headers, as ya make's COPY_FILE(TEXT) lays them out in the
  # module's build dir: reachable both by full path and by name.
  _gen_subdir = "$target_gen_dir/yql/essentials/minikql/computation"
  _copies = []
  foreach(_h, _codegen_headers) {
    copy("${target_name}_${_h}_h") {
      sources = [ "//yql/essentials/minikql/computation/$_h.h.txt" ]
      outputs = [ "$_gen_subdir/$_h.h" ]
    }
    _copies += [ ":${target_name}_${_h}_h" ]
  }

  config("${target_name}_includes") {
    include_dirs = [
      target_gen_dir,
      _gen_subdir,
    ]
    if (!invoker.codegen) {
      include_dirs += [ "//yql/essentials/minikql/codegen/llvm_stub" ]
    }
  }

  library(target_name) {
    sources = variant_sources

    public_configs = [ ":${target_name}_includes" ]
    link_slot_provides = [ "minikql_codegen" ]

    public_deps = _copies + [
                    "//contrib/libs/apache/arrow",
                    "//library/cpp/enumbitset",
                    "//library/cpp/packedtypes",
                    "//library/cpp/random_provider",
                    "//library/cpp/threading/future",
                    "//library/cpp/time_provider",
                    "//yql/essentials/minikql",
                    "//yql/essentials/minikql/arrow",
                    "//yql/essentials/minikql/computation",
                    "//yql/essentials/parser/pg_wrapper/interface",
                    "//yql/essentials/public/langver",
                    "//yql/essentials/public/udf",
                    "//yql/essentials/public/udf/arrow",
                    "//yql/essentials/utils",
                  ]

    if (invoker.codegen) {
      public_deps += [
        "//contrib/libs/llvm16",
        "//yql/essentials/minikql/codegen/llvm16",
      ]
    } else {
      defines = [ "MKQL_DISABLE_CODEGEN" ]
    }
  }
}
