    'Null (lambda '() (Apply mod left right))
    (lambda '() (Map (Apply mod left right) (lambda '(remainder) (Apply pmod_impl remainder right))))
)))
(let div_check (lambda '(value) (MatchType (TypeOf value)
    'Int8 (lambda '() value)
    'Int16 (lambda '() value)
    'Int32 (lambda '() value)
