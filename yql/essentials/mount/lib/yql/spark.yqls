        'Optional (lambda '() (FlatMap left (lambda '(left_item) (FlatMap right (lambda '(right_item) (Apply try_mod_impl left_item right_item))))))
        'Null (lambda '() (Apply try_mod_nothing left))
        (lambda '() (FlatMap left (lambda '(left_item) (Apply try_mod_impl left_item right))))
    ))
    'Null (lambda '() (MatchType (TypeOf right)
        'Null (lambda '() (Nothing (OptionalType (DataType 'Double))))
        (lambda '() (Apply try_mod_nothing right))
    ))
    (lambda '() (MatchType (TypeOf right)
        'Optional (lambda '() (FlatMap right (lambda '(right_item) (Apply try_mod_impl left right_item))))
        'Null (lambda '() (Apply try_mod_nothing left))
        (lambda '() (Apply try_mod_impl left right))
    ))
)))
(let mod (lambda '(left right) (Apply try_mod left right)))
(let pmod_impl (lambda '(remainder divisor) (block '(
    (let zero (Unwrap (Cast (Int8 '0) (TypeOf remainder)) (String 'Expected_numeric)))
    (return (If (And (< remainder zero) (> divisor zero)) (+ remainder divisor) remainder))
))))
(let pmod (lambda '(left right) (MatchType (TypeOf right)
    'Optional (lambda '() (FlatMap right (lambda '(right_item) (Map (Apply try_mod left right_item) (lambda '(remainder) (Apply pmod_impl remainder right_item))))))
    'Null (lambda '() (Apply try_mod left right))
    (lambda '() (Map (Apply try_mod left right) (lambda '(remainder) (Apply pmod_impl remainder right))))
)))
(let sqrt (lambda '(value) (Apply math_unary value (Udf 'Math.Sqrt))))
(let ceil_impl (lambda '(value) (Unwrap (SafeCast (Apply (Udf 'Math.Ceil) value) (DataType 'Int64)) (String 'Expected_Int64))))
(let ceil (lambda '(value) (Apply math_unary_int64 value ceil_impl)))
(let floor_impl (lambda '(value) (Unwrap (SafeCast (Apply (Udf 'Math.Floor) value) (DataType 'Int64)) (String 'Expected_Int64))))
(let floor (lambda '(value) (Apply math_unary_int64 value floor_impl)))
(let round_impl (lambda '(value scale)
    (Unwrap (FromPg (PgCast
        (PgCall 'round '()
            (PgCast (ToPg value) (PgType 'numeric))
            (ToPg (Unwrap (SafeCast scale (DataType 'Int32)) (String 'Expected_Int32)))
        )
        (PgType 'float8)
    )) (String 'Unexpected_NULL_from_PgCall))
))
(let round_1 (lambda '(value) (MatchType (TypeOf value)
    'Optional (lambda '() (Map value (lambda '(item) (Apply round_impl item (Int32 '0)))))
    'Null (lambda '() (Nothing (OptionalType (DataType 'Double))))
    (lambda '() (AsOptional (Apply round_impl value (Int32 '0))))
)))
(let round_2 (lambda '(value scale) (Apply math_binary_optional value scale round_impl)))
(let cbrt (lambda '(value) (Apply math_unary value (Udf 'Math.Cbrt))))
(let cot_impl (lambda '(value) (/ (Double '1.0) (Apply (Udf 'Math.Tan) value))))
(let cot (lambda '(value) (Apply math_unary value cot_impl)))
(let sec_impl (lambda '(value) (/ (Double '1.0) (Apply (Udf 'Math.Cos) value))))
(let sec (lambda '(value) (Apply math_unary value sec_impl)))
(let csc_impl (lambda '(value) (/ (Double '1.0) (Apply (Udf 'Math.Sin) value))))
(let csc (lambda '(value) (Apply math_unary value csc_impl)))
(let acos (lambda '(value) (Apply math_unary value (Udf 'Math.Acos))))
(let acosh_impl (lambda '(value) (Apply (Udf 'Math.Log) (+ value (Apply (Udf 'Math.Sqrt) (- (* value value) (Double '1.0)))))))
(let acosh (lambda '(value) (Apply math_unary value acosh_impl)))
(let asin (lambda '(value) (Apply math_unary value (Udf 'Math.Asin))))
(let atan (lambda '(value) (Apply math_unary value (Udf 'Math.Atan))))
(let cosh (lambda '(value) (Apply math_unary value (Udf 'Math.Cosh))))
(let sinh (lambda '(value) (Apply math_unary value (Udf 'Math.Sinh))))
(let tanh (lambda '(value) (Apply math_unary value (Udf 'Math.Tanh))))
(let sin (lambda '(value) (Apply math_unary value (Udf 'Math.Sin))))
(let cos (lambda '(value) (Apply math_unary value (Udf 'Math.Cos))))
(let tan (lambda '(value) (Apply math_unary value (Udf 'Math.Tan))))
(let exp (lambda '(value) (Apply math_unary value (Udf 'Math.Exp))))
(let expm1_impl (lambda '(value) (Apply (Udf 'Math.Expm1) value)))
(let expm1 (lambda '(value) (Apply math_unary value expm1_impl)))
(let e (lambda '() (Apply (Udf 'Math.E))))
(let pi (lambda '() (Apply (Udf 'Math.Pi))))
(let log1p_impl (lambda '(value) (If (== value (Double '-1.0)) (Nothing (OptionalType (DataType 'Double))) (AsOptional (Apply (Udf 'Math.Log1p) value)))))
(let log1p (lambda '(value) (MatchType (TypeOf value)
    'Optional (lambda '() (FlatMap value log1p_impl))
    'Null (lambda '() (Nothing (OptionalType (DataType 'Double))))
    (lambda '() (Apply log1p_impl (SafeCast value (DataType 'Double))))
)))
(let log_1 (lambda '(value) (Apply math_unary value (Udf 'Math.Log))))
(let log_2 (lambda '(base value) (Apply math_binary_optional base value (lambda '(base_item value_item) (/ (Apply (Udf 'Math.Log) value_item) (Apply (Udf 'Math.Log) base_item))))))
(let ln (lambda '(value) (Apply log_1 value)))
(let log10 (lambda '(value) (Apply math_unary value (Udf 'Math.Log10))))
(let log2 (lambda '(value) (Apply math_unary value (Udf 'Math.Log2))))
(let asinh (lambda '(value) (Apply math_unary value (Udf 'Math.Asinh))))
(let atanh_impl (lambda '(value) (If (== value (Double '-1.0)) (Double '"-inf") (/ (Apply (Udf 'Math.Log) (/ (+ (Double '1.0) value) (- (Double '1.0) value))) (Double '2.0)))))
(let atanh (lambda '(value) (Apply math_unary value atanh_impl)))
(let rint (lambda '(value) (Apply math_unary value (Udf 'Math.Rint))))
(let sign_impl (lambda '(value) (If (> value (Double '0.0)) (Double '1.0) (If (< value (Double '0.0)) (Double '-1.0) value))))
(let sign (lambda '(value) (Apply math_unary value sign_impl)))
(let degrees_impl (lambda '(value) (/ (* value (Double '180.0)) (Apply (Udf 'Math.Pi)))))
(let radians_impl (lambda '(value) (/ (* value (Apply (Udf 'Math.Pi))) (Double '180.0))))
(let degrees (lambda '(value) (Apply math_unary value degrees_impl)))
(let radians (lambda '(value) (Apply math_unary value radians_impl)))
(let atan2 (lambda '(left right) (Apply math_binary left right (Udf 'Math.Atan2))))
(let hypot (lambda '(left right) (Apply math_binary left right (Udf 'Math.Hypot))))
(let pow (lambda '(left right) (Apply math_binary left right (Udf 'Math.Pow))))
