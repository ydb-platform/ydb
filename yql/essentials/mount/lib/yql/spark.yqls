    (MatchType (Apply remove_optional_type (TypeOf right))
        'Interval64 (lambda '() 'temporal_add_interval)
        'Null (lambda '() 'temporal_add_interval)
        (lambda '() 'date_add_days)
    )) left right)))
(let date_subtract (lambda '(left right) (Apply (LazyBind spark_module
    (MatchType (Apply remove_optional_type (TypeOf right))
        'Date32 (lambda '() 'date_difference)
        'Null (lambda '() 'date_difference)
        'Timestamp64 (lambda '() 'temporal_difference)
        'Interval64 (lambda '() 'temporal_subtract_interval)
        (lambda '() 'date_subtract_days)
    )) left right)))
(let timestamp_subtract (lambda '(left right) (Apply (LazyBind spark_module
    (MatchType (Apply remove_optional_type (TypeOf right))
        'Date32 (lambda '() 'temporal_difference)
        'Timestamp64 (lambda '() 'temporal_difference)
        'Null (lambda '() 'temporal_difference)
        (lambda '() 'temporal_subtract_interval)
    )) left right)))
(let add_reversed_date (lambda '(left right) (Apply date_add right left)))
(let add_reversed_timestamp (lambda '(left right) (Apply temporal_add_interval right left)))
(let add_other (lambda '(left right) (Apply (LazyBind spark_module
    (MatchType (Apply remove_optional_type (TypeOf right))
        'Date32 (lambda '() 'add_reversed_date)
        'Timestamp64 (lambda '() 'add_reversed_timestamp)
        'Tagged (lambda '() 'interval_add)
        'Interval64 (lambda '() 'interval_add)
        (lambda '() (MatchType (Apply remove_optional_type (TypeOf left))
            'Tagged (lambda '() 'interval_add)
            'Interval64 (lambda '() 'interval_add)
            (lambda '() 'numeric_add)
        ))
    )) left right)))
(let subtract_other (lambda '(left right) (Apply (LazyBind spark_module
    (MatchType (Apply remove_optional_type (TypeOf right))
        'Date32 (lambda '() 'date_difference)
        'Timestamp64 (lambda '() 'temporal_difference)
        'Tagged (lambda '() 'interval_subtract)
        'Interval64 (lambda '() 'interval_subtract)
        (lambda '() (MatchType (Apply remove_optional_type (TypeOf left))
            'Tagged (lambda '() 'interval_subtract)
            'Interval64 (lambda '() 'interval_subtract)
            (lambda '() 'numeric_subtract)
        ))
    )) left right)))
(let op_add (lambda '(left right) (Apply (LazyBind spark_module
    (MatchType (Apply remove_optional_type (TypeOf left))
        'Date32 (lambda '() 'date_add)
        'Timestamp64 (lambda '() 'temporal_add_interval)
        (lambda '() 'add_other)
    )) left right)))
(let op_subtract (lambda '(left right) (Apply (LazyBind spark_module
    (MatchType (Apply remove_optional_type (TypeOf left))
        'Date32 (lambda '() 'date_subtract)
        'Timestamp64 (lambda '() 'timestamp_subtract)
        (lambda '() 'subtract_other)
    )) left right)))
(let multiply_impl (lambda '(left right) (Unwrap (CheckedMul left right) (String '"Multiplication overflow"))))
(let op_multiply (lambda '(left right) (Apply arithmetic_binary left right (LazyBind spark_module 'multiply_impl) '"Spark * does not support Decimal arguments")))
(let nonzero_divisor (lambda '(value) (block '(
    (let zero (Unwrap (SafeCast (Int8 '0) (TypeOf value)) (String 'Expected_numeric)))
    (return (Ensure value (!= value zero) (String '"Division by zero")))
))))
(let divide_impl (lambda '(left right) (/ (Convert left (DataType 'Double)) (Apply nonzero_divisor (Convert right (DataType 'Double))))))
(let op_divide (lambda '(left right) (AsOptional (Apply arithmetic_binary left right (LazyBind spark_module 'divide_impl) '"Spark / does not support Decimal arguments"))))
(let try_subtract (lambda '(left right) (Apply try_binary_checked left right (lambda '(left_item right_item) (CheckedSub left_item right_item)))))
(let try_multiply (lambda '(left right) (Apply try_binary_checked left right (lambda '(left_item right_item) (CheckedMul left_item right_item)))))
(let try_divide_or_mod (lambda '(left right impl) (block '(
    (let zero (Unwrap (SafeCast (Int8 '0) (TypeOf right)) (String 'Expected_numeric)))
    (let result (Apply impl left right))
    (return (If (== right zero)
        (Nothing (OptionalType (Apply remove_optional_type (TypeOf result))))
        (AsOptional result)
    ))
))))
(let try_divide (lambda '(left right) (Apply try_binary_checked left right (lambda '(left_item right_item) (Apply try_divide_or_mod left_item right_item (lambda '(left_value right_value) (/ (Convert left_value (DataType 'Double)) (Convert right_value (DataType 'Double)))))))))
(let try_mod (lambda '(left right) (Apply try_binary_checked left right (lambda '(left_item right_item) (Apply try_divide_or_mod left_item right_item (lambda '(left_value right_value) (% left_value right_value)))))))
(let mod_impl (lambda '(left right) (block '(
    (let divisor (Apply nonzero_divisor right))
    (let remainder (% left divisor))
    (let item_type (Apply remove_optional_type (TypeOf remainder)))
    (let integral_result (lambda '() (If (== divisor (Int8 '-1))
        (AsOptional (Unwrap (SafeCast (Int8 '0) item_type) (String 'Expected_integer)))
        remainder
    )))
    (return (MatchType item_type
        'Int8 integral_result
        'Int16 integral_result
        'Int32 integral_result
        'Int64 integral_result
        (lambda '() remainder)
    ))
))))
(let mod (lambda '(left right) (Apply try_binary_plain left right mod_impl)))
(let pmod_impl (lambda '(remainder divisor) (block '(
    (let zero (Unwrap (Cast (Int8 '0) (TypeOf remainder)) (String 'Expected_numeric)))
    (return (If (And (< remainder zero) (> divisor zero)) (+ remainder divisor) remainder))
))))
(let pmod (lambda '(left right) (MatchType (TypeOf right)
