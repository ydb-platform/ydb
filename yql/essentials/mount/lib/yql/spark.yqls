(let ceil (lambda '(value) (Apply math_unary_int64 value ceil_impl)))
(let floor_impl (lambda '(value) (Unwrap (SafeCast (Apply (Udf 'Math.Floor) value) (DataType 'Int64)) (String 'Expected_Int64))))
