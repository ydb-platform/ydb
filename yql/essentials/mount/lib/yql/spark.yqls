(
(let spark_module '/lib/yql/spark)
(let remove_optional_type (lambda '(type) (MatchType type 'Optional (lambda '() (OptionalItemType type)) (lambda '() type))))
(let apply_nullable_right (lambda '(left right impl result_type)
    (Apply (LazyBind spark_module
        (MatchType (TypeOf right)
            'Optional (lambda '() 'apply_nullable_right_optional)
            'Null (lambda '() 'apply_nullable_binary_null)
            (lambda '() 'apply_nullable_binary_required)
        )
    ) left right impl result_type)
))
(let apply_nullable_right_optional (lambda '(left right impl result_type) (FlatMap right (lambda '(item) (AsOptional (Apply impl left item))))))
(let apply_nullable_binary_null (lambda '(left right impl result_type) (Nothing (OptionalType result_type))))
(let apply_nullable_binary_required (lambda '(left right impl result_type) (Apply impl left right)))
(let apply_nullable_left (lambda '(left right impl result_type)
    (Apply (LazyBind spark_module
        (MatchType (TypeOf right)
            'Optional (lambda '() 'apply_nullable_both_optional)
            'Null (lambda '() 'apply_nullable_binary_null)
            (lambda '() 'apply_nullable_left_optional)
        )
    ) left right impl result_type)
))
(let apply_nullable_both_optional (lambda '(left right impl result_type) (FlatMap left (lambda '(left_item) (FlatMap right (lambda '(right_item) (AsOptional (Apply impl left_item right_item))))))))
(let apply_nullable_left_optional (lambda '(left right impl result_type) (FlatMap left (lambda '(left_item) (AsOptional (Apply impl left_item right))))))
(let apply_nullable_binary (lambda '(left right impl result_type)
    (Apply (LazyBind spark_module
        (MatchType (TypeOf left)
            'Optional (lambda '() 'apply_nullable_left_dispatch)
            'Null (lambda '() 'apply_nullable_binary_null)
            (lambda '() 'apply_nullable_right_dispatch)
        )
    ) left right impl result_type)
))
(let apply_nullable_left_dispatch (lambda '(left right impl result_type) (Apply apply_nullable_left left right impl result_type)))
(let apply_nullable_right_dispatch (lambda '(left right impl result_type) (Apply apply_nullable_right left right impl result_type)))
(let apply_nullable_ternary_last (lambda '(first second third impl result_type)
    (Apply (LazyBind spark_module
        (MatchType (TypeOf third)
            'Optional (lambda '() 'apply_nullable_third_optional)
            'Null (lambda '() 'apply_nullable_ternary_null)
            (lambda '() 'apply_nullable_ternary_required)
        )
    ) first second third impl result_type)
))
(let apply_nullable_third_optional (lambda '(first second third impl result_type) (FlatMap third (lambda '(third_item) (AsOptional (Apply impl first second third_item))))))
(let apply_nullable_ternary_null (lambda '(first second third impl result_type) (Nothing (OptionalType result_type))))
(let apply_nullable_ternary_required (lambda '(first second third impl result_type) (AsOptional (Apply impl first second third))))
(let apply_nullable_ternary_second (lambda '(first second third impl result_type)
    (Apply (LazyBind spark_module
        (MatchType (TypeOf second)
            'Optional (lambda '() 'apply_nullable_second_optional)
            'Null (lambda '() 'apply_nullable_ternary_null)
            (lambda '() 'apply_nullable_third_dispatch)
        )
    ) first second third impl result_type)
))
(let apply_nullable_second_optional (lambda '(first second third impl result_type) (FlatMap second (lambda '(second_item) (Apply apply_nullable_ternary_last first second_item third impl result_type)))))
(let apply_nullable_third_dispatch (lambda '(first second third impl result_type) (Apply apply_nullable_ternary_last first second third impl result_type)))
(let apply_nullable_ternary (lambda '(first second third impl result_type)
    (Apply (LazyBind spark_module
        (MatchType (TypeOf first)
            'Optional (lambda '() 'apply_nullable_first_optional)
            'Null (lambda '() 'apply_nullable_ternary_null)
            (lambda '() 'apply_nullable_second_dispatch)
        )
    ) first second third impl result_type)
))
(let apply_nullable_first_optional (lambda '(first second third impl result_type) (FlatMap first (lambda '(first_item) (Apply apply_nullable_ternary_second first_item second third impl result_type)))))
(let apply_nullable_second_dispatch (lambda '(first second third impl result_type) (Apply apply_nullable_ternary_second first second third impl result_type)))

(let nullif (lambda '(left right) (NullIf left right)))
(let nullifzero_impl (lambda '(value) (NullIf value (- value value))))
(let nullifzero (lambda '(value) (MatchType (TypeOf value)
    'Optional (lambda '() (FlatMap value nullifzero_impl))
    'Null (lambda '() (NullIf value value))
    (lambda '() (Apply nullifzero_impl value))
)))
(let untag_day_interval (lambda '(value) (IfType value (TaggedType (DataType 'Interval64) 'SparkIntervalDay)
    (lambda '() (Untag value 'SparkIntervalDay))
    (lambda '() value)
)))
(let common_interval_value (lambda '(value other) (MatchType (Apply remove_optional_type (TypeOf other))
    'Interval64 (lambda '() (MatchType (TypeOf value)
        'Optional (lambda '() (Map value untag_day_interval))
        (lambda '() (Apply untag_day_interval value))
    ))
    (lambda '() value)
)))
(let compare_values (lambda '(left right impl) (block '(
    (let common_left (Apply common_interval_value left right))
    (let common_right (Apply common_interval_value right left))
    (let common_type (ListItemType (TypeOf (AsList common_left common_right))))
    (return (Apply impl
        (Unwrap (SafeCast common_left common_type) (String 'Comparison_cast_failed))
        (Unwrap (SafeCast common_right common_type) (String 'Comparison_cast_failed))))
))))
(let equals_impl (lambda '(left right) (AggrEquals left right)))
(let equal_null_right (lambda '(left right) (MatchType (TypeOf right)
    'Null (lambda '() (Bool '0))
    'Optional (lambda '() (Coalesce (Map right (lambda '(right_item) (Apply compare_values left right_item equals_impl))) (Bool '0)))
    (lambda '() (Apply compare_values left right equals_impl))
)))
(let equal_null (lambda '(left right) (MatchType (TypeOf left)
    'Null (lambda '() (Not (Exists right)))
    'Optional (lambda '() (Coalesce (Map left (lambda '(left_item) (Apply equal_null_right left_item right))) (Not (Exists right))))
    (lambda '() (Apply equal_null_right left right))
)))
(let isnull (lambda '(value) (Not (Exists value))))
(let isnotnull (lambda '(value) (Exists value)))
(let comparison (lambda '(left right impl) (Apply apply_nullable_binary left right
    (lambda '(left_item right_item) (Apply compare_values left_item right_item impl)) (DataType 'Bool))))
(let op_eq (lambda '(left right) (Apply comparison left right equals_impl)))
(let op_gt (lambda '(left right) (Apply comparison left right (lambda '(left_item right_item) (AggrGreater left_item right_item)))))
(let op_ge (lambda '(left right) (Apply comparison left right (lambda '(left_item right_item) (AggrGreaterOrEqual left_item right_item)))))
(let op_lt (lambda '(left right) (Apply comparison left right (lambda '(left_item right_item) (AggrLess left_item right_item)))))
(let op_le (lambda '(left right) (Apply comparison left right (lambda '(left_item right_item) (AggrLessOrEqual left_item right_item)))))
(let between (lambda '(value lower upper) (And (Apply op_ge value lower) (Apply op_le value upper))))
(let boolean_argument (lambda '(value) (MatchType (TypeOf value)
    'Null (lambda '() (Nothing (OptionalType (DataType 'Bool))))
    'Optional (lambda '() (EnsureType value (OptionalType (DataType 'Bool)) 'Expected_boolean_argument))
    (lambda '() (EnsureType value (DataType 'Bool) 'Expected_boolean_argument))
)))
(let isunknown (lambda '(value) (Apply isnull (Apply boolean_argument value))))
(let isnotunknown (lambda '(value) (Apply isnotnull (Apply boolean_argument value))))
(let op_and (lambda '(left right) (And (Apply boolean_argument left) (Apply boolean_argument right))))
(let op_or (lambda '(left right) (Or (Apply boolean_argument left) (Apply boolean_argument right))))
(let op_not (lambda '(value) (Not (Apply boolean_argument value))))
(let row_count (lambda '(value) (block '(
    (let value (MatchType (TypeOf value)
        'Optional (lambda '() (Unwrap value (String '"LIMIT/OFFSET must not be NULL")))
        (lambda '() value)))
    (let value (EnsureType value (DataType 'Int32) '"LIMIT/OFFSET must have INT type"))
    (return (Unwrap (SafeCast value (DataType 'Uint64)) (String '"LIMIT/OFFSET must be non-negative")))
))))

(let where_predicate (lambda '(value) (MatchType (TypeOf value)
    'Optional (lambda '() (EnsureType value (OptionalType (DataType 'Bool)) 'Expected_boolean_WHERE_predicate))
    (lambda '() (EnsureType value (DataType 'Bool) 'Expected_boolean_WHERE_predicate))
)))
(let case_condition (lambda '(value) (EnsureType value
    (MatchType (TypeOf value) 'Optional (lambda '() (OptionalType (DataType 'Bool))) (lambda '() (DataType 'Bool)))
    '"CASE WHEN requires a Boolean condition")))
(let like (lambda '(value pattern escape) (Apply apply_nullable_binary value pattern
    (lambda '(text pattern) (Apply
        (Udf 'Re2.Match '((Apply (Udf 'Re2.PatternFromLikeSpark) (ToString pattern) escape) (Apply (Udf 'Re2.Options))))
        (ToString text))) (DataType 'Bool))))
(let rlike (lambda '(value pattern) (Apply apply_nullable_binary value pattern
    (lambda '(text pattern) (block '(
        (let pattern (ToString pattern))
        (let options (Apply (Udf 'Re2.Options)))
        (let pattern (Ensure pattern (Apply (Udf 'Re2.IsValidRegexp) pattern options)
            (String '"Spark RLIKE pattern is invalid or unsupported by RE2")))
        (return (Apply (Udf 'Re2.Grep '(pattern options)) (ToString text)))
    )))
    (DataType 'Bool))))

(let current_date (lambda '() (SafeCast (CurrentUtcDate) (DataType 'Date32))))
(let current_timestamp (lambda '() (SafeCast (CurrentUtcTimestamp) (DataType 'Timestamp64))))

(let timestamp_value (lambda '(value) (MatchType (TypeOf value)
    'Date32 (lambda '() (Unwrap (SafeCast value (DataType 'Timestamp64)) (String '"Spark date is outside the timestamp range")))
    (lambda '() (EnsureType value (DataType 'Timestamp64) '"Spark timestamp arithmetic requires a Date32 or Timestamp64"))
)))
(let timestamp_quantity (lambda '(value) (MatchType (TypeOf value)
    'Int8 (lambda '() (Convert value 'Int64)) 'Int16 (lambda '() (Convert value 'Int64))
    'Int32 (lambda '() (Convert value 'Int64))
    (lambda '() (EnsureType value (DataType 'Int64) '"Spark TIMESTAMPADD requires an integral quantity"))
)))
(let timestamp_micros (lambda '(value) (SqlCall 'DateTime2.ToMicroseconds '((PositionalArgs (Apply timestamp_value value))))))
(let timestamp_add_fixed (lambda '(quantity value scale) (Apply apply_nullable_binary quantity value
    (lambda '(quantity value) (block '(
        (let delta (Unwrap (CheckedMul (Apply timestamp_quantity quantity) scale) (String '"Spark TIMESTAMPADD interval overflow")))
        (let micros (Unwrap (CheckedAdd (Apply timestamp_micros value) delta) (String '"Spark TIMESTAMPADD overflow")))
        (return (Unwrap (SqlCall 'DateTime2.FromMicroseconds64 '((PositionalArgs micros))) (String '"Spark TIMESTAMPADD result is outside the timestamp range")))
    ))) (DataType 'Timestamp64))))
(let timestamp_add_months (lambda '(quantity value scale) (Apply apply_nullable_binary quantity value
    (lambda '(quantity value) (block '(
        (let months (Unwrap (CheckedMul (Apply timestamp_quantity quantity) scale) (String '"Spark TIMESTAMPADD month overflow")))
        (let months (Unwrap (SafeCast months (DataType 'Int32)) (String '"Spark TIMESTAMPADD month count is outside the supported range")))
        (let parts (SqlCall 'DateTime2.Split '((PositionalArgs (Apply timestamp_value value)))))
        (return (Unwrap (SqlCall 'DateTime2.MakeTimestamp64 '((PositionalArgs (SqlCall 'DateTime2.ShiftMonths '((PositionalArgs parts months))))))
            (String '"Spark TIMESTAMPADD result is outside the timestamp range")))
    ))) (DataType 'Timestamp64))))
(let timestamp_diff_fixed (lambda '(start end scale) (Apply apply_nullable_binary start end
    (lambda '(start end) (Unwrap (Div
        (Unwrap (CheckedSub (Apply timestamp_micros end) (Apply timestamp_micros start)) (String '"Spark TIMESTAMPDIFF overflow"))
        scale) (String '"Spark TIMESTAMPDIFF invalid unit scale"))) (DataType 'Int64))))
(let timestamp_month_parts (lambda '(value) (block '(
    (let parts (SqlCall 'DateTime2.Split '((PositionalArgs (Apply timestamp_value value)))))
    (let year (Convert (SqlCall 'DateTime2.GetYear '((PositionalArgs parts))) 'Int64))
    (let year (If (< year (Int64 '0)) (+ year (Int64 '1)) year))
    (let month (+ (* year (Int64 '12))
        (Convert (SqlCall 'DateTime2.GetMonth '((PositionalArgs parts))) 'Int64)))
    (let micros (Apply timestamp_micros value))
    (let day_length (Int64 '86400000000))
    (let remainder (Unwrap (Mod micros day_length) (String '"Spark TIMESTAMPDIFF invalid day length")))
    (let time (Unwrap (Mod (+ remainder day_length) day_length) (String '"Spark TIMESTAMPDIFF invalid day length")))
    (return '(month '((SqlCall 'DateTime2.GetDayOfMonth '((PositionalArgs parts))) time)))
))))
(let timestamp_diff_months (lambda '(start end scale) (Apply apply_nullable_binary start end
    (lambda '(start end) (block '(
        (let start_parts (Apply timestamp_month_parts start))
        (let end_parts (Apply timestamp_month_parts end))
        (let months (- (Nth end_parts '0) (Nth start_parts '0)))
        (let months (If (And (> months (Int64 '0)) (AggrLess (Nth end_parts '1) (Nth start_parts '1))) (- months (Int64 '1))
            (If (And (< months (Int64 '0)) (AggrGreater (Nth end_parts '1) (Nth start_parts '1))) (+ months (Int64 '1)) months)))
        (return (Unwrap (Div months scale) (String '"Spark TIMESTAMPDIFF invalid month scale")))
    ))) (DataType 'Int64))))

(let cast_boolean_string (lambda '(value type) (block '(
    (let text (Apply (Udf 'String.AsciiToLower) (Apply (Udf 'String.Strip) (ToString value))))
    (return (If (SqlIn (AsList (String 'true) (String 't) (String 'yes) (String 'y) (String '1)) text '()) (Just (Bool 'true))
        (If (SqlIn (AsList (String 'false) (String 'f) (String 'no) (String 'n) (String '0)) text '()) (Just (Bool 'false))
            (Nothing (OptionalType (DataType 'Bool))))))
))))
(let cast_boolean_floating (lambda '(value type) (block '(
    (let number (Convert value 'Double))
    (return (Just (If (Apply (Udf 'Math.IsNaN) number) (Bool 'true) (!= number (Double '0)))))
))))
(let cast_identity (lambda '(value type) value))
(let cast_safe (lambda '(value type) (SafeCast value type)))
(let cast_optional (lambda '(value type) (AsOptional (SafeCast value type))))
(let cast_boolean_integral (lambda '(value type) (Just (!= (Convert value 'Int64) (Int64 '0)))))
(let cast_boolean_decimal (lambda '(value type) (Just (!= value (- value value)))))
(let cast_boolean_binary (lambda '(value type) (EnsureType value (VoidType) '"Cannot cast Spark BINARY to BOOLEAN")))
(let cast_boolean_unsupported (lambda '(value type) (EnsureType value (VoidType) '"Unsupported source type for Spark CAST to BOOLEAN")))
(let cast_boolean_converter (lambda '(source_type) (MatchType source_type
    'Utf8 (lambda '() 'cast_boolean_string)
    'String (lambda '() 'cast_boolean_binary)
    'Bool (lambda '() 'cast_identity)
    'Decimal (lambda '() 'cast_boolean_decimal)
    'Float (lambda '() 'cast_boolean_floating)
    'Double (lambda '() 'cast_boolean_floating)
    'Int8 (lambda '() 'cast_boolean_integral)
    'Int16 (lambda '() 'cast_boolean_integral)
    'Int32 (lambda '() 'cast_boolean_integral)
    'Int64 (lambda '() 'cast_boolean_integral)
    (lambda '() 'cast_boolean_unsupported)
)))
(let cast_floating_integer (lambda '(value type lower upper) (block '(
    (let number (Convert value 'Double))
    (let in_range (And (< number upper) (>= (Apply (Udf 'Math.Ceil) number) lower)))
    (return (If in_range
        (SafeCast (Apply (Udf 'Math.Trunc) number) type)
        (Nothing (OptionalType type))))
))))
(let cast_floating_bigint (lambda '(value type)
    # Spark accepts exactly 2^63 and the JVM conversion saturates it to Long.MAX_VALUE.
    (If (== (Convert value 'Double) (Double '9223372036854775808))
        (Just (Int64 '9223372036854775807))
        (Apply cast_floating_integer value type (Double '-9223372036854775808) (Double '9223372036854775808)))
))
(let cast_decimal_integer (lambda '(value type)
    # Decimal SafeCast rounds and rejects Decimal(p,p); parse its exact integral part instead.
    (SafeCast (Unwrap (Head (Apply (Udf 'String.SplitToList) (ToString value) (String '.)))) type)
))
(let cast_decimal_string (lambda '(value) (block '(
    (let components (ToIndexDict (DataTypeComponents (TypeHandle (TypeOf value)))))
    (let scale (Unwrap (FromString (Unwrap (Lookup components (Uint64 '2))) 'Uint64)))
    (let parts (ToIndexDict (Apply (Udf 'String.SplitToList) (ToString value) (String '.))))
    (let integer (Unwrap (Lookup parts (Uint64 '0))))
    (let fraction (Coalesce (Lookup parts (Uint64 '1)) (String '"")))
    (return (If (== scale (Uint64 '0)) integer
        (Concat (Concat integer (String '.)) (Apply (Udf 'String.RightPad) fraction scale (Just (String '0))))))
))))
(let cast_number_string (lambda '(value type) (Unwrap (SafeCast (ToString value) type) (String 'Expected_ASCII_number))))
(let cast_decimal_utf8 (lambda '(value type) (Unwrap (SafeCast (Apply cast_decimal_string value) type) (String 'Expected_ASCII_number))))
(let cast_string_converter (lambda '(source_type) (MatchType source_type
    'Utf8 (lambda '() 'cast_identity)
    'String (lambda '() 'cast_safe)
    'Decimal (lambda '() 'cast_decimal_utf8)
    (lambda '() 'cast_number_string)
)))
(let cast_utf8_binary (lambda '(value type) (ToString value)))
(let cast_binary_checked (lambda '(value type) (EnsureType value type '"Spark CAST to BINARY requires STRING or BINARY")))
(let cast_binary_converter (lambda '(source_type) (MatchType source_type
    'Utf8 (lambda '() 'cast_utf8_binary)
    (lambda '() 'cast_binary_checked)
)))
(let cast_string_numeric (lambda '(value type) (SafeCast (Apply (Udf 'String.Strip) (ToString value)) type)))
(let cast_binary_numeric (lambda '(value type) (EnsureType value (VoidType) '"Cannot cast Spark BINARY to a numeric type")))
(let cast_numeric_converter (lambda '(source_type floating double decimal) (MatchType source_type
    'Utf8 (lambda '() 'cast_string_numeric)
    'String (lambda '() 'cast_binary_numeric)
    'Bool (lambda '() 'cast_optional)
    'Float (lambda '() floating)
    'Double (lambda '() double)
    'Decimal (lambda '() decimal)
    (lambda '() 'cast_safe)
)))
(let cast_floating_tinyint (lambda '(value type) (Apply cast_floating_integer value type (Double '-128) (Double '128))))
(let cast_floating_smallint (lambda '(value type) (Apply cast_floating_integer value type (Double '-32768) (Double '32768))))
(let cast_floating_int (lambda '(value type) (Apply cast_floating_integer value type (Double '-2147483648) (Double '2147483648))))
(let cast_tinyint_converter (lambda '(source_type) (Apply cast_numeric_converter source_type 'cast_floating_tinyint 'cast_floating_tinyint 'cast_decimal_integer)))
(let cast_smallint_converter (lambda '(source_type) (Apply cast_numeric_converter source_type 'cast_floating_smallint 'cast_floating_smallint 'cast_decimal_integer)))
(let cast_int_converter (lambda '(source_type) (Apply cast_numeric_converter source_type 'cast_floating_int 'cast_floating_int 'cast_decimal_integer)))
(let cast_bigint_converter (lambda '(source_type) (Apply cast_numeric_converter source_type 'cast_floating_bigint 'cast_floating_bigint 'cast_decimal_integer)))
(let cast_float_converter (lambda '(source_type) (Apply cast_numeric_converter source_type 'cast_safe 'cast_optional 'cast_optional)))
(let cast_double_converter (lambda '(source_type) (Apply cast_numeric_converter source_type 'cast_safe 'cast_safe 'cast_optional)))
(let cast_ansi_result (lambda '(value convert) (Unwrap (Apply convert value) (String '"Spark CAST failed"))))
(let cast_ansi_numeric_result (lambda '(value convert) (block '(
    (let result (Apply cast_ansi_result value convert))
    (return (MatchType (TypeOf value)
        'Utf8 (lambda '() (Just result))
        (lambda '() result)))
))))
(let cast_ansi_integer_result (lambda '(value convert) (block '(
    (let result (Apply cast_ansi_result value convert))
    (let nullable (lambda '() (Just result)))
    (return (MatchType (TypeOf value)
        'Utf8 nullable 'Float nullable 'Double nullable 'Decimal nullable
        (lambda '() result)))
))))
(let cast_nullable (lambda '(value type convert) (MatchType (TypeOf value)
    'Null (lambda '() (Nothing (OptionalType type)))
    'Optional (lambda '() (FlatMap value (lambda '(item) (AsOptional (Apply convert item)))))
    (lambda '() (Apply convert value))
)))
(let cast_convert (lambda '(value type select)
    (Apply (LazyBind spark_module (Apply select (TypeOf value))) value type)))
(let cast_interval (lambda '(value scale type)
    (Apply cast_nullable value type (lambda '(item) (block '(
        (let interval (EnsureType (Apply untag_day_interval item) (DataType 'Interval64)
            '"Spark interval CAST requires a day-time interval"))
        (let truncated (* (Unwrap (Div (Convert interval 'Int64) scale)) scale))
        (let result (Unwrap (SafeCast truncated (DataType 'Interval64))))
        (return (MatchType type
            'Tagged (lambda '() (AsTagged result 'SparkIntervalDay))
            (lambda '() result)))
    ))))))
(let cast_interval_day (lambda '(value) (Apply cast_interval value (Int64 '86400000000) (TaggedType (DataType 'Interval64) 'SparkIntervalDay))))
(let cast_interval_hour (lambda '(value) (Apply cast_interval value (Int64 '3600000000) (DataType 'Interval64))))
(let cast_interval_minute (lambda '(value) (Apply cast_interval value (Int64 '60000000) (DataType 'Interval64))))
(let cast_interval_second (lambda '(value) (Apply cast_interval value (Int64 '1) (DataType 'Interval64))))
(let try_cast_interval_day cast_interval_day)
(let try_cast_interval_hour cast_interval_hour)
(let try_cast_interval_minute cast_interval_minute)
(let try_cast_interval_second cast_interval_second)
(let cast_entry (lambda '(type select result) (lambda '(value)
    (Apply cast_nullable value type (lambda '(item)
        (Apply result item (lambda '(value) (Apply cast_convert value type select))))))))
(let try_cast_entry (lambda '(type select) (lambda '(value)
    (Apply cast_nullable value type (lambda '(item) (Apply cast_convert item type select))))))
(let cast_boolean (Apply cast_entry (DataType 'Bool) cast_boolean_converter cast_ansi_numeric_result))
(let cast_tinyint (Apply cast_entry (DataType 'Int8) cast_tinyint_converter cast_ansi_integer_result))
(let cast_smallint (Apply cast_entry (DataType 'Int16) cast_smallint_converter cast_ansi_integer_result))
(let cast_int (Apply cast_entry (DataType 'Int32) cast_int_converter cast_ansi_integer_result))
(let cast_bigint (Apply cast_entry (DataType 'Int64) cast_bigint_converter cast_ansi_integer_result))
(let cast_float (Apply cast_entry (DataType 'Float) cast_float_converter cast_ansi_numeric_result))
(let cast_double (Apply cast_entry (DataType 'Double) cast_double_converter cast_ansi_numeric_result))
(let cast_string (Apply cast_entry (DataType 'Utf8) cast_string_converter cast_ansi_result))
(let cast_binary (Apply cast_entry (DataType 'String) cast_binary_converter cast_ansi_result))
(let try_cast_boolean (Apply try_cast_entry (DataType 'Bool) cast_boolean_converter))
(let try_cast_tinyint (Apply try_cast_entry (DataType 'Int8) cast_tinyint_converter))
(let try_cast_smallint (Apply try_cast_entry (DataType 'Int16) cast_smallint_converter))
(let try_cast_int (Apply try_cast_entry (DataType 'Int32) cast_int_converter))
(let try_cast_bigint (Apply try_cast_entry (DataType 'Int64) cast_bigint_converter))
(let try_cast_float (Apply try_cast_entry (DataType 'Float) cast_float_converter))
(let try_cast_double (Apply try_cast_entry (DataType 'Double) cast_double_converter))
(let try_cast_string (Apply try_cast_entry (DataType 'Utf8) cast_string_converter))
(let try_cast_binary (Apply try_cast_entry (DataType 'String) cast_binary_converter))
(let ifnull (lambda '(left right) (Coalesce
    (Apply common_interval_value left right)
    (Apply common_interval_value right left)
)))
(let aggregate_count_post (lambda '(value) (Unwrap (SafeCast value (DataType 'Int64)) (String '"Spark COUNT overflow"))))
(let aggregate_value_pre (lambda '(value ignore_nulls) (If
    (And (EnsureType ignore_nulls (DataType 'Bool) '"Spark ignoreNulls must be Boolean") (Not (Exists (AsOptional value))))
    (Nothing (OptionalType (TupleType (TypeOf value))))
    (Just '(value))
)))
(let aggregate_value_post (lambda '(value) (FlatMap (AsOptional value) (lambda '(row) (AsOptional (Nth row '0))))))
(let aggregate_nullable_post (lambda '(value) (AsOptional value)))
(let aggregate_numeric_value (lambda '(value) (MatchType (TypeOf value)
    'Int8 (lambda '() (Convert value 'Int64))
    'Int16 (lambda '() (Convert value 'Int64))
