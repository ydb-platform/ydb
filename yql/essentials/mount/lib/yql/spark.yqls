(
(let apply_nullable_right (lambda '(left right impl result_type) (MatchType (TypeOf right)
    'Optional (lambda '() (Map right (lambda '(item) (Apply impl left item))))
    'Null (lambda '() (Nothing (OptionalType result_type)))
    (lambda '() (Apply impl left right))
)))
(let apply_nullable_left (lambda '(left right impl result_type) (MatchType (TypeOf right)
    'Optional (lambda '() (FlatMap left (lambda '(left_item) (Map right (lambda '(right_item) (Apply impl left_item right_item))))))
    'Null (lambda '() (Nothing (OptionalType result_type)))
    (lambda '() (Map left (lambda '(left_item) (Apply impl left_item right))))
)))
(let apply_nullable_binary (lambda '(left right impl result_type) (MatchType (TypeOf left)
    'Optional (lambda '() (Apply apply_nullable_left left right impl result_type))
    'Null (lambda '() (Nothing (OptionalType result_type)))
    (lambda '() (Apply apply_nullable_right left right impl result_type))
)))
(let nullif (lambda '(left right) (NullIf left right)))
(let isnull (lambda '(value) (Not (Exists value))))
(let isnotnull (lambda '(value) (Exists value)))
(let ifnull (lambda '(left right) (Coalesce left right)))
(let nvl2 (lambda '(value when_not_null when_null) (If (Exists value) when_not_null when_null)))
(let binary_string_predicate (lambda '(left right predicate) (MatchType (TypeOf left)
    'String (lambda '() (AsOptional (Apply predicate left right)))
    (lambda '() (Apply predicate left right))
)))
(let startswith_impl (lambda '(left right) (Apply binary_string_predicate left right (lambda '(left right) (StartsWith left right)))))
(let endswith_impl (lambda '(left right) (Apply binary_string_predicate left right (lambda '(left right) (EndsWith left right)))))
(let contains_impl (lambda '(left right) (Apply binary_string_predicate left right (lambda '(left right) (StringContains left right)))))
(let startswith (lambda '(left right) (Apply apply_nullable_binary left right startswith_impl (DataType 'Bool))))
(let endswith (lambda '(left right) (Apply apply_nullable_binary left right endswith_impl (DataType 'Bool))))
(let contains (lambda '(left right) (Apply apply_nullable_binary left right contains_impl (DataType 'Bool))))
(let instr_impl (lambda '(value needle) (MatchType (TypeOf value)
    'String (lambda '() (Convert (Coalesce
        (Map (Find value needle (Uint64 '0)) (lambda '(position) (+ position (Uint64 '1))))
        (Uint64 '0)
    ) 'Int32))
    (lambda '() (Convert (Coalesce
        (Map (Apply (Udf 'Unicode.Find) value needle) (lambda '(position) (+ position (Uint64 '1))))
        (Uint64 '0)
    ) 'Int32))
)))
(let instr (lambda '(value needle) (Apply apply_nullable_binary value needle instr_impl (DataType 'Int32))))
(let lower_impl (lambda '(value)
    (Convert (Unwrap (FromPg (PgCall 'lower '( '('collation 'unicode)) (ToPg value))) (String 'Unexpected_NULL_from_PgCall)) 'Utf8)
))
(let apply_nullable (lambda '(value impl result_type) (MatchType (TypeOf value)
    'Optional (lambda '() (Map value impl))
    'Null (lambda '() (Nothing (OptionalType result_type)))
    (lambda '() (Apply impl value))
)))
(let base64_impl (lambda '(value) (Unwrap (SafeCast (Apply (Udf 'String.Base64Encode) value) (DataType 'Utf8)) (String 'Expected_base64_Utf8))))
(let base64 (lambda '(value) (Apply apply_nullable value base64_impl (DataType 'Utf8))))
(let hex_impl (lambda '(value) (Unwrap (Cast (MatchType (TypeOf value)
    'Utf8 (lambda '() (Apply (Udf 'String.HexEncode) (ToString value)))
    'String (lambda '() (Apply (Udf 'String.HexEncode) value))
    (lambda '() (EnsureType value (DataType 'Utf8) 'Expected_string))
) 'Utf8) (String 'Expected_hex_Utf8))))
(let hex (lambda '(value) (Apply apply_nullable value hex_impl (DataType 'Utf8))))
(let unhex_impl (lambda '(value) (Apply (Udf 'String.HexDecode) (ToString (EnsureType value (DataType 'Utf8) 'Expected_Utf8)))))
(let unhex (lambda '(value) (MatchType (TypeOf value)
    'Optional (lambda '() (FlatMap value unhex_impl))
    'Null (lambda '() (Nothing (OptionalType (DataType 'String))))
    (lambda '() (Apply unhex_impl value))
)))
(let digest_unary (lambda '(value impl) (Apply apply_nullable value (lambda '(item) (Unwrap (Cast (Apply impl (Convert item 'String)) 'Utf8) (String 'Expected_digest_Utf8))) (DataType 'Utf8))))
(let md5 (lambda '(value) (Apply digest_unary value (Udf 'Digest.Md5Hex))))
(let sha1 (lambda '(value) (Apply digest_unary value (lambda '(item) (Apply (Udf 'String.AsciiToLower) (Apply (Udf 'String.HexEncode) (Apply (Udf 'Digest.Sha1) item)))))))
(let unbase64_impl (lambda '(value) (Unwrap (Apply (Udf 'String.Base64Decode) (Convert value 'String)) (String 'Invalid_base64))))
(let unbase64 (lambda '(value) (Apply apply_nullable value unbase64_impl (DataType 'String))))
(let lpad_impl (lambda '(value length filler)
    (Convert
        (Unwrap
            (FromPg (PgCall 'lpad '( '('collation 'unicode)) (ToPg value) (ToPg (Convert length 'Int32)) (ToPg filler)))
            (String 'Unexpected_NULL_from_PgCall)
        )
        'Utf8
    )
))
(let rpad_impl (lambda '(value length filler)
    (Convert
        (Unwrap
            (FromPg (PgCall 'rpad '( '('collation 'unicode)) (ToPg value) (ToPg (Convert length 'Int32)) (ToPg filler)))
            (String 'Unexpected_NULL_from_PgCall)
        )
        'Utf8
    )
))
(let lpad3 (lambda '(value length filler) (Apply apply_nullable_binary value length
    (lambda '(value_item length_item) (Apply apply_nullable filler
        (lambda '(filler_item) (Apply lpad_impl value_item length_item filler_item))
        (DataType 'Utf8)
    ))
    (DataType 'Utf8)
)))
(let rpad3 (lambda '(value length filler) (Apply apply_nullable_binary value length
    (lambda '(value_item length_item) (Apply apply_nullable filler
        (lambda '(filler_item) (Apply rpad_impl value_item length_item filler_item))
        (DataType 'Utf8)
    ))
    (DataType 'Utf8)
)))
(let lpad2 (lambda '(value length) (Apply lpad3 value length (Utf8 '" "))))
(let rpad2 (lambda '(value length) (Apply rpad3 value length (Utf8 '" "))))
(let replace_impl (lambda '(value search replacement)
    (Apply (Udf 'Unicode.ReplaceAll)
        (EnsureType value (DataType 'Utf8) 'Expected_Utf8)
        (EnsureType search (DataType 'Utf8) 'Expected_Utf8)
        (EnsureType replacement (DataType 'Utf8) 'Expected_Utf8)
    )
))
(let replace3 (lambda '(value search replacement) (Apply apply_nullable_binary value search
    (lambda '(value_item search_item) (Apply apply_nullable replacement
        (lambda '(replacement_item) (Apply replace_impl value_item search_item replacement_item))
        (DataType 'Utf8)
    ))
    (DataType 'Utf8)
)))
(let replace2 (lambda '(value search) (Apply replace3 value search (Utf8 '""))))
(let substring_source_length (lambda '(value)
    (Convert (Apply (Udf 'Unicode.GetLength) (EnsureType value (DataType 'Utf8) 'Expected_Utf8)) 'Int32)
))
(let substring_position (lambda '(value position)
    (If (< position (Int32 '0))
        (+ (+ (Apply substring_source_length value) position) (Int32 '1))
        (If (== position (Int32 '0)) (Int32 '1) position)
    )
))
(let substring_result_length (lambda '(length)
    (If (< (Convert length 'Int32) (Int32 '0)) (Int32 '0) (Convert length 'Int32))
))
(let substring2_impl (lambda '(value position)
    (Unwrap (Apply (Udf 'Unicode.Substring)
        (EnsureType value (DataType 'Utf8) 'Expected_Utf8)
        (Convert (- (Apply substring_position value (Convert position 'Int32)) (Int32 '1)) 'Uint64)
    ) (String 'Unexpected_NULL_from_UnicodeSubstring))
))
(let substring2 (lambda '(value position) (Apply substring2_impl value position)))
(let substring3_impl (lambda '(value position length)
    (Unwrap (Apply (Udf 'Unicode.Substring)
        (EnsureType value (DataType 'Utf8) 'Expected_Utf8)
        (Convert (- (Apply substring_position value (Convert position 'Int32)) (Int32 '1)) 'Uint64)
        (Convert (Apply substring_result_length length) 'Uint64)
    ) (String 'Unexpected_NULL_from_UnicodeSubstring))
))
(let substring3 (lambda '(value position length) (Apply substring3_impl value position length)))
(let left (lambda '(value length) (Apply substring3 value (Int32 '1) length)))
(let right_position (lambda '(value length) (block '(
    (let source_length (Apply substring_source_length value))
    (let result_length (Apply substring_result_length length))
    (return (If (<= result_length source_length)
        (+ (- source_length result_length) (Int32 '1))
        (Int32 '1)
    ))
))))
(let right_impl (lambda '(value length)
    (Unwrap (Apply (Udf 'Unicode.Substring)
        (EnsureType value (DataType 'Utf8) 'Expected_Utf8)
        (Convert (- (Apply right_position value (Convert length 'Int32)) (Int32 '1)) 'Uint64)
        (Convert (Apply substring_result_length length) 'Uint64)
    ) (String 'Unexpected_NULL_from_UnicodeSubstring))
))
(let right (lambda '(value length) (AsOptional (Apply right_impl value length))))
(let reverse_impl (lambda '(value) (MatchType (TypeOf value)
    'Utf8 (lambda '() (Apply (Udf 'Unicode.Reverse) value))
    'String (lambda '() (Apply (Udf 'String.ReverseBytes) value))
    (lambda '() (EnsureType value (DataType 'String) 'Expected_String))
)))
(let reverse (lambda '(value) (Apply apply_nullable value reverse_impl (DataType 'Utf8))))
(let lower (lambda '(value) (Apply apply_nullable value lower_impl (DataType 'Utf8))))
(let upper_impl (lambda '(value)
    (Convert (Unwrap (FromPg (PgCall 'upper '( '('collation 'unicode)) (ToPg value))) (String 'Unexpected_NULL_from_PgCall)) 'Utf8)
))
(let upper (lambda '(value) (Apply apply_nullable value upper_impl (DataType 'Utf8))))
(let length_impl (lambda '(value) (Convert (MatchType (TypeOf value)
    'Utf8 (lambda '() (Apply (Udf 'Unicode.GetLength) value))
    (lambda '() (Size (EnsureType value (DataType 'String) 'Expected_String)))
) 'Int32)))
(let length (lambda '(value) (Apply apply_nullable value length_impl (DataType 'Int32))))
(let octet_length_impl (lambda '(value) (Convert (MatchType (TypeOf value)
    'Utf8 (lambda '() (Size value))
    (lambda '() (Size (EnsureType value (DataType 'String) 'Expected_String)))
) 'Int32)))
(let octet_length (lambda '(value) (Apply apply_nullable value octet_length_impl (DataType 'Int32))))
(let bit_length_impl (lambda '(value) (* (Apply octet_length_impl value) (Int32 '8))))
(let bit_length (lambda '(value) (Apply apply_nullable value bit_length_impl (DataType 'Int32))))
(let math_unary (lambda '(value impl) (MatchType (TypeOf value)
    'Optional (lambda '() (Map value (lambda '(item) (Apply impl (SafeCast item (DataType 'Double))))))
    'Null (lambda '() (Nothing (OptionalType (DataType 'Double))))
    (lambda '() (AsOptional (Apply impl (SafeCast value (DataType 'Double)))))
)))
(let math_binary (lambda '(left right impl)
    (Apply apply_nullable_binary left right
        (lambda '(left_item right_item) (Apply impl (Convert left_item 'Double) (Convert right_item 'Double)))
        (DataType 'Double)
    )
))
(let sqrt (lambda '(value) (Apply math_unary value (Udf 'Math.Sqrt))))
(let cbrt (lambda '(value) (Apply math_unary value (Udf 'Math.Cbrt))))
(let acos (lambda '(value) (Apply math_unary value (Udf 'Math.Acos))))
(let asin (lambda '(value) (Apply math_unary value (Udf 'Math.Asin))))
(let atan (lambda '(value) (Apply math_unary value (Udf 'Math.Atan))))
(let cosh (lambda '(value) (Apply math_unary value (Udf 'Math.Cosh))))
(let sinh (lambda '(value) (Apply math_unary value (Udf 'Math.Sinh))))
(let tanh (lambda '(value) (Apply math_unary value (Udf 'Math.Tanh))))
(let sin (lambda '(value) (Apply math_unary value (Udf 'Math.Sin))))
(let cos (lambda '(value) (Apply math_unary value (Udf 'Math.Cos))))
(let tan (lambda '(value) (Apply math_unary value (Udf 'Math.Tan))))
(let exp (lambda '(value) (Apply math_unary value (Udf 'Math.Exp))))
(let e (lambda '() (Apply (Udf 'Math.E))))
(let pi (lambda '() (Apply (Udf 'Math.Pi))))
(let log (lambda '(value) (Apply math_unary value (Udf 'Math.Log))))
(let log10 (lambda '(value) (Apply math_unary value (Udf 'Math.Log10))))
(let log2 (lambda '(value) (Apply math_unary value (Udf 'Math.Log2))))
(let asinh (lambda '(value) (Apply math_unary value (Udf 'Math.Asinh))))
(let rint (lambda '(value) (Apply math_unary value (Udf 'Math.Rint))))
(let sign_impl (lambda '(value) (If (> value (Double '0.0)) (Double '1.0) (If (< value (Double '0.0)) (Double '-1.0) value))))
(let sign (lambda '(value) (Apply math_unary value sign_impl)))
(let degrees_impl (lambda '(value) (/ (* value (Double '180.0)) (Apply (Udf 'Math.Pi)))))
(let radians_impl (lambda '(value) (/ (* value (Apply (Udf 'Math.Pi))) (Double '180.0))))
(let degrees (lambda '(value) (Apply math_unary value degrees_impl)))
(let radians (lambda '(value) (Apply math_unary value radians_impl)))
(let atan2 (lambda '(left right) (Apply math_binary left right (Udf 'Math.Atan2))))
(let hypot (lambda '(left right) (Apply math_binary left right (Udf 'Math.Hypot))))
(let pow (lambda '(left right) (Apply math_binary left right (Udf 'Math.Pow))))
