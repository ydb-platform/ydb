# yamake2gn: keep  -- hand-written, do not regenerate

import("//build/gn/antlr.gni")

copy("stg") {
  sources = [
    "//yql/essentials/parser/antlr_ast/org/antlr/v4/tool/templates/codegen/Cpp/Cpp.stg",
    "//yql/essentials/parser/antlr_ast/org/antlr/v4/tool/templates/codegen/Cpp/Files.stg",
  ]
  outputs = [ "$target_gen_dir/org/antlr/v4/tool/templates/codegen/Cpp/{{source_file_part}}" ]
}

expand_template("grammar") {
  sources = [ "//yql/essentials/sql/v1/SQLv1Antlr4.g.in" ]
  output_dir = target_gen_dir
  substitutions = [
    "GRAMMAR_STRING_CORE_SINGLE=~(['\\\\]) | (BACKSLASH .)",
    "GRAMMAR_STRING_CORE_DOUBLE=~([\"\\\\]) | (BACKSLASH .)",
    "GRAMMAR_MULTILINE_COMMENT_CORE=.",
  ]
}

_grammar_files = get_target_outputs(":grammar")

antlr4_run("antlr4_cpp") {
  grammar = _grammar_files[0]
  language = "Cpp"
  visitor = true
  templates_target = ":stg"
  templates_dir = target_gen_dir
  extra_args = [
    "-no-listener",
    "-package",
    "NALADefaultAntlr4",
  ]
  deps = [ ":grammar" ]
}

config("private_config") {
  cflags = [ "-Wno-unused-variable" ]
}

library("v1_antlr4") {
  sources = get_target_outputs(":antlr4_cpp")
  deps = [ ":antlr4_cpp" ]
  public_deps = [ "//contrib/libs/antlr4_cpp_runtime" ]
  configs = [ ":private_config" ]
}
