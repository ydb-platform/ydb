# yamake2gn: keep  -- hand-written, do not regenerate

import("//build/gn/antlr.gni")

_grammar = "//yql/essentials/minikql/jsonpath/JsonPath.g"

# Private copies: other modules configure the same .stg.in with other values.
# antlr finds them by the resource path below, relative to templates_dir.
expand_template("java_stg") {
  sources = [ "//yql/essentials/parser/proto_ast/org/antlr/v4/tool/templates/codegen/Java/Java.stg.in" ]
  output_dir = "$target_gen_dir/org/antlr/v4/tool/templates/codegen/Java"
  substitutions = [
    "ANTLR_AST_NAME=TJsonPathParserAST",
    "ANTLR_PACKAGE_NAME=NJsonPathGenerated",
  ]
}

expand_template("cpp_stg") {
  sources = [
    "//yql/essentials/parser/proto_ast/org/antlr/v4/tool/templates/codegen/Cpp/Cpp.stg.in",
    "//yql/essentials/parser/proto_ast/org/antlr/v4/tool/templates/codegen/Cpp/Files.stg.in",
  ]
  output_dir = "$target_gen_dir/org/antlr/v4/tool/templates/codegen/Cpp"
  substitutions = [
    "ANTLR_AST_NAME=TJsonPathParserAST",
    "ANTLR_PACKAGE_NAME=NJsonPathGenerated",
    "ANTLR_PARSER_NAME=JsonPathParser",
    "PROTOBUF_HEADER_PATH=yql/essentials/parser/proto_ast/gen/jsonpath",
    "PROTOBUF_SUFFIX_PATH=.pb.h",
  ]
}

antlr4_run("antlr4_proto") {
  grammar = _grammar
  language = "Java"
  templates_target = ":java_stg"
  templates_dir = target_gen_dir
  extra_args = [ "-no-listener" ]
}

protobuf_library("proto") {
  sources = get_target_outputs(":antlr4_proto")
  generated_sources = true
  deps = [ ":antlr4_proto" ]
  public_deps = [ "//yql/essentials/public/issue/protos" ]
}

antlr4_run("antlr4_cpp") {
  grammar = _grammar
  language = "Cpp"
  templates_target = ":cpp_stg"
  templates_dir = target_gen_dir
  extra_args = [
    "-no-listener",
    "-package",
    "NALP",
  ]
  deps = [ ":proto" ]
}

library("jsonpath") {
  sources = get_target_outputs(":antlr4_cpp")

  deps = [ ":antlr4_cpp" ]

  public_deps = [
    ":proto",
    "//contrib/libs/antlr4_cpp_runtime",
    "//yql/essentials/parser/proto_ast/antlr4",
  ]
}
