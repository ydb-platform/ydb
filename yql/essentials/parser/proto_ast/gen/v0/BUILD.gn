# yamake2gn: keep  -- hand-written, do not regenerate

import("//build/gn/antlr.gni")

expand_template("stg") {
  sources = [ "//yql/essentials/parser/proto_ast/org/antlr/codegen/templates/Cpp/Cpp.stg.in" ]

  output_dir = "$target_gen_dir/org/antlr/codegen/templates/Cpp"

  substitutions = [
    "ANTLR_PACKAGE_NAME=NSQLGenerated",
    "PROTOBUF_HEADER_PATH=yql/essentials/parser/proto_ast/gen/v0_proto_split",
    "LEXER_PARSER_NAMESPACE=NALP",
    "PROTOBUF_SUFFIX_PATH=.pb.h",
  ]
}

antlr3_run("antlr3_cpp") {
  grammar = "//yql/essentials/sql/v0/SQL.g"
  language = "Cpp"
  templates_target = ":stg"
  templates_dir = target_gen_dir
}

library("v0") {
  sources = get_target_outputs(":antlr3_cpp")

  deps = [ ":antlr3_cpp" ]

  public_deps = [
    "//contrib/libs/antlr3_cpp_runtime",
    "//yql/essentials/parser/proto_ast/antlr3",
    "//yql/essentials/parser/proto_ast/gen/v0_proto_split",
  ]
}
