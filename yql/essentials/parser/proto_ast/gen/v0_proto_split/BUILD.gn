# yamake2gn: keep  -- hand-written, do not regenerate

import("//build/gn/antlr.gni")

expand_template("stg") {
  sources = [ "//yql/essentials/parser/proto_ast/org/antlr/codegen/templates/protobuf/protobuf.stg.in" ]
  output_dir = "$target_gen_dir/org/antlr/codegen/templates/protobuf"
  substitutions = [ "ANTLR_PACKAGE_NAME=NSQLGenerated" ]
}

antlr3_run("antlr3_proto") {
  grammar = "//yql/essentials/sql/v0/SQL.g"
  language = "protobuf"
  templates_target = ":stg"
  templates_dir = target_gen_dir
}

_name = "SQLParser"
_proto = get_target_outputs(":antlr3_proto")

_protoc = "//contrib/tools/protoc:protoc($tool_toolchain)"
_cpp_styleguide = "//contrib/tools/protoc/plugins/cpp_styleguide($tool_toolchain)"

action("protoc") {
  script = "//build/gn/scripts/protoc.py"
  sources = _proto
  outputs = [
    "$target_gen_dir/$_name.pb.cc",
    "$target_gen_dir/$_name.pb.h",
  ]
  args = [ rebase_path("//", root_build_dir) ] + rebase_path(outputs, root_build_dir) + [
    "--",
    "./" + rebase_path(get_label_info(_protoc, "root_out_dir") + "/protoc", root_build_dir),
    "-I", rebase_path("//", root_build_dir),
    "-I", rebase_path("//contrib/libs/protobuf/src", root_build_dir),
    "-I", rebase_path(root_gen_dir, root_build_dir),
    "--fatal_warnings",
    "--cpp_out", rebase_path(root_gen_dir),
    "--cpp_styleguide_out", rebase_path(root_gen_dir),
    "--plugin=protoc-gen-cpp_styleguide=" + rebase_path(get_label_info(_cpp_styleguide, "root_out_dir") + "/cpp_styleguide"),
  ] + rebase_path(_proto, root_build_dir)
  deps = [
    ":antlr3_proto",
    _protoc,
    _cpp_styleguide,
  ]
}

action("split") {
  script = "//yql/essentials/parser/proto_ast/gen/multiproto.py"
  inputs = get_target_outputs(":protoc")
  outputs = [
    "$target_gen_dir/$_name.pb.code0.cc",
    "$target_gen_dir/$_name.pb.code1.cc",
    "$target_gen_dir/$_name.pb.code2.cc",
    "$target_gen_dir/$_name.pb.code3.cc",
    "$target_gen_dir/$_name.pb.code4.cc",
    "$target_gen_dir/$_name.pb.code5.cc",
    "$target_gen_dir/$_name.pb.code6.cc",
    "$target_gen_dir/$_name.pb.code7.cc",
    "$target_gen_dir/$_name.pb.code8.cc",
    "$target_gen_dir/$_name.pb.code9.cc",
    "$target_gen_dir/$_name.pb.data.cc",
    "$target_gen_dir/$_name.pb.classes.h",
    "$target_gen_dir/$_name.pb.main.h",
  ]
  args = [
    _name,
    rebase_path(target_gen_dir, root_build_dir),
    rebase_path(target_gen_dir, root_build_dir),
  ]
  deps = [ ":protoc" ]
}

library("v0_proto_split") {
  sources = get_target_outputs(":split")
  public_deps = [
    ":protoc",
    ":split",
    "//contrib/libs/protobuf",
  ]
}
