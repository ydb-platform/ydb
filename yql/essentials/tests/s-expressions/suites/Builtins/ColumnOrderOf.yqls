(
(let config (DataSource 'config))
(let world (Configure! world config 'OrderedColumns))
(let res_sink (DataSink 'result))
(let row (AsStruct '('z (Int32 '1)) '('a (Int32 '2))))
(let ordered (AssumeColumnOrder (AsList row) '('z 'a)))
(let world (Write! world res_sink (Key) (ColumnOrderOf ordered) '('('type))))
(let world (Write! world res_sink (Key) (ColumnOrderOf (Take ordered (Uint64 '0))) '('('type))))
(let world (Write! world res_sink (Key) (ColumnOrderOf (AssumeColumnOrder row '('a 'z))) '('('type))))
(let world (Write! world res_sink (Key) (ColumnOrderOf row) '('('type))))
(let world (Write! world res_sink (Key) (ColumnOrderOf (AssumeColumnOrder (AsStruct) '())) '('('type))))
(let world (Write! world res_sink (Key) (ColumnOrderOf (AsStruct)) '('('type))))
(let duplicates (AsStruct '('x (Int32 '1)) '('x_generated_2 (String 'two))))
(let world (Write! world res_sink (Key) (ColumnOrderOf (AssumeColumnOrder duplicates '('x 'x))) '('('type))))
(let collision (AsStruct '('x (Int32 '1)) '('x_generated_2 (Int32 '2)) '('x_generated_3 (String 'three))))
(let world (Write! world res_sink (Key) (ColumnOrderOf (AssumeColumnOrder collision '('x 'x_generated_2 'x))) '('('type))))
(let side_effect (Write! world res_sink (Key) (String 'must_not_execute) '()))
(let effectful (AssumeColumnOrder (WithWorld (AsList row) side_effect) '('z 'a)))
(let world (Write! world res_sink (Key) (ColumnOrderOf effectful) '('('type))))
(let world (Commit! world res_sink))
(return world)
)
