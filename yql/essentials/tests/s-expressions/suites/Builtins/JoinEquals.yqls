(
(let sink (DataSink 'result))
(let integer_null (Nothing (OptionalType (DataType 'Int32))))
(let nan (Double 'nan))
(let optional_nan (Just nan))
(let decimal_nan (Decimal 'nan '22 '9))
(let pg_nan (PgConst 'NaN (PgType 'float8)))
(let pg_null (PgCast (Null) (PgType 'float8)))
(let empty (List (ListType (OptionalType (DataType 'Int32)))))
(let nullable_nans (AsList optional_nan (Nothing (OptionalType (DataType 'Double)))))
(let variant_type (VariantType (TupleType (DataType 'Double) (NullType))))
(let variant_nan (Variant nan '0 variant_type))
(let result (AsStruct
    '('equal (JoinEquals (Int32 '1) (Int32 '1)))
    '('unequal (JoinEquals (Int32 '1) (Int32 '2)))
    '('nan (JoinEquals nan nan))
    '('nan_finite (JoinEquals nan (Double '1)))
    '('float_nan (JoinEquals (Float 'nan) (Float 'nan)))
    '('decimal_nan (JoinEquals decimal_nan decimal_nan))
    '('optional_nan (JoinEquals optional_nan optional_nan))
    '('optional_value (JoinEquals (Just (Int32 '1)) (Just (Int32 '1))))
    '('optional_null (JoinEquals (Just (Int32 '1)) integer_null))
    '('both_null (JoinEquals integer_null integer_null))
    '('null_type (JoinEquals (Null) (Null)))
    '('nested_optional (JoinEquals (Just integer_null) (Just integer_null)))
    '('tuple_nan (JoinEquals '(nan (Int32 '1)) '(nan (Int32 '1))))
    '('tuple_nan_null (JoinEquals '(nan integer_null) '(nan integer_null)))
    '('tuple_nan_null_mismatch (JoinEquals '(nan integer_null (Int32 '1)) '(nan integer_null (Int32 '2))))
    '('optional_tuple_nan (JoinEquals (Just '(nan integer_null)) (Just '(nan integer_null))))
    '('tuple_null (JoinEquals '(integer_null (Int32 '1)) '(integer_null (Int32 '2))))
    '('struct_null (JoinEquals (AsStruct '('key integer_null)) (AsStruct '('key integer_null))))
    '('list_null (JoinEquals (AsList integer_null) (AsList integer_null)))
    '('empty_list (JoinEquals empty empty))
    '('list_nan_null (JoinEquals nullable_nans nullable_nans))
    '('list_nan_length (JoinEquals nullable_nans (AsList optional_nan)))
    '('variant_nan (JoinEquals variant_nan variant_nan))
    '('variant_null (JoinEquals variant_nan (Variant (Null) '1 variant_type)))
    '('variant_null_eq (== variant_nan (Variant (Null) '1 variant_type)))
    '('tagged_nan (JoinEquals (AsTagged optional_nan 'key) (AsTagged optional_nan 'key)))
    '('pg_nan (JoinEquals pg_nan pg_nan))
    '('pg_nan_eq (== pg_nan pg_nan))
    '('pg_float_nan_eq (== (PgConst 'NaN (PgType 'float4)) (PgConst 'NaN (PgType 'float4))))
    '('pg_null (JoinEquals pg_nan pg_null))
))
(let world (Write! world sink (Key) result '('('type))))
(return (Commit! world sink))
)
