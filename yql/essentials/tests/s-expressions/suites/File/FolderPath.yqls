# canonize yson here
(
#comment
(let config (DataSource 'config))
(let normalize (Udf '"Re2.Replace" '((String '"(^|.*/)([^/]+/?)$") (Null))))
(let folder (Apply normalize (FolderPath '"/lib") (String '"./\\2")))

(let res_sink (DataSink 'result))
(let world (Write! world res_sink (Key) folder '()))
(let world (Commit! world res_sink))
(return world)
)
