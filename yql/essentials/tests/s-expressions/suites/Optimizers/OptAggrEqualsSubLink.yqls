(
(let world (Configure! world (DataSource 'config) 'DeriveColumnOrder))
(let query (lambda '(data) (YqlSelect '(
    '('set_items '((YqlSetItem '('('values '('value) data)))))
    '('set_ops '('push))
))))
(let compare (lambda '(left right) (block '(
    (let common_type (ListItemType (TypeOf (AsList left right))))
    (return (OptAggrEquals (SafeCast left common_type) (SafeCast right common_type)))
))))
(let sublink (lambda '(value data) (YqlSubLink 'any (Void) (Void)
    (lambda '(item) (Apply compare value item))
    (lambda '() (Apply query data)) '('('ansiIn)))))
(let strict_sublink (lambda '(value data) (YqlSubLink 'any (Void) (Void)
    (lambda '(item) (OptAggrEquals value (StrictCast item (OptionalType (DataType 'Int32)))))
    (lambda '() (Apply query data)) '('('ansiIn)))))
(let computed_sublink (lambda '(value data) (YqlSubLink 'any (Void) (Void)
    (lambda '(item) (OptAggrEquals value (+ item (Int32 '1))))
    (lambda '() (Apply query data)) '('('ansiIn)))))
(let constant_sublink (lambda '(value data) (YqlSubLink 'any (Void) (Void)
    (lambda '(item) (Apply compare value (Int32 '7)))
    (lambda '() (Apply query data)) '('('ansiIn)))))
(let folded_sublink (lambda '(data) (YqlSubLink 'any (Void) (Void)
    (lambda '(item) (Bool 'true))
    (lambda '() (Apply query data)))))
(let integers (AsList '((Int32 '1)) '((Int32 '2))))
(let empty (Take integers (Uint64 '0)))
(let longs (AsList '((Int64 '1)) '((Int64 '2147483648))))
(let nullable_integers (AsList '((Just (Int32 '1))) '((Nothing (OptionalType (DataType 'Int32))))))
(let floats (AsList '((Double 'nan)) '((Double '1))))
(let nested (AsList '((AsStruct '('key (Nothing (OptionalType (DataType 'Int32))))))))
(let result (YqlSelect '(
    '('set_items '((YqlSetItem '(
        '('result '(
            (YqlResultItem 'integer_in (Void) (lambda '() (Apply sublink (Int32 '1) integers)))
            (YqlResultItem 'integer_missing (Void) (lambda '() (Apply sublink (Int32 '3) integers)))
            (YqlResultItem 'computed_rhs (Void) (lambda '() (Apply computed_sublink (Int32 '3) integers)))
            (YqlResultItem 'constant_rhs (Void) (lambda '() (Apply constant_sublink (Int32 '7) integers)))
            (YqlResultItem 'constant_rhs_empty (Void) (lambda '() (Apply constant_sublink (Int32 '7) empty)))
            (YqlResultItem 'constant_rhs_null (Void) (lambda '() (Apply constant_sublink (Nothing (OptionalType (DataType 'Int32))) integers)))
            (YqlResultItem 'constant_rhs_null_empty (Void) (lambda '() (Apply constant_sublink (Nothing (OptionalType (DataType 'Int32))) empty)))
            (YqlResultItem 'folded_predicate (Void) (lambda '() (Apply folded_sublink integers)))
            (YqlResultItem 'folded_predicate_empty (Void) (lambda '() (Apply folded_sublink empty)))
            (YqlResultItem 'long_in_int (Void) (lambda '() (Apply sublink (Int64 '1) integers)))
            (YqlResultItem 'long_out_of_range (Void) (lambda '() (Apply sublink (Int64 '2147483648) integers)))
            (YqlResultItem 'int_in_long (Void) (lambda '() (Apply sublink (Int32 '1) longs)))
            (YqlResultItem 'strict_match (Void) (lambda '() (Apply strict_sublink (Just (Int32 '1)) longs)))
            (YqlResultItem 'strict_out_of_range (Void) (lambda '() (Apply strict_sublink (Just (Int32 '2)) longs)))
            (YqlResultItem 'nullable_rhs (Void) (lambda '() (Apply sublink (Int32 '3) nullable_integers)))
            (YqlResultItem 'nullable_lhs (Void) (lambda '() (Apply sublink (Nothing (OptionalType (DataType 'Int32))) integers)))
            (YqlResultItem 'nan_in (Void) (lambda '() (Apply sublink (Double 'nan) floats)))
            (YqlResultItem 'nested_null (Void) (lambda '() (Apply sublink (AsStruct '('key (Nothing (OptionalType (DataType 'Int32))))) nested)))
        ))
    ))))
    '('set_ops '('push))
)))
(let sink (DataSink 'result))
(let world (Write! world sink (Key) result '('('type))))
(let keys (YqlSelect '(
    '('set_items '((YqlSetItem '('('values '('key) (AsList '((Int32 '1)) '((Int32 '2)) '((Int32 '3))))))))
    '('set_ops '('push))
)))
(let outer_predicate (lambda '(item) (OptAggrEquals
    (* (YqlColumnRef 'key) (Int32 '2)) (+ item (YqlColumnRef 'key)))))
(let outer_result (YqlSelect '(
    '('set_items '((YqlSetItem '(
        '('from '('(keys 't '())))
        '('join_ops '('('('push))))
        '('result '(
            (YqlResultItem 'key (Void) (lambda '() (YqlColumnRef 'key)))
            (YqlResultItem 'outer_rhs (Void) (lambda '() (YqlSubLink 'any (Void) (Void)
                outer_predicate (lambda '() (Apply query integers)) '('('ansiIn)))))
        ))
    ))))
    '('set_ops '('push))
)))
(let world (Write! world sink (Key) outer_result '('('type) '('unordered))))
(return (Commit! world sink))
)
