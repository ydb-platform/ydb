(
(let world (Configure! world (DataSource 'config) 'DeriveColumnOrder))
(let rows (AsList '((Int32 '1)) '((Int32 '2))))
(let empty (List (ListType (TupleType (DataType 'Int32)))))
(let query (lambda '(data) (YqlSelect '(
    '('set_items '((YqlSetItem '('('values '('value) data)))))
    '('set_ops '('push))
))))
(let sublink (lambda '(kind predicate data) (YqlSubLink kind (Void) (Void) predicate (lambda '() (Apply query data)))))
(let positive (lambda '(value) (Coalesce (> value (Int32 '0)) (Bool 'false))))
(let equals_one (lambda '(value) (== (Int32 '1) value)))
(let unknown (lambda '(value) (Nothing (OptionalType (DataType 'Bool)))))
(let null_predicate (lambda '(value) (Null)))
(let result (YqlSelect '(
    '('set_items '((YqlSetItem '(
        '('result '(
            (YqlResultItem 'any_positive (Void) (lambda '() (Apply sublink 'any positive rows)))
            (YqlResultItem 'all_positive (Void) (lambda '() (Apply sublink 'all positive rows)))
            (YqlResultItem 'all_equal (Void) (lambda '() (Apply sublink 'all equals_one rows)))
            (YqlResultItem 'any_empty (Void) (lambda '() (Apply sublink 'any positive empty)))
            (YqlResultItem 'all_empty (Void) (lambda '() (Apply sublink 'all positive empty)))
            (YqlResultItem 'any_unknown (Void) (lambda '() (Apply sublink 'any unknown rows)))
            (YqlResultItem 'all_unknown (Void) (lambda '() (Apply sublink 'all unknown rows)))
            (YqlResultItem 'any_null (Void) (lambda '() (Apply sublink 'any null_predicate rows)))
            (YqlResultItem 'all_null_empty (Void) (lambda '() (Apply sublink 'all null_predicate empty)))
        ))
    ))))
    '('set_ops '('push))
)))
(let sink (DataSink 'result))
(let world (Write! world sink (Key) result '('('type))))
(let keys (YqlSelect '(
    '('set_items '((YqlSetItem '('('values '('key) (AsList '((Int32 '0)) '((Int32 '1)) '((Int32 '3))))))))
    '('set_ops '('push))
)))
(let greater (lambda '(value) (Coalesce (> value (YqlColumnRef 'key)) (Bool 'false))))
(let filtered (YqlSelect '(
    '('set_items '((YqlSetItem '(
        '('from '('((Apply query rows) 's '())))
        '('join_ops '('('('push))))
        '('where (YqlWhere (Void) (lambda '() (> (YqlColumnRef 'value) (YqlColumnRef 'key)))))
        '('result '((YqlResultItem 'value (Void) (lambda '() (YqlColumnRef 'value)))))
    ))))
    '('set_ops '('push))
)))
(let correlated (YqlSelect '(
    '('set_items '((YqlSetItem '(
        '('from '('(keys 't '())))
        '('join_ops '('('('push))))
        '('result '(
            (YqlResultItem 'key (Void) (lambda '() (YqlColumnRef 'key)))
            (YqlResultItem 'any_greater (Void) (lambda '() (Apply sublink 'any greater rows)))
            (YqlResultItem 'all_greater (Void) (lambda '() (Apply sublink 'all greater rows)))
            (YqlResultItem 'any_empty (Void) (lambda '() (Apply sublink 'any greater empty)))
            (YqlResultItem 'all_empty (Void) (lambda '() (Apply sublink 'all greater empty)))
            (YqlResultItem 'any_filtered (Void) (lambda '() (YqlSubLink 'any (Void) (Void) positive (lambda '() filtered))))
            (YqlResultItem 'all_filtered (Void) (lambda '() (YqlSubLink 'all (Void) (Void) positive (lambda '() filtered))))
        ))
    ))))
    '('set_ops '('push))
)))
(let world (Write! world sink (Key) correlated '('('type) '('unordered))))
(return (Commit! world sink))
)
