(
(let config (DataSource 'config))
(let res_sink (DataSink 'result))
(let world (Configure! world config 'OrderedColumns))
(let inner (WithWorld (AsList (Int32 '42)) world))
(let outer (WithWorld (AsList (Head inner)) world))
(let world (Write! world res_sink (Key) outer '('('type))))
(let world (Commit! world res_sink))
(return world)
)
