PRAGMA YqlSelect = 'force';

$a = 'a';
$x = <|a: 7|>;
$rows = AsList(<|x: <|a: 1, `0`: 2|>, t: (3, 4), y: Yson::Parse('{a=1;}')|>);

SELECT
    x.a AS member,
    x.$a AS named_member,
    $x.a AS named_value,
    $x.$a AS named_value_member,
    t.0 AS tuple_index,
    x.`0` AS quoted_index,
    s.x.a AS qualified_member,
    y.a IS NULL AS missing,
    ROW_NUMBER() OVER (PARTITION BY x.a ORDER BY x.a) AS row_number
FROM AS_TABLE($rows) AS s
WHERE EXISTS (SELECT t.a FROM AS_TABLE([<|a: 1|>]) AS t WHERE t.a = s.x.a);

SELECT x.a AS member, SUM(x.a) AS sum FROM AS_TABLE($rows) GROUP BY x HAVING SUM(x.a) > 0;
SELECT x.x.a AS alias_priority FROM AS_TABLE($rows) AS x;
SELECT x.a AS member_after_alias FROM AS_TABLE($rows);
