# The two builds of the YT codec codegen: llvm16 (the sources of ya.make.inc,
# with LLVM codegen) and no_llvm (a stub); both provide the yt_codegen link
# slot, whose interface is //yt/yql/providers/yt/codec:codegen.
# variant_sources.gni is generated by yamake2gn from ya.make.inc.
#
# TODO: LLVM_BC of ya.make.inc: yt_codec_bc.cpp compiled to bitcode, the
# resource /llvm_bc/YtCodecFuncs that yt_codec_cg.cpp loads.

import("//yt/yql/providers/yt/codec/codegen/variant_sources.gni")

template("yt_codec_codegen_variant") {
  assert(defined(invoker.codegen), "yt_codec_codegen_variant needs `codegen`")

  library(target_name) {
    forward_variables_from(invoker, [ "link_slot_provides" ])

    public_deps = [ "//yt/yql/providers/yt/codec/codegen" ]

    if (invoker.codegen) {
      sources = variant_sources
      public_deps += [
        "//library/cpp/resource",
        "//yql/essentials/minikql/codegen/llvm16",
        "//yql/essentials/parser/pg_wrapper/interface",
        "//yql/essentials/types/binary_json",
        "//yql/essentials/utils",
        "//yt/yql/providers/yt/codec",
      ]
      deps = [
        # the codegen headers (mkql_computation_node_codegen.h ...)
        "//yql/essentials/minikql/computation/llvm16",
        "//yql/essentials/providers/common/codec",
        "//yql/essentials/public/decimal",
        "//yql/essentials/public/udf",
      ]
    } else {
      sources = [ "//yt/yql/providers/yt/codec/codegen/yt_codec_cg_dummy.cpp" ]
    }
  }
}
