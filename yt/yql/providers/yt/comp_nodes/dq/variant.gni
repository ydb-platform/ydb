# The builds of the YT provider's DQ comp_nodes, from the sources of
# ya.make.inc: llvm16 (with LLVM codegen) and, when it appears, no_llvm
# (MKQL_DISABLE_CODEGEN). Each provides the yt_codegen link slot (its
# interface here is //yt/yql/providers/yt/comp_nodes:dq) and builds on the
# comp_nodes and computation of the same build, whose public configs carry
# the codegen headers (mkql_computation_node_codegen.h ...).
# variant_sources.gni is generated by yamake2gn from ya.make.inc.

import("//yt/yql/providers/yt/comp_nodes/dq/variant_sources.gni")

template("yt_comp_nodes_dq_variant") {
  assert(defined(invoker.codegen), "yt_comp_nodes_dq_variant needs `codegen`")

  config("${target_name}_includes") {
    include_dirs = [
      "//yt/yql/providers/yt/comp_nodes/dq",
      "//contrib/libs/flatbuffers/include",
    ]
  }

  _build = "no_llvm"
  if (invoker.codegen) {
    _build = "llvm16"
  }

  library(target_name) {
    forward_variables_from(invoker, [ "link_slot_provides" ])

    sources = variant_sources

    cflags = [ "-Wno-unused-parameter" ]

    configs = [ ":${target_name}_includes" ]

    deps = [
      "//library/cpp/yt/compact_containers",
      "//library/cpp/yt/threading",
      "//library/cpp/yt/yson_string",
      "//yt/cpp/mapreduce/client",
      "//yt/yql/providers/yt/comp_nodes/$_build",
      "//yt/yt_proto/yt/client",
    ]

    public_deps = [
      "//contrib/libs/apache/arrow",
      "//contrib/libs/flatbuffers",
      "//library/cpp/yson/node",
      "//yql/essentials/minikql",
      "//yql/essentials/minikql/computation/$_build",
      "//yql/essentials/parser/pg_wrapper/interface",
      "//yql/essentials/providers/common/codec",
      "//yql/essentials/public/udf",
      "//yql/essentials/public/udf/arrow",
      "//yql/essentials/utils/failure_injector",
      "//yt/cpp/mapreduce/common",
      "//yt/cpp/mapreduce/interface",
      "//yt/yql/providers/yt/codec",
      "//yt/yql/providers/yt/comp_nodes",
      "//yt/yql/providers/yt/comp_nodes/dq",
      "//yt/yql/providers/yt/lib/yt_rpc_helpers",
      "//yt/yt/client",
      "//yt/yt/core",
    ]

    if (!invoker.codegen) {
      defines = [ "MKQL_DISABLE_CODEGEN" ]
    }
  }
}
