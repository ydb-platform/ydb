# The two builds of the YT provider's comp_nodes: llvm16 (with LLVM codegen)
# and no_llvm (MKQL_DISABLE_CODEGEN), both from the sources of ya.make.inc;
# both provide the yt_codegen link slot, whose interface is
# //yt/yql/providers/yt/comp_nodes. The codegen headers of computation
# (mkql_computation_node_codegen.h ...) come from the public config of the
# computation variant of the same build.
# variant_sources.gni is generated by yamake2gn from ya.make.inc.

import("//yt/yql/providers/yt/comp_nodes/variant_sources.gni")

template("yt_comp_nodes_variant") {
  assert(defined(invoker.codegen), "yt_comp_nodes_variant needs `codegen`")

  config("${target_name}_includes") {
    include_dirs = [ "//yt/yql/providers/yt/comp_nodes" ]
  }

  library(target_name) {
    forward_variables_from(invoker, [ "link_slot_provides" ])

    sources = variant_sources

    configs = [ ":${target_name}_includes" ]

    deps = [ "//library/cpp/streams/brotli" ]

    public_deps = [
      "//yql/essentials/minikql",
      "//yql/essentials/minikql/computation",
      "//yql/essentials/providers/common/codec",
      "//yql/essentials/providers/common/mkql",
      "//yql/essentials/public/udf",
      "//yql/essentials/utils",
      "//yt/cpp/mapreduce/interface",
      "//yt/yql/providers/yt/codec",
      "//yt/yql/providers/yt/comp_nodes",
      "//yt/yql/providers/yt/expr_nodes",
    ]

    if (invoker.codegen) {
      public_deps += [
        "//yql/essentials/minikql/codegen/llvm16",
        "//yql/essentials/minikql/computation/llvm16",
        "//yql/essentials/minikql/invoke_builtins/llvm16",
        "//yt/yql/providers/yt/codec/codegen/llvm16",
      ]
    } else {
      defines = [ "MKQL_DISABLE_CODEGEN" ]
      public_deps += [
        "//yql/essentials/minikql/computation/no_llvm",
        "//yql/essentials/minikql/invoke_builtins/no_llvm",
      ]
    }
  }
}
