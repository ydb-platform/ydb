/* yt can not */
/* custom error: Error: Failed to execute callable with name: ResWrite!, you possibly used cross provider/cluster operations or pulled not materialized result in refselect mode */
pragma yt.RuntimeClusterSelection='disable';

$udf = YQL::@@
(lambda '(stream)
    (PartitionByKey stream
        (lambda '(item) (Way item))
        (Void)
        (Void)
        (lambda '(listOfPairs)
            (FlatMap listOfPairs (lambda '(pair)
                (Map (Nth pair '1) (lambda '(elem)
                    (AsStruct
                        '('cnt (Visit elem '0 (lambda '(v) (Member v 'subkey)) '1 (lambda '(v) (Member v 'subkey))))
                        '('src (Nth pair '0))
                    )
                ))
            ))
        )
    )
)
@@;

PROCESS plato.PInput, banach.BInput USING $udf(TableRows());
