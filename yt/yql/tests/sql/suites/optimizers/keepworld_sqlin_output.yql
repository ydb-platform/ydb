/* syntax version 1 */
/* postgres can not */

pragma config.flags('OptimizerFlags', 'KeepWorld', 'CheckMissingWorld');
use plato;
pragma yt.MapJoinLimit = "0";

$prod_ids = (select subkey from Prod);
$codes = (select distinct value from Dict);

$calc = (
    select
        key,
        key in $prod_ids as flag1,
        key in $codes as flag2
    from Input
);

select
    key,
    flag2 as is_revenue
from $calc
order by key;
