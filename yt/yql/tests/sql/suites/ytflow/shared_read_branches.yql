/* sort outputs */

use plato;

pragma Engine = "ytflow";

pragma Ytflow.Cluster = "plato";
pragma Ytflow.PipelinePath = "pipelines/test";

insert into OutputA
select
    string_field,
    0 as int64_field,
    false as bool_field
from Input;

insert into OutputB
select
    "" as string_field,
    int64_field,
    false as bool_field
from Input;
