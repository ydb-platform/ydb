/* sort outputs */

use plato;

pragma Engine = "ytflow";

pragma Ytflow.Cluster = "plato";
pragma Ytflow.PipelinePath = "pipelines/test";

insert into Output
select
    string_field || "_first" as string_field,
    int64_field
from Input1
union all
select
    string_field || "_second" as string_field,
    int64_field
from Input2
union all
select
    string_field || "_third" as string_field,
    int64_field
from Input3
union all
select
    string_field || "_fourth" as string_field,
    int64_field
from Input4;
